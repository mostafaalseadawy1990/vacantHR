---
import { REQ_STATUS_AR } from '../../lib/labels';
import Portal from '../../layouts/Portal.astro';
import { serverClient } from '../../lib/supabase';
import { notifyAdmins } from '../../lib/notify';
import { sendCapiEvent, newEventId } from '../../lib/capi';
import Track from '../../components/Track.astro';

const user = Astro.locals.user!;
const profile = Astro.locals.profile;
if (profile?.role !== 'client') return Astro.redirect('/dashboard', 302);
const supabase = serverClient(Astro);
let formMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'new_request');

  if (action === 'decide') {
    const itemId = String(form.get('item_id') || '');
    const decision = String(form.get('decision') || '');
    const note = String(form.get('note') || '').trim().slice(0, 1000) || null;
    if (itemId && (decision === 'approved' || decision === 'rejected')) {
      await supabase.rpc('client_decide_shortlist', { item: itemId, decision, note });
      return Astro.redirect('/dashboard/requests?decided=1#pending', 303);
    }
  } else {
    const roleTitle = String(form.get('role_title') || '').trim();
    const headcount = Math.max(1, Math.min(50, parseInt(String(form.get('headcount') || '1'), 10) || 1));
    const details = String(form.get('details_md') || '').trim().slice(0, 4000);
    if (!roleTitle) {
      formMsg = 'اكتب المسمى الوظيفي المطلوب.';
    } else {
      const { error } = await supabase.from('client_requests').insert({
        client_id: user.id, role_title: roleTitle, headcount, details_md: details || '',
      });
      if (error) formMsg = 'تعذّر إرسال الطلب.';
      else {
        await notifyAdmins(Astro, {
          title: `طلب توظيف جديد من عميل: ${roleTitle}`,
          lines: [`${profile?.company_name || profile?.full_name || user.email}`, `العدد: ${headcount}`, details ? details.slice(0, 400) : ''].filter(Boolean),
          url: 'https://vacanthr.com/admin/requests', replyTo: user.email!,
        });
        const eid = newEventId();
        await sendCapiEvent(Astro, { name: 'Lead', eventId: eid, user: { email: user.email, phone: profile?.phone, fullName: profile?.full_name, externalId: user.id }, params: { content_name: 'client_request' }, sourceUrl: 'https://vacanthr.com/dashboard/requests' });
        return Astro.redirect(`/dashboard/requests?sent=1&eid=${eid}`, 303);
      }
    }
  }
}
const url = new URL(Astro.request.url);
const justSent = url.searchParams.get('sent') === '1';
const eid = url.searchParams.get('eid');
const justDecided = url.searchParams.get('decided') === '1';
const DEC_AR: Record<string, string> = { pending: 'بانتظار قرارك', approved: 'وافقت', rejected: 'رفضت' };
const fmtDate = (s: string) => new Date(s).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });

const [{ data: rq }, { data: sl }] = await Promise.all([
  supabase.from('client_requests').select('id, role_title, headcount, status, created_at, details_md').order('created_at', { ascending: false }),
  supabase.from('client_shortlist').select('id, request_id, headline, summary, client_decision, client_note, created_at').eq('admin_status', 'sent').order('created_at'),
]);
const requests = rq ?? [];
const byReq: Record<string, any[]> = {};
for (const it of sl ?? []) (byReq[it.request_id] ??= []).push(it);
const pendingTotal = (sl ?? []).filter((i) => i.client_decision === 'pending').length;
const STATUS_AR = REQ_STATUS_AR;
---
<Portal title="طلبات التوظيف | Vacant HR" path="/dashboard/requests" active="requests">
<Fragment slot="heading">طلبات التوظيف</Fragment>
<div class="admin-body">
  {justSent && <p class="notice notice-ok" style="margin-bottom:18px;">استلمنا طلبك، وهنبدأ نشتغل عليه ونرجعلك.</p>}
  {justDecided && <p class="notice notice-ok" style="margin-bottom:18px;">تم تسجيل قرارك. شكرًا!</p>}
  {formMsg && <p class="notice notice-error" style="margin-bottom:18px;">{formMsg}</p>}

  <details class="cadd" id="new" open={requests.length === 0 || undefined}>
    <summary>+ طلب توظيف لدور جديد</summary>
    <form method="POST" class="citem-body" style="max-width:640px;">
      <input type="hidden" name="_action" value="new_request" />
      <div class="form-grid-2">
        <div class="form-row"><label for="role_title">المسمى الوظيفي المطلوب *</label><input id="role_title" name="role_title" required placeholder="محاسب أول" /></div>
        <div class="form-row"><label for="headcount">عدد الأشخاص</label><input type="number" id="headcount" name="headcount" min="1" max="50" value="1" /></div>
      </div>
      <div class="form-row"><label for="details_md">تفاصيل الدور والمتطلبات</label><textarea id="details_md" name="details_md" maxlength="4000" style="min-height:120px;" placeholder="المهام الأساسية، سنوات الخبرة، الميزانية، مكان العمل…"></textarea></div>
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إرسال الطلب</button>
    </form>
  </details>

  {pendingTotal > 0 && <h2 id="pending" style="font-size:1.05rem;margin:20px 0 10px;">مرشحون بانتظار قرارك ({pendingTotal})</h2>}

  {requests.length === 0 ? <p class="pempty" style="margin-top:16px;">مفيش طلبات لسه.</p> : (
    <div class="citems" style="max-width:none;margin-top:12px;">
      {requests.map((r, i) => {
        const items = byReq[r.id] ?? [];
        const pend = items.filter((x) => x.client_decision === 'pending').length;
        return (
          <details class="citem" open={pend > 0 || i === 0 || undefined}>
            <summary>
              <span></span>
              <span class="citem-title"><strong>{r.role_title}</strong><small>{r.headcount} أشخاص · {fmtDate(r.created_at)}{items.length > 0 && <> · {items.length} مرشح{pend > 0 && <b style="color:#B45309;"> · {pend} بانتظار قرارك</b>}</>}</small></span>
              <span class="citem-side"><span class={`status-pill status-${r.status}`}>{STATUS_AR[r.status] ?? r.status}</span><span class="citem-chev">▼</span></span>
            </summary>
            <div class="citem-body">
              {r.details_md && <p style="white-space:pre-wrap;color:var(--body);font-size:.92rem;margin:0 0 14px;">{r.details_md}</p>}
              {items.length === 0 ? <p class="pempty">فريقنا بيدوّر على مرشحين مناسبين — هتوصلك القائمة هنا.</p> : (
                <div style="display:grid;gap:10px;">
                  {items.map((it: any) => (
                    <div class="psec" style="margin:0;padding:14px 16px;">
                      <div class="psec-head" style="margin-bottom:6px;"><h2 style="font-size:.98rem;">{it.headline}</h2>
                        <span class={`status-pill status-${it.client_decision === 'approved' ? 'shortlisted' : it.client_decision === 'rejected' ? 'rejected' : 'submitted'}`}>{DEC_AR[it.client_decision]}</span></div>
                      {it.summary && <p style="margin:0;color:var(--muted);white-space:pre-wrap;font-size:.9rem;">{it.summary}</p>}
                      {it.client_decision === 'pending' && (
                        <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;">
                          <form method="POST"><input type="hidden" name="_action" value="decide" /><input type="hidden" name="item_id" value={it.id} /><input type="hidden" name="decision" value="approved" />
                            <button class="btn solid" style="border:none;cursor:pointer;padding:8px 16px;font-size:.88rem;">أوافق — رتّبوا مقابلة</button></form>
                          <form method="POST" style="display:flex;gap:8px;"><input type="hidden" name="_action" value="decide" /><input type="hidden" name="item_id" value={it.id} /><input type="hidden" name="decision" value="rejected" />
                            <input type="text" name="note" placeholder="سبب الرفض (اختياري)" style="width:200px;padding:8px 12px;" /><button class="btn" style="cursor:pointer;padding:8px 14px;font-size:.88rem;">أرفض</button></form>
                        </div>
                      )}
                      {it.client_note && <p style="margin:8px 0 0;font-size:.85rem;color:var(--muted);">ملاحظتك: {it.client_note}</p>}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </details>
        );
      })}
    </div>
  )}
</div>
{justSent && <Track event="Lead" params={{ content_name: 'client_request' }} eventId={eid} />}
</Portal>
