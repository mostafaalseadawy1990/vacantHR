---
import Base from '../../../layouts/Base.astro';
import { serverClient } from '../../../lib/supabase';
import { getSettings } from '../../../lib/settings';
import { sendEmail, emailLayout } from '../../../lib/email';

const { id } = Astro.params;
const me = Astro.locals.user!;
const supabase = serverClient(Astro);

const { data: conv } = await supabase
  .from('conversations').select('id, subject, participant_id').eq('id', id).maybeSingle();
if (!conv || conv.participant_id !== me.id) return Astro.redirect('/dashboard/messages', 302);

if (Astro.request.method === 'POST') {
  const body = String((await Astro.request.formData()).get('body') || '').trim().slice(0, 5000);
  if (body) {
    await supabase.from('messages').insert({ conversation_id: id, sender_id: me.id, body });
    const s = await getSettings();
    await sendEmail(Astro, {
      to: s.contact_email,
      subject: `رد جديد على: ${conv.subject}`,
      html: emailLayout('رد جديد من مستخدم',
        `<p>${body.replace(/</g, '&lt;').slice(0, 400)}</p>`,
        { text: 'فتح المحادثة', url: `https://vacanthr.com/admin/inbox/${id}` }),
      replyTo: me.email!,
    });
    return Astro.redirect(`/dashboard/messages/${id}#end`, 303);
  }
}

const { data: msgs } = await supabase
  .from('messages').select('id, body, sender_id, created_at').eq('conversation_id', id).order('created_at');
const fmt = (str: string) => new Date(str).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
---
<Base title={`${conv.subject} | الرسائل`} path={`/dashboard/messages/${id}`} active="dashboard" noindex={true}>
<main id="main">
<section style="padding:44px 0 70px;">
  <div class="wrap" style="max-width:720px;">
    <div class="dash-head"><div><div class="eyebrow-line">محادثة</div><h1>{conv.subject}</h1></div><a href="/logout" class="btn">خروج</a></div>
    <p style="margin-bottom:16px;"><a href="/dashboard/messages">→ كل الرسائل</a></p>

    <div class="chat">
      {(msgs ?? []).map((m: any) => (
        <div class={`chat-msg ${m.sender_id === me.id ? 'me' : 'them'}`}>
          <p>{m.body}</p><time>{fmt(m.created_at)}</time>
        </div>
      ))}
      <span id="end"></span>
    </div>

    <form method="POST" style="margin-top:18px;">
      <textarea name="body" placeholder="اكتب رسالتك…" style="min-height:90px;" required></textarea>
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;margin-top:8px;">إرسال</button>
    </form>
  </div>
</section>
</main>
</Base>

<style is:global>
  .chat{display:flex;flex-direction:column;gap:10px;}
  .chat-msg{max-width:80%;padding:12px 14px;border-radius:14px;font-size:0.95rem;}
  .chat-msg p{margin:0;white-space:pre-wrap;}
  .chat-msg time{display:block;margin-top:4px;font-size:0.72rem;opacity:.7;}
  .chat-msg.me{align-self:flex-start;background:var(--accent);color:#fff;border-bottom-right-radius:4px;}
  .chat-msg.them{align-self:flex-end;background:var(--surface-soft);border:1px solid var(--line);border-bottom-left-radius:4px;}
</style>
