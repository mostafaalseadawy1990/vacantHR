---
import Portal from '../../layouts/Portal.astro';
import { serverClient } from '../../lib/supabase';
import { readCandidateFields, completeness, AVAILABILITY_AR } from '../../lib/candidates';
import CandidateFields from '../../components/CandidateFields.astro';

const user = Astro.locals.user!;
const profile = Astro.locals.profile;
const supabase = serverClient(Astro);
const role = profile?.role ?? 'candidate';

// full profile row (skills + enrichment fields)
const { data: meRow } = await supabase.from('profiles').select('*').eq('id', user.id).maybeSingle();
let extra: Record<string, any> = { ...(meRow ?? {}) };
let cvMsg = '';
const MAX_CV = 5 * 1024 * 1024;
const OK_CV = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];

let msg = '';
let values = {
  full_name: profile?.full_name ?? '',
  phone: profile?.phone ?? '',
  company_name: profile?.company_name ?? '',
  skills: ((meRow?.skills ?? []) as string[]).join(', '),
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = {
    full_name: String(form.get('full_name') || '').trim(),
    phone: String(form.get('phone') || '').trim(),
    company_name: String(form.get('company_name') || '').trim(),
    skills: String(form.get('skills') || '').trim(),
  };
  if (!values.full_name) {
    msg = 'الاسم مطلوب.';
  } else {
    const patch: Record<string, unknown> = {
      full_name: values.full_name,
      phone: values.phone || null,
      company_name: role === 'client' ? (values.company_name || null) : profile?.company_name ?? null,
      updated_at: new Date().toISOString(),
    };
    if (role !== 'client') {
      Object.assign(patch, readCandidateFields(form));
      // Optional CV on the profile (separate from per-application CVs).
      const cv = form.get('cv');
      if (cv instanceof File && cv.size > 0) {
        if (cv.size > MAX_CV) cvMsg = 'حجم السيرة الذاتية أكبر من 5 ميجابايت.';
        else if (!OK_CV.includes(cv.type)) cvMsg = 'صيغة السيرة الذاتية غير مدعومة (PDF / DOC / DOCX).';
        else {
          const ext = (cv.name.split('.').pop() || 'pdf').toLowerCase().replace(/[^a-z0-9]/g, '');
          const path = `${user.id}/profile-${Date.now()}.${ext}`;
          const up = await supabase.storage.from('cvs').upload(path, cv, { contentType: cv.type });
          if (up.error) cvMsg = 'تعذّر رفع السيرة الذاتية.'; else patch.cv_path = path;
        }
      }
    }
    const { error } = await supabase.from('profiles').update(patch).eq('id', user.id);
    msg = error ? 'تعذّر الحفظ.' : 'اتحفظت التعديلات ✓';
    if (!error) extra = { ...extra, ...patch };
  }
}
---
<Portal title="بياناتي | Vacant HR" path="/dashboard/profile" active="profile">
<Fragment slot="heading">تعديل البيانات</Fragment>
<div class="admin-body">

    {msg && <p class={`notice ${msg.includes('✓') ? 'notice-ok' : 'notice-error'}`} style="margin-bottom:20px;">{msg}</p>}

    {role !== 'client' && (() => { const c = completeness({ ...extra, full_name: values.full_name, phone: values.phone }); return (
      <div class="form-box" style="max-width:760px;margin-bottom:18px;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;">
          <strong>اكتمال ملفك: {c.pct}%</strong>
          <small style="color:var(--muted);">الملف المكتمل بيخلّي فريقنا يرشّحك لوظائف أنسب وأسرع.</small>
        </div>
        <div class="meter"><span style={`width:${c.pct}%`}></span></div>
        {c.missing.length > 0 && <p style="margin:8px 0 0;font-size:.85rem;color:var(--muted);">ناقص: {c.missing.join('، ')}</p>}
      </div>
    ); })()}
    {cvMsg && <p class="notice notice-error" style="margin-bottom:20px;">{cvMsg}</p>}

    <form class="form-box" method="POST" enctype="multipart/form-data" style="max-width:760px;">
      <div class="form-row">
        <label for="email">البريد الإلكتروني</label>
        <input type="email" id="email" value={user.email} disabled />
      </div>
      <div class="form-row">
        <label for="full_name">الاسم بالكامل</label>
        <input type="text" id="full_name" name="full_name" value={values.full_name} required />
      </div>
      <div class="form-row">
        <label for="phone">رقم الهاتف</label>
        <input type="tel" id="phone" name="phone" value={values.phone} inputmode="tel" />
      </div>
      {role === 'client' && (
        <div class="form-row">
          <label for="company_name">اسم الشركة</label>
          <input type="text" id="company_name" name="company_name" value={values.company_name} />
        </div>
      )}
      {role !== 'client' && (
        <>
          <h3 style="margin:18px 0 10px;">بياناتك المهنية</h3>
          <CandidateFields v={extra} />
          <div class="form-row">
            <label for="cv">السيرة الذاتية (PDF / Word — حتى 5 ميجابايت)</label>
            <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" />
            {extra.cv_path && <small style="color:var(--muted);">عندك سيرة ذاتية مرفوعة — ارفع ملف جديد لاستبدالها.</small>}
          </div>
        </>
      )}
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
    </form>
</div>
</Portal>
