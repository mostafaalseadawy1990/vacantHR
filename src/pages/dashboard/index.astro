---
import Base from '../../layouts/Base.astro';
import { serverClient } from '../../lib/supabase';
import { getSettings } from '../../lib/settings';
import { sendEmail, emailLayout } from '../../lib/email';

const user = Astro.locals.user!;
const profile = Astro.locals.profile;
const supabase = serverClient(Astro);

const url = new URL(Astro.request.url);
const justApplied = url.searchParams.get('applied') === '1';

const role = profile?.role ?? 'candidate';
let formMsg = '';

if (Astro.request.method === 'POST' && role === 'client') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'new_request');

  if (action === 'decide') {
    const itemId = String(form.get('item_id') || '');
    const decision = String(form.get('decision') || '');
    const note = String(form.get('note') || '').trim().slice(0, 1000) || null;
    if (itemId && (decision === 'approved' || decision === 'rejected')) {
      await supabase.rpc('client_decide_shortlist', { item: itemId, decision, note });
      return Astro.redirect('/dashboard?decided=1', 303);
    }
  } else {
    const roleTitle = String(form.get('role_title') || '').trim();
    const headcount = Math.max(1, Math.min(50, parseInt(String(form.get('headcount') || '1'), 10) || 1));
    const details = String(form.get('details_md') || '').trim().slice(0, 4000);
    if (!roleTitle) {
      formMsg = 'اكتب المسمى الوظيفي المطلوب.';
    } else {
      const { error } = await supabase.from('client_requests').insert({
        client_id: user.id, role_title: roleTitle, headcount, details_md: details || '',
      });
      formMsg = error ? 'تعذّر إرسال الطلب.' : 'ok';
      if (!error) {
        const s = await getSettings();
        await sendEmail(Astro, {
          to: s.contact_email,
          subject: `طلب توظيف جديد من عميل: ${roleTitle}`,
          html: emailLayout('طلب توظيف جديد',
            `<p><strong>${profile?.company_name || profile?.full_name || user.email}</strong> طلب توظيف لـ <strong>${roleTitle}</strong> (${headcount}).</p>${details ? `<p>${details}</p>` : ''}`,
            { text: 'فتح الطلب', url: 'https://vacanthr.com/admin/requests' }),
          replyTo: user.email!,
        });
        return Astro.redirect('/dashboard?sent=1', 303);
      }
    }
  }
}
const justSent = url.searchParams.get('sent') === '1';
const justDecided = url.searchParams.get('decided') === '1';

const STATUS_AR: Record<string, string> = {
  submitted: 'تحت المراجعة', reviewing: 'قيد الفحص', shortlisted: 'قائمة مختصرة',
  rejected: 'غير مناسب حاليًا', hired: 'تم التعيين',
  new: 'جديد', in_progress: 'شغّالين عليه', candidates_sent: 'أرسلنا مرشحين', closed: 'مغلق',
};

let applications: any[] = [];
let requests: any[] = [];
let shortlistByReq: Record<string, any[]> = {};
if (role === 'client') {
  const { data } = await supabase
    .from('client_requests')
    .select('id, role_title, headcount, status, created_at, details_md')
    .order('created_at', { ascending: false });
  requests = data ?? [];

  const { data: sl } = await supabase
    .from('client_shortlist')
    .select('id, request_id, headline, summary, client_decision, client_note, created_at')
    .order('created_at');
  for (const item of sl ?? []) {
    (shortlistByReq[item.request_id] ??= []).push(item);
  }
} else {
  const { data } = await supabase
    .from('applications')
    .select('id, status, created_at, cover_note, jobs(title, slug)')
    .order('created_at', { ascending: false });
  applications = data ?? [];
}

let savedJobs: any[] = [];
if (role !== 'client') {
  const { data: sj } = await supabase
    .from('saved_jobs')
    .select('created_at, jobs(title, slug, department, status)')
    .order('created_at', { ascending: false });
  savedJobs = (sj ?? []).filter((r: any) => r.jobs);
}

const fmtDate = (s: string) => new Date(s).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="لوحتي | Vacant HR" path="/dashboard" active="dashboard" noindex={true}>
<main id="main">
<section style="padding:44px 0 70px;">
  <div class="wrap">
    <div class="dash-head">
      <div>
        <div class="eyebrow-line">لوحتي</div>
        <h1>أهلاً، {profile?.full_name || user.email}</h1>
      </div>
      <a href="/logout" class="btn">تسجيل الخروج</a>
    </div>

    <nav class="dash-nav">
      <a href="/dashboard" class="active">{role === 'client' ? 'طلبات التوظيف' : 'طلباتي'}</a>
      <a href="/dashboard/profile">بياناتي</a>
      {role !== 'client' && <a href="/careers">تصفّح الوظائف</a>}
      {profile?.role === 'admin' && <a href="/admin">لوحة الإدارة</a>}
    </nav>

    {justApplied && <p class="notice notice-ok" style="margin-bottom:24px;">تم إرسال طلبك بنجاح. هتلاقيه تحت.</p>}
    {justSent && <p class="notice notice-ok" style="margin-bottom:24px;">استلمنا طلبك، وهنبدأ نشتغل عليه ونرجعلك.</p>}
    {justDecided && <p class="notice notice-ok" style="margin-bottom:24px;">تم تسجيل قرارك. شكرًا!</p>}

    {role === 'client' ? (
      <>
        <h2 style="margin-bottom:16px;">اطلب توظيف لدور جديد</h2>
        {formMsg && formMsg !== 'ok' && <p class="notice notice-error" style="margin-bottom:16px;">{formMsg}</p>}
        <form class="form-box" method="POST" style="max-width:620px;margin-bottom:44px;">
          <div class="form-row">
            <label for="role_title">المسمى الوظيفي المطلوب</label>
            <input type="text" id="role_title" name="role_title" required />
          </div>
          <div class="form-row">
            <label for="headcount">عدد الأشخاص</label>
            <input type="number" id="headcount" name="headcount" min="1" max="50" value="1" />
          </div>
          <div class="form-row">
            <label for="details_md">تفاصيل الدور والمتطلبات</label>
            <textarea id="details_md" name="details_md" maxlength="4000" placeholder="المهام الأساسية، سنوات الخبرة، الميزانية، مكان العمل..."></textarea>
          </div>
          <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إرسال الطلب</button>
        </form>

        <h2 style="margin-bottom:16px;">طلباتك السابقة</h2>
        {requests.length === 0 ? (
          <p style="color:var(--teal-2);">مفيش طلبات لسه.</p>
        ) : (
          <div class="table-scroll">
            <table class="data-table">
              <thead><tr><th>المسمى</th><th>العدد</th><th>الحالة</th><th>التاريخ</th></tr></thead>
              <tbody>
                {requests.map((r) => (
                  <tr>
                    <td>{r.role_title}</td>
                    <td>{r.headcount}</td>
                    <td><span class={`status-pill status-${r.status}`}>{STATUS_AR[r.status] ?? r.status}</span></td>
                    <td>{fmtDate(r.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {requests.some((r) => (shortlistByReq[r.id] ?? []).length > 0) && (
          <>
            <h2 style="margin:40px 0 16px;">المرشحون المقترحون لك</h2>
            {requests.filter((r) => (shortlistByReq[r.id] ?? []).length > 0).map((r) => (
              <div style="margin-bottom:28px;">
                <h3 style="margin-bottom:12px;">{r.role_title}</h3>
                <div style="display:grid;gap:14px;">
                  {(shortlistByReq[r.id] ?? []).map((it: any) => (
                    <div class="form-box" style="max-width:none;">
                      <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;">
                        <strong>{it.headline}</strong>
                        <span class={`status-pill status-${it.client_decision === 'approved' ? 'shortlisted' : it.client_decision === 'rejected' ? 'rejected' : 'submitted'}`}>
                          {it.client_decision === 'approved' ? 'وافقت' : it.client_decision === 'rejected' ? 'رفضت' : 'بانتظار قرارك'}
                        </span>
                      </div>
                      {it.summary && <p style="margin:10px 0 0;color:var(--muted);white-space:pre-wrap;">{it.summary}</p>}
                      {it.client_decision === 'pending' && (
                        <div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;">
                          <form method="POST">
                            <input type="hidden" name="_action" value="decide" />
                            <input type="hidden" name="item_id" value={it.id} />
                            <input type="hidden" name="decision" value="approved" />
                            <button class="btn solid" style="border:none;cursor:pointer;">أوافق على المرشح</button>
                          </form>
                          <form method="POST" style="display:flex;gap:8px;">
                            <input type="hidden" name="_action" value="decide" />
                            <input type="hidden" name="item_id" value={it.id} />
                            <input type="hidden" name="decision" value="rejected" />
                            <input type="text" name="note" placeholder="سبب الرفض (اختياري)" style="width:180px;" />
                            <button class="btn" style="cursor:pointer;">أرفض</button>
                          </form>
                        </div>
                      )}
                      {it.client_note && <p style="margin-top:10px;font-size:0.9rem;color:var(--muted);">ملاحظتك: {it.client_note}</p>}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </>
        )}
      </>
    ) : (
      <>
        <h2 style="margin-bottom:16px;">طلبات التقديم بتاعتك</h2>
        {applications.length === 0 ? (
          <div class="empty-state">
            <h2>لسه ماقدّمتش على وظيفة</h2>
            <p>تصفّح الوظائف المتاحة واختَر اللي يناسبك.</p>
            <a href="/careers" class="btn solid">تصفّح الوظائف</a>
          </div>
        ) : (
          <div class="table-scroll">
            <table class="data-table">
              <thead><tr><th>الوظيفة</th><th>الحالة</th><th>تاريخ التقديم</th></tr></thead>
              <tbody>
                {applications.map((a) => (
                  <tr>
                    <td>{a.jobs?.slug ? <a href={`/careers/${a.jobs.slug}`}>{a.jobs?.title}</a> : (a.jobs?.title ?? '—')}</td>
                    <td><span class={`status-pill status-${a.status}`}>{STATUS_AR[a.status] ?? a.status}</span></td>
                    <td>{fmtDate(a.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {savedJobs.length > 0 && (
          <>
            <h2 style="margin:40px 0 16px;">الوظائف المحفوظة</h2>
            <ul class="job-list">
              {savedJobs.map((s: any) => (
                <li class="job-card">
                  <div class="job-card-main">
                    <h2><a href={`/careers/${s.jobs.slug}`}>{s.jobs.title}</a></h2>
                    <div class="job-meta">
                      {s.jobs.department && <span>{s.jobs.department}</span>}
                      {s.jobs.status !== 'open' && <span>لم تعد متاحة</span>}
                    </div>
                  </div>
                  {s.jobs.status === 'open' && <a href={`/careers/${s.jobs.slug}`} class="btn">التفاصيل ←</a>}
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}
  </div>
</section>
</main>
</Base>
