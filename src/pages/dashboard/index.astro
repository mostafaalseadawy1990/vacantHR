---
import Portal from '../../layouts/Portal.astro';
import Track from '../../components/Track.astro';
import { serverClient } from '../../lib/supabase';
import { completeness } from '../../lib/candidates';

const user = Astro.locals.user!;
const profile = Astro.locals.profile;
const supabase = serverClient(Astro);
const url = new URL(Astro.request.url);
const justApplied = url.searchParams.get('applied') === '1';
const justRegistered = url.searchParams.get('registered') === '1';
const role = profile?.role ?? 'candidate';
const isClient = role === 'client';

const STATUS_AR: Record<string, string> = {
  submitted: 'تحت المراجعة', reviewing: 'قيد الفحص', shortlisted: 'قائمة مختصرة', rejected: 'غير مناسب حاليًا', hired: 'تم التعيين',
  new: 'جديد', in_progress: 'شغّالين عليه', candidates_sent: 'أرسلنا مرشحين', closed: 'مغلق',
};
const fmtDate = (s: string) => new Date(s).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
const fmtDT = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'full', timeStyle: 'short' });
const MODE_AR: Record<string, string> = { online: 'أونلاين', onsite: 'في المقر', phone: 'هاتفيًا' };

// ---------- data
let apps: any[] = [], interviews: any[] = [], saved = 0, suggested: any[] = [], comp = { pct: 0, missing: [] as string[] };
let requests: any[] = [], pending: any[] = [], approved = 0;

if (isClient) {
  const [{ data: rq }, { data: sl }] = await Promise.all([
    supabase.from('client_requests').select('id, role_title, headcount, status, created_at').order('created_at', { ascending: false }),
    supabase.from('client_shortlist').select('id, request_id, headline, summary, client_decision, admin_status').eq('admin_status', 'sent'),
  ]);
  requests = rq ?? [];
  const titles = new Map(requests.map((r) => [r.id, r.role_title]));
  pending = (sl ?? []).filter((i) => i.client_decision === 'pending').map((i) => ({ ...i, role_title: titles.get(i.request_id) }));
  approved = (sl ?? []).filter((i) => i.client_decision === 'approved').length;
} else {
  const [{ data: a }, { data: iv }, { count: sc }, { data: me }] = await Promise.all([
    supabase.from('applications').select('id, status, created_at, jobs(title, slug)').order('created_at', { ascending: false }).limit(5),
    supabase.from('interviews').select('id, scheduled_at, mode, location, applications(jobs(title, slug))').neq('status', 'cancelled').gte('scheduled_at', new Date().toISOString()).order('scheduled_at').limit(3),
    supabase.from('saved_jobs').select('job_id', { count: 'exact', head: true }),
    supabase.from('profiles').select('*').eq('id', user.id).maybeSingle(),
  ]);
  apps = a ?? []; interviews = iv ?? []; saved = sc ?? 0;
  comp = completeness(me ?? {});
  // Suggested open jobs sharing at least one skill with the candidate (max 3).
  const mySkills = ((me?.skills ?? []) as string[]).map((s) => s.toLowerCase());
  if (mySkills.length) {
    const { data: jobs } = await supabase.from('jobs').select('title, slug, department, skills').eq('status', 'open').limit(60);
    const appliedSlugs = new Set(apps.map((x) => x.jobs?.slug));
    suggested = (jobs ?? [])
      .map((j: any) => ({ ...j, hits: (j.skills ?? []).filter((s: string) => mySkills.includes(s.toLowerCase())).length }))
      .filter((j: any) => j.hits > 0 && !appliedSlugs.has(j.slug))
      .sort((x: any, y: any) => y.hits - x.hits).slice(0, 3);
  }
}
const { count: appsTotal } = isClient ? { count: 0 } : await supabase.from('applications').select('id', { count: 'exact', head: true });
---
<Portal title="لوحتي | Vacant HR" path="/dashboard" active="home">
<Fragment slot="heading">أهلاً، {profile?.full_name || user.email}</Fragment>
<div class="admin-body">
  {justApplied && <p class="notice notice-ok" style="margin-bottom:18px;">تم إرسال طلبك بنجاح.</p>}

  {isClient ? (
    <>
      <div class="ptiles">
        <a href="/dashboard/requests" class="ptile"><b>{requests.filter((r) => r.status !== 'closed').length}</b><span>طلبات توظيف مفتوحة</span></a>
        <a href="/dashboard/requests#pending" class="ptile"><b>{pending.length}</b><span>مرشحون بانتظار قرارك</span></a>
        <a href="/dashboard/requests" class="ptile"><b>{approved}</b><span>مرشحون وافقت عليهم</span></a>
      </div>

      {pending.length > 0 && (
        <div class="pnudge">
          <p><strong>{pending.length} مرشح</strong> مستنيين قرارك — راجعهم عشان نكمّل معاك بسرعة.</p>
          <a href="/dashboard/requests#pending" class="btn solid">مراجعة المرشحين</a>
        </div>
      )}

      <div class="pgrid2">
        <section class="psec">
          <div class="psec-head"><h2>آخر الطلبات</h2><a href="/dashboard/requests">كل الطلبات ←</a></div>
          {requests.length === 0 ? <p class="pempty">مفيش طلبات لسه. <a href="/dashboard/requests#new">اطلب توظيف لدور جديد</a>.</p> : requests.slice(0, 5).map((r) => (
            <div class="prow">
              <div class="prow-main"><strong>{r.role_title}</strong><small>{r.headcount} أشخاص · {fmtDate(r.created_at)}</small></div>
              <span class={`status-pill status-${r.status}`}>{STATUS_AR[r.status] ?? r.status}</span>
            </div>
          ))}
        </section>
        <section class="psec">
          <div class="psec-head"><h2>ابدأ طلب جديد</h2></div>
          <p style="color:var(--muted);font-size:.92rem;margin:0 0 14px;">اكتب المسمى والمتطلبات، وفريقنا يبدأ البحث ويرسل لك مرشحين خلال أيام.</p>
          <a href="/dashboard/requests#new" class="btn solid">+ طلب توظيف</a>
        </section>
      </div>
    </>
  ) : (
    <>
      <div class="ptiles">
        <a href="/dashboard/applications" class="ptile"><b>{appsTotal ?? 0}</b><span>طلبات تقديم</span></a>
        <a href="/dashboard/interviews" class="ptile"><b>{interviews.length}</b><span>مقابلات قادمة</span></a>
        <a href="/dashboard/saved" class="ptile"><b>{saved}</b><span>وظائف محفوظة</span></a>
        <a href="/dashboard/profile" class="ptile"><b>{comp.pct}%</b><span>اكتمال الملف</span></a>
      </div>

      {comp.pct < 80 && (
        <div class="pnudge">
          <p>ملفك مكتمل <strong>{comp.pct}%</strong>. كمّل {comp.missing.slice(0, 3).join('، ')}{comp.missing.length > 3 ? ' وغيرها' : ''} عشان نرشّحك لوظائف أنسب.</p>
          <a href="/dashboard/profile" class="btn solid">أكمل ملفي</a>
        </div>
      )}

      {interviews.length > 0 && (
        <section class="psec">
          <div class="psec-head"><h2>مقابلاتك القادمة</h2><a href="/dashboard/interviews">الكل ←</a></div>
          {interviews.map((v: any) => (
            <div class="prow">
              <div class="prow-main"><strong>{v.applications?.jobs?.title ?? 'وظيفة'}</strong><small>{fmtDT(v.scheduled_at)} — {MODE_AR[v.mode] ?? v.mode}{v.location && <> · <span dir="ltr">{v.location}</span></>}</small></div>
            </div>
          ))}
        </section>
      )}

      <div class="pgrid2">
        <section class="psec">
          <div class="psec-head"><h2>آخر طلباتك</h2><a href="/dashboard/applications">كل الطلبات ←</a></div>
          {apps.length === 0 ? <p class="pempty">لسه ماقدّمتش على وظيفة. <a href="/careers">تصفّح الوظائف</a>.</p> : apps.map((a) => (
            <div class="prow">
              <div class="prow-main"><strong>{a.jobs?.title ?? '—'}</strong><small>{fmtDate(a.created_at)}</small></div>
              <span class={`status-pill status-${a.status}`}>{STATUS_AR[a.status] ?? a.status}</span>
            </div>
          ))}
        </section>
        <section class="psec">
          <div class="psec-head"><h2>وظائف تناسب مهاراتك</h2><a href="/careers">كل الوظائف ←</a></div>
          {suggested.length === 0 ? <p class="pempty">{comp.pct < 40 ? 'ضيف مهاراتك في ملفك عشان نقترح عليك وظائف.' : 'مفيش وظائف مطابقة حاليًا — تابعنا.'}</p> : suggested.map((j: any) => (
            <div class="prow">
              <div class="prow-main"><strong><a href={`/careers/${j.slug}`}>{j.title}</a></strong><small>{j.department ?? ''} · {j.hits} مهارات مطابقة</small></div>
              <a href={`/careers/${j.slug}`} class="btn" style="padding:6px 12px;font-size:.82rem;">التفاصيل</a>
            </div>
          ))}
        </section>
      </div>
    </>
  )}
</div>
{justApplied && <Track event="SubmitApplication" />}
{justRegistered && <Track event="CompleteRegistration" params={{ content_name: role }} />}
</Portal>
