---
import Admin from '../../../layouts/Admin.astro';
import RichEditor from '../../../components/RichEditor.astro';
import { serverClient } from '../../../lib/supabase';
import { sanitizeHtml } from '../../../lib/html';
import { RESERVED_SLUGS } from '../../../lib/pages';

const { id } = Astro.params;
const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save');

  if (action === 'delete') {
    await supabase.from('pages').delete().eq('id', id);
    return Astro.redirect('/admin/pages', 303);
  }

  const patch = {
    title: String(form.get('title') || '').trim(),
    slug: String(form.get('slug') || '').trim().replace(/[^a-z0-9-]/g, ''),
    description: String(form.get('description') || '').trim(),
    body_html: sanitizeHtml(String(form.get('body_html') || '')),
    status: form.get('status') === 'published' ? 'published' : 'draft',
    updated_at: new Date().toISOString(),
  };

  if (!patch.title || !patch.slug) {
    flash = 'العنوان والرابط مطلوبين.';
  } else if (RESERVED_SLUGS.has(patch.slug)) {
    flash = 'الرابط ده محجوز لصفحة أساسية في الموقع — اختار غيره.';
  } else {
    const { error } = await supabase.from('pages').update(patch).eq('id', id);
    if (error) flash = error.code === '23505' ? 'الرابط مستخدم قبل كده.' : `تعذّر الحفظ: ${error.message}`;
    else return Astro.redirect(`/admin/pages/${id}?ok=1`, 303);
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: page } = await supabase.from('pages').select('*').eq('id', id).maybeSingle();
if (!page) return Astro.redirect('/admin/pages', 302);
---
<Admin title={`${page.title} | تحرير صفحة`} path={`/admin/pages/${id}`} active="pages">
<Fragment slot="heading">{page.title}</Fragment>
<div class="admin-body">
    <p style="margin-bottom:16px;">
      <a href="/admin/pages">→ رجوع للصفحات</a>
      {page.status === 'published' && <> <span style="color:var(--line);margin:0 8px;">|</span> <a href={`/${page.slug}`} target="_blank" rel="noopener">معاينة ↗</a></>}
    </p>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <form method="POST" class="form-box" style="max-width:980px;">
      <div class="form-grid-2">
        <div class="form-row"><label for="title">العنوان</label><input id="title" name="title" value={page.title} required /></div>
        <div class="form-row"><label for="slug">الرابط — vacanthr.com/<b>slug</b></label><input id="slug" name="slug" value={page.slug} pattern="[a-z0-9-]*" dir="ltr" required /></div>
      </div>
      <div class="form-row"><label for="description">وصف الصفحة لجوجل (اختياري — 150 حرف)</label><textarea id="description" name="description" style="min-height:60px;">{page.description}</textarea></div>
      <div class="form-row">
        <label>المحتوى</label>
        <RichEditor name="body_html" value={page.body_html} minHeight={520} />
      </div>
      <div class="form-row">
        <label for="status">الحالة</label>
        <select id="status" name="status">
          <option value="draft" selected={page.status === 'draft'}>مسودة</option>
          <option value="published" selected={page.status === 'published'}>منشورة (تظهر للجمهور)</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;">
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
        <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;" onclick="return confirm('حذف الصفحة نهائيًا؟')">حذف</button>
      </div>
    </form>
</div>
</Admin>
