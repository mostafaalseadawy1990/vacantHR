---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import { serverClient } from '../../lib/supabase';

const supabase = serverClient(Astro);
const role = Astro.locals.profile?.role;
const nowIso = new Date().toISOString();
const d7 = new Date(Date.now() - 7 * 864e5).toISOString();

const [
  { count: openJobs }, { count: draftJobs }, { count: newApps }, { count: newReqs },
  { data: recent }, { data: upcoming }, { data: convs }, { data: activity },
] = await Promise.all([
  supabase.from('jobs').select('id', { count: 'exact', head: true }).eq('status', 'open'),
  supabase.from('jobs').select('id', { count: 'exact', head: true }).eq('status', 'draft'),
  supabase.from('applications').select('id', { count: 'exact', head: true }).eq('status', 'submitted'),
  supabase.from('client_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  supabase.from('applications').select('id, status, created_at, candidate_id, jobs(title, slug), profiles(full_name)').order('created_at', { ascending: false }).limit(6),
  supabase.from('interviews').select('id, scheduled_at, mode, applications(candidate_id, profiles(full_name), jobs(title))').neq('status', 'cancelled').gte('scheduled_at', nowIso).order('scheduled_at').limit(5),
  supabase.from('conversations').select('id, subject, last_message_at, profiles(full_name, company_name)').order('last_message_at', { ascending: false }).limit(5),
  role === 'admin'
    ? supabase.from('audit_log').select('actor_name, action, target, created_at').order('created_at', { ascending: false }).limit(6)
    : Promise.resolve({ data: [] as any[] }),
]);

const STATUS_AR: Record<string, string> = {
  submitted: 'تحت المراجعة', reviewing: 'قيد الفحص', shortlisted: 'قائمة مختصرة',
  rejected: 'مرفوض', hired: 'تم التعيين',
};
const MODE_AR: Record<string, string> = { online: 'أونلاين', onsite: 'في المقر', phone: 'هاتفيًا' };
const fmt = (s: string) => new Date(s).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
const fmtDT = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
---
<Base title="لوحة الإدارة | Vacant HR" path="/admin" active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="home">نظرة عامة</AdminNav>

    <div class="stat-cards" style="grid-template-columns:repeat(4,1fr);">
      <a href="/admin/jobs" class="stat-card"><span class="n">{openJobs ?? 0}</span><span class="l">وظيفة مفتوحة</span></a>
      <a href="/admin/jobs" class="stat-card"><span class="n">{draftJobs ?? 0}</span><span class="l">مسودة</span></a>
      <a href="/admin/jobs" class="stat-card"><span class="n">{newApps ?? 0}</span><span class="l">تقديم جديد للمراجعة</span></a>
      <a href="/admin/requests" class="stat-card"><span class="n">{newReqs ?? 0}</span><span class="l">طلب شركة جديد</span></a>
    </div>

    <div style="display:flex;gap:12px;flex-wrap:wrap;margin:26px 0 32px;">
      <a href="/admin/jobs/new" class="btn solid">+ وظيفة جديدة</a>
      <a href="/admin/candidates" class="btn">المرشحون</a>
      <a href="/admin/inbox" class="btn">الرسائل</a>
    </div>

    <div class="split-2">
      <div>
        <h2 style="margin-bottom:12px;">آخر المتقدمين</h2>
        {(!recent || recent.length === 0) ? <p style="color:var(--muted);">مفيش طلبات لسه.</p> : (
          <div class="table-scroll"><table class="data-table">
            <thead><tr><th>المرشح</th><th>الوظيفة</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
              {recent.map((a: any) => (
                <tr>
                  <td>{a.candidate_id ? <a href={`/admin/candidates/${a.candidate_id}`}>{a.profiles?.full_name ?? '—'}</a> : (a.profiles?.full_name ?? '—')}</td>
                  <td>{a.jobs?.title ?? '—'}</td>
                  <td><span class={`status-pill status-${a.status}`}>{STATUS_AR[a.status] ?? a.status}</span></td>
                  <td style="color:var(--muted);">{fmt(a.created_at)}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        )}
      </div>

      <div>
        <h2 style="margin-bottom:12px;">مقابلات قادمة</h2>
        {(!upcoming || upcoming.length === 0) ? <p style="color:var(--muted);">مفيش مقابلات مجدولة.</p> : (
          <div style="display:grid;gap:10px;">
            {upcoming.map((v: any) => (
              <div class="form-box" style="max-width:none;padding:14px 16px;">
                <strong>{v.applications?.profiles?.full_name ?? '—'}</strong>
                <span style="color:var(--muted);"> · {v.applications?.jobs?.title ?? ''}</span>
                <div style="font-size:0.85rem;color:var(--muted);margin-top:4px;">{fmtDT(v.scheduled_at)} — {MODE_AR[v.mode] ?? v.mode}</div>
              </div>
            ))}
            <a href="/admin/interviews" style="font-size:0.85rem;">كل المقابلات ←</a>
          </div>
        )}
      </div>
    </div>

    <div class="split-2" style="margin-top:32px;">
      <div>
        <h2 style="margin-bottom:12px;">أحدث المحادثات</h2>
        {(!convs || convs.length === 0) ? <p style="color:var(--muted);">مفيش محادثات.</p> : (
          <div class="table-scroll"><table class="data-table">
            <thead><tr><th>الطرف</th><th>الموضوع</th><th></th></tr></thead>
            <tbody>
              {convs.map((c: any) => (
                <tr>
                  <td><a href={`/admin/inbox/${c.id}`}>{c.profiles?.company_name || c.profiles?.full_name || '—'}</a></td>
                  <td>{c.subject}</td>
                  <td style="color:var(--muted);">{fmt(c.last_message_at)}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
        )}
      </div>

      {role === 'admin' && (
        <div>
          <h2 style="margin-bottom:12px;">آخر نشاط الفريق</h2>
          {(!activity || activity.length === 0) ? <p style="color:var(--muted);">—</p> : (
            <ul style="list-style:none;padding:0;margin:0;font-size:0.9rem;">
              {activity.map((r: any) => (
                <li style="padding:9px 0;border-top:1px solid var(--line-soft);color:var(--body);">
                  <strong>{r.actor_name ?? '—'}</strong> — {r.action}{r.target ? ` · ${r.target}` : ''}
                  <span style="color:var(--muted);"> · {fmt(r.created_at)}</span>
                </li>
              ))}
            </ul>
          )}
          <a href="/admin/activity" style="font-size:0.85rem;display:inline-block;margin-top:8px;">السجل الكامل ←</a>
        </div>
      )}
    </div>
  </div>
</section>
</main>
</Base>

<style is:global>
  .stat-cards{display:grid;gap:14px;}
  .stat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px 20px;display:flex;flex-direction:column;gap:4px;transition:transform .16s, box-shadow .16s;}
  .stat-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md);}
  .stat-card .n{font-size:1.9rem;color:var(--ink);font-weight:700;letter-spacing:-0.02em;}
  .stat-card .l{font-size:0.84rem;color:var(--muted);}
  @media(max-width:720px){.stat-cards{grid-template-columns:1fr 1fr!important;}}
</style>
