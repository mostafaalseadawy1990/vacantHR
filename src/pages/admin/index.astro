---
import { APP_STATUS_AR, MODE_AR } from '../../lib/labels';
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';

const supabase = serverClient(Astro);
const role = Astro.locals.profile?.role;
const nowIso = new Date().toISOString();
const d7 = new Date(Date.now() - 7 * 864e5).toISOString();

const todayEnd = new Date(); todayEnd.setHours(23, 59, 59, 999);
const [
  { count: openJobs }, { count: draftJobs }, { count: newApps }, { count: newReqs },
  { data: recent }, { data: upcoming }, { data: convs }, { data: activity },
  { count: apps7 }, { count: pendingDecisions }, { count: candidates }, { data: viewsRows },
] = await Promise.all([
  supabase.from('jobs').select('id', { count: 'exact', head: true }).eq('status', 'open'),
  supabase.from('jobs').select('id', { count: 'exact', head: true }).eq('status', 'draft'),
  supabase.from('applications').select('id', { count: 'exact', head: true }).eq('status', 'submitted'),
  supabase.from('client_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  supabase.from('applications').select('id, status, created_at, candidate_id, jobs(title, slug), profiles(full_name)').order('created_at', { ascending: false }).limit(6),
  supabase.from('interviews').select('id, scheduled_at, mode, applications(candidate_id, profiles(full_name), jobs(title))').neq('status', 'cancelled').gte('scheduled_at', nowIso).order('scheduled_at').limit(5),
  supabase.from('conversations').select('id, subject, last_message_at, profiles(full_name, company_name)').order('last_message_at', { ascending: false }).limit(5),
  role === 'admin'
    ? supabase.from('audit_log').select('actor_name, action, target, created_at').order('created_at', { ascending: false }).limit(6)
    : Promise.resolve({ data: [] as any[] }),
  supabase.from('applications').select('id', { count: 'exact', head: true }).gte('created_at', d7),
  supabase.from('client_shortlist').select('id', { count: 'exact', head: true }).eq('admin_status', 'sent').eq('client_decision', 'pending'),
  supabase.from('profiles').select('id', { count: 'exact', head: true }).eq('role', 'candidate'),
  supabase.from('job_views').select('count').gte('day', d7.slice(0, 10)),
]);
const views7 = (viewsRows ?? []).reduce((s: number, r: any) => s + (r.count ?? 0), 0);
const todayIv = (upcoming ?? []).filter((v: any) => new Date(v.scheduled_at) <= todayEnd);
const attention = [
  { n: newApps ?? 0, l: 'طلب تقديم جديد محتاج مراجعة', href: '/admin/candidates' },
  { n: newReqs ?? 0, l: 'طلب شركة جديد', href: '/admin/requests' },
  { n: todayIv.length, l: 'مقابلة النهارده', href: '/admin/interviews' },
  { n: pendingDecisions ?? 0, l: 'مرشح مستني قرار العميل', href: '/admin/requests' },
  { n: draftJobs ?? 0, l: 'وظيفة مسودة لسه ما اتنشرتش', href: '/admin/jobs?status=draft' },
].filter((a) => a.n > 0);
const hello = new Date().getHours() < 12 ? 'صباح الخير' : 'مساء الخير';
const fmt = (s: string) => new Date(s).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' });
const fmtDT = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
const STATUS_AR = APP_STATUS_AR;
---
<Admin title="لوحة الإدارة | Vacant HR" path="/admin" active="home">
<Fragment slot="heading">{hello}، {Astro.locals.profile?.full_name?.split(' ')[0] ?? ''}</Fragment>
<div class="admin-body">

  <div class="ptiles" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));">
    <a href="/admin/jobs?status=open" class="ptile"><b>{openJobs ?? 0}</b><span>وظيفة مفتوحة</span></a>
    <a href="/admin/candidates" class="ptile"><b>{apps7 ?? 0}</b><span>تقديمات آخر 7 أيام</span></a>
    <a href="/admin/analytics?p=7" class="ptile"><b>{views7.toLocaleString('en-US')}</b><span>مشاهدات وظائف (7 أيام)</span></a>
    <a href="/admin/candidates" class="ptile"><b>{(candidates ?? 0).toLocaleString('en-US')}</b><span>مرشح في القاعدة</span></a>
    <a href="/admin/interviews" class="ptile"><b>{upcoming?.length ?? 0}</b><span>مقابلات قادمة</span></a>
  </div>

  <div class="pgrid2" style="grid-template-columns:minmax(0,1.4fr) minmax(280px,1fr);">
    <div>
      {attention.length > 0 && (
        <section class="psec attention">
          <div class="psec-head"><h2>محتاج انتباهك</h2></div>
          {attention.map((a) => (
            <a href={a.href} class="prow" style="color:inherit;">
              <div class="prow-main"><strong>{a.n} {a.l}</strong></div><span class="arrow">←</span>
            </a>
          ))}
        </section>
      )}

      <section class="psec">
        <div class="psec-head"><h2>آخر المتقدمين</h2><a href="/admin/candidates">الكل ←</a></div>
        {(!recent || recent.length === 0) ? <p class="pempty">مفيش طلبات لسه.</p> : recent.map((a: any) => (
          <div class="prow">
            <div class="prow-main">
              <strong>{a.candidate_id ? <a href={`/admin/candidates/${a.candidate_id}`}>{a.profiles?.full_name ?? '—'}</a> : (a.profiles?.full_name ?? '—')}</strong>
              <small>{a.jobs?.title ?? '—'} · {fmt(a.created_at)}</small>
            </div>
            <span class={`status-pill status-${a.status}`}>{STATUS_AR[a.status] ?? a.status}</span>
          </div>
        ))}
      </section>

      <section class="psec">
        <div class="psec-head"><h2>أحدث المحادثات</h2><a href="/admin/inbox">الكل ←</a></div>
        {(!convs || convs.length === 0) ? <p class="pempty">مفيش محادثات.</p> : convs.map((c: any) => (
          <div class="prow">
            <div class="prow-main"><strong><a href={`/admin/inbox/${c.id}`}>{c.profiles?.company_name || c.profiles?.full_name || '—'}</a></strong><small>{c.subject}</small></div>
            <small style="color:var(--muted);">{fmt(c.last_message_at)}</small>
          </div>
        ))}
      </section>
    </div>

    <div>
      <section class="psec">
        <div class="psec-head"><h2>إجراءات سريعة</h2></div>
        <div class="quick">
          <a href="/admin/jobs/new" class="btn solid">+ وظيفة جديدة</a>
          <a href="/admin/blog" class="btn">+ مقال</a>
          <a href="/admin/candidates" class="btn">بحث عن مرشح</a>
          <a href="/admin/media" class="btn">رفع صور</a>
        </div>
      </section>

      <section class="psec">
        <div class="psec-head"><h2>مقابلات قادمة</h2><a href="/admin/interviews">الكل ←</a></div>
        {(!upcoming || upcoming.length === 0) ? <p class="pempty">مفيش مقابلات مجدولة.</p> : upcoming.map((v: any) => (
          <div class="prow">
            <div class="prow-main">
              <strong>{v.applications?.candidate_id ? <a href={`/admin/candidates/${v.applications.candidate_id}`}>{v.applications?.profiles?.full_name ?? '—'}</a> : (v.applications?.profiles?.full_name ?? '—')}</strong>
              <small>{v.applications?.jobs?.title ?? ''} · {fmtDT(v.scheduled_at)} — {MODE_AR[v.mode] ?? v.mode}</small>
            </div>
          </div>
        ))}
      </section>

      {role === 'admin' && (
        <section class="psec">
          <div class="psec-head"><h2>آخر نشاط الفريق</h2><a href="/admin/activity">السجل ←</a></div>
          {(!activity || activity.length === 0) ? <p class="pempty">—</p> : activity.map((r: any) => (
            <div class="prow"><div class="prow-main"><strong style="font-size:.9rem;">{r.actor_name ?? '—'}</strong><small>{r.action}{r.target ? ` · ${r.target}` : ''} · {fmt(r.created_at)}</small></div></div>
          ))}
        </section>
      )}
    </div>
  </div>
</div>
<style is:global>
  .attention{ border-color:#FCD34D; background:#FFFBEB; }
  .attention .prow .arrow{ color:#B45309; font-weight:700; }
  .quick{ display:flex; flex-wrap:wrap; gap:8px; }
  .quick .btn{ padding:8px 14px; font-size:.86rem; }
  @media (max-width:900px){ .pgrid2{ grid-template-columns:1fr !important; } }
</style>
</Admin>
