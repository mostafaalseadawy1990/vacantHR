---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';
import { logAction } from '../../../lib/audit';
import { fmtDT } from '../../../lib/labels';
import { waLink } from '../../../lib/candidates';

const supabase = serverClient(Astro);
let flash = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') || ''), action = String(form.get('_action') || '');
  if (id && action === 'toggle') {
    const { data } = await supabase.from('contact_messages').select('status').eq('id', id).maybeSingle();
    await supabase.from('contact_messages').update({ status: data?.status === 'new' ? 'handled' : 'new' }).eq('id', id);
  } else if (id && action === 'note') {
    await supabase.from('contact_messages').update({ note: String(form.get('note') || '').trim().slice(0, 2000) || null }).eq('id', id);
  } else if (id && action === 'delete') {
    await supabase.from('contact_messages').delete().eq('id', id);
    await logAction(Astro, supabase, 'حذف رسالة موقع', id);
  }
  return Astro.redirect('/admin/contact?ok=1', 303);
}
const url = new URL(Astro.request.url);
const ok = url.searchParams.get('ok') === '1';
const f = url.searchParams.get('status') || '';
const { data: all, error } = await supabase.from('contact_messages').select('*').order('created_at', { ascending: false }).limit(300);
const rows = (all ?? []).filter((m: any) => !f || m.status === f);
const counts = { all: (all ?? []).length, new: (all ?? []).filter((m: any) => m.status === 'new').length, handled: (all ?? []).filter((m: any) => m.status === 'handled').length };
---
<Admin title="رسائل الموقع | لوحة الإدارة" path="/admin/contact" active="contact">
<Fragment slot="heading">رسائل الموقع</Fragment>
<div class="admin-body">
  {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
  {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}
  {error && <p class="notice notice-error" style="margin-bottom:18px;">تعذّر تحميل الرسائل — تأكد من تشغيل migration-19 في Supabase.</p>}
  <div class="an-bar">
    <div class="seg">
      <a href="/admin/contact" class:list={{ active: !f }}>الكل <small>{counts.all}</small></a>
      <a href="/admin/contact?status=new" class:list={{ active: f === 'new' }}>جديدة <small>{counts.new}</small></a>
      <a href="/admin/contact?status=handled" class:list={{ active: f === 'handled' }}>تمت المتابعة <small>{counts.handled}</small></a>
    </div>
    <span style="color:var(--muted);font-size:.85rem;">رسائل نموذج "تواصل معنا" على الموقع</span>
  </div>
  {rows.length === 0 ? <div class="cempty">مفيش رسائل{f ? ' في الحالة دي' : ' لسه'}.</div> : (
    <div class="citems" style="max-width:none;">
      {rows.map((m: any) => (
        <details class:list={['citem', { 'is-new': m.status === 'new' }]} open={m.status === 'new' || undefined}>
          <summary>
            <span class:list={['dot', { on: m.status === 'new' }]} title={m.status === 'new' ? 'جديدة' : 'تمت المتابعة'}></span>
            <span class="citem-title"><strong>{m.name}{m.company && <small style="display:inline;font-weight:400;"> — {m.company}</small>}</strong><small>{m.service ?? '—'} · {fmtDT(m.created_at)} · {m.message.slice(0, 90)}</small></span>
            <span class="citem-side"><span class={`status-pill status-${m.status === 'new' ? 'submitted' : 'shortlisted'}`}>{m.status === 'new' ? 'جديدة' : 'تمت المتابعة'}</span><span class="citem-chev">▼</span></span>
          </summary>
          <div class="citem-body">
            <p style="white-space:pre-wrap;margin:0 0 12px;">{m.message}</p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
              <a href={`mailto:${m.email}?subject=${encodeURIComponent('رد من Vacant HR')}`} class="btn" style="padding:7px 14px;font-size:.85rem;">✉ {m.email}</a>
              {m.phone && <a href={`tel:${m.phone}`} class="btn" style="padding:7px 14px;font-size:.85rem;" dir="ltr">📞 {m.phone}</a>}
              {waLink(m.phone) && <a href={waLink(m.phone)!} target="_blank" rel="noopener" class="btn" style="padding:7px 14px;font-size:.85rem;">واتساب</a>}
            </div>
            <form method="POST" style="display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;">
              <input type="hidden" name="id" value={m.id} /><input type="hidden" name="_action" value="note" />
              <input name="note" value={m.note ?? ''} placeholder="ملاحظة داخلية (اتصلنا، مهتم، لا يرد…)" style="flex:1;min-width:220px;margin:0;padding:8px 12px;" />
              <button class="btn" style="cursor:pointer;padding:8px 14px;font-size:.85rem;">حفظ الملاحظة</button>
            </form>
            <div class="citem-actions">
              <form method="POST"><input type="hidden" name="id" value={m.id} /><input type="hidden" name="_action" value="toggle" /><button class="btn solid" style="border:none;cursor:pointer;">{m.status === 'new' ? '✓ تمت المتابعة' : 'إرجاع لجديدة'}</button></form>
              <form method="POST" onsubmit="return confirm('حذف الرسالة نهائيًا؟')"><input type="hidden" name="id" value={m.id} /><input type="hidden" name="_action" value="delete" /><button class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;">حذف</button></form>
            </div>
          </div>
        </details>
      ))}
    </div>
  )}
</div>
<style is:global>
  .citem.is-new{ border-inline-start:3px solid #F59E0B; }
  .dot{ width:10px; height:10px; border-radius:50%; background:var(--line); display:inline-block; }
  .dot.on{ background:#F59E0B; }
</style>
</Admin>
