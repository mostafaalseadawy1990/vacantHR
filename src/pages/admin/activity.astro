---
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';

import { ROLE_AR } from '../../lib/roles';

const supabase = serverClient(Astro);
const url = new URL(Astro.request.url);
const actor = url.searchParams.get('actor') || '';
const q = (url.searchParams.get('q') || '').trim();

let query = supabase
  .from('audit_log')
  .select('id, actor_id, actor_name, actor_role, action, target, created_at')
  .order('created_at', { ascending: false })
  .limit(300);
if (actor) query = query.eq('actor_id', actor);
if (q) query = query.or(`action.ilike.%${q}%,target.ilike.%${q}%,actor_name.ilike.%${q}%`);
const { data: rows } = await query;

const { data: members } = await supabase
  .from('profiles').select('id, full_name, email')
  .in('role', ['admin', 'recruiter', 'editor', 'support', 'viewer']).order('full_name');
const fmt = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
---
<Admin title="سجل النشاط | لوحة الإدارة" path="/admin/activity" active="activity">
<Fragment slot="heading">سجل النشاط</Fragment>
<div class="admin-body">
    <form method="GET" class="act-filters">
      <select name="actor">
        <option value="">كل الأعضاء</option>
        {(members ?? []).map((m: any) => <option value={m.id} selected={actor === m.id}>{m.full_name || m.email}</option>)}
      </select>
      <input type="search" name="q" value={q} placeholder="بحث في الإجراء أو الهدف…" />
      <button class="btn solid" style="border:none;cursor:pointer;">تصفية</button>
      {(actor || q) && <a href="/admin/activity" class="btn">مسح</a>}
    </form>

    {(!rows || rows.length === 0) ? (
      <p style="color:var(--muted);">مفيش نشاط مسجّل لسه.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>الوقت</th><th>العضو</th><th>الدور</th><th>الإجراء</th><th>على</th></tr></thead>
          <tbody>
            {rows.map((r: any) => (
              <tr>
                <td style="white-space:nowrap;">{fmt(r.created_at)}</td>
                <td>{r.actor_id ? <a href={`/admin/activity?actor=${r.actor_id}`}>{r.actor_name ?? '—'}</a> : (r.actor_name ?? '—')}</td>
                <td><span class="status-pill status-submitted">{ROLE_AR[r.actor_role] ?? r.actor_role ?? '—'}</span></td>
                <td>{r.action}</td><td>{r.target ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
</div>
<style is:global>
  .act-filters{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:20px; }
  .act-filters select, .act-filters input{ min-width:200px; }
</style>
</Admin>
