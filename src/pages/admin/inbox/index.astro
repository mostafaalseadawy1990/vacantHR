---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';

const supabase = serverClient(Astro);
const { data: convs } = await supabase
  .from('conversations')
  .select('id, subject, last_message_at, created_at, profiles(full_name, company_name, email)')
  .order('last_message_at', { ascending: false })
  .limit(100);
const fmt = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
---
<Admin title="الرسائل | لوحة الإدارة" path="/admin/inbox" active="inbox">
<Fragment slot="heading">الرسائل</Fragment>
<div class="admin-body">
    {(!convs || convs.length === 0) ? (
      <p style="color:var(--muted);">مفيش محادثات. تقدر تبدأ محادثة من صفحة أي مرشح أو طلب شركة.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>الطرف</th><th>الموضوع</th><th>آخر رسالة</th></tr></thead>
          <tbody>
            {convs.map((c: any) => (
              <tr>
                <td><a href={`/admin/inbox/${c.id}`}>{c.profiles?.company_name || c.profiles?.full_name || c.profiles?.email || '—'}</a></td>
                <td>{c.subject}</td>
                <td>{fmt(c.last_message_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
</div>
</Admin>
