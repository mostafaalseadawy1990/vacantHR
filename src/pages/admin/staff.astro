---
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';
import { logAction } from '../../lib/audit';
import { STAFF_ROLES, ROLE_AR, ROLE_DESC } from '../../lib/roles';

const supabase = serverClient(Astro);
const me = Astro.locals.user!;
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const uid = String(form.get('uid') || '');
  const role = String(form.get('role') || '');
  if (!uid || ![...STAFF_ROLES, 'candidate', 'client'].includes(role)) {
    flash = 'بيانات غير صحيحة.';
  } else if (uid === me.id && role !== 'admin') {
    flash = 'لا يمكنك إزالة صلاحية المدير عن نفسك.';
  } else {
    const { data: target } = await supabase.from('profiles').select('full_name, email').eq('id', uid).maybeSingle();
    const { error } = await supabase.from('profiles').update({ role }).eq('id', uid);
    if (error) flash = `تعذّر التحديث: ${error.message}`;
    else {
      await logAction(Astro, supabase, `تغيير دور إلى ${ROLE_AR[role] ?? role}`, target?.full_name ?? target?.email ?? uid);
      return Astro.redirect('/admin/staff?ok=1', 303);
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: staff } = await supabase
  .from('profiles').select('id, full_name, email, role, created_at')
  .in('role', [...STAFF_ROLES]).order('created_at');

// Last activity per member (for the table + link to their log).
const { data: lastActs } = await supabase
  .from('audit_log').select('actor_id, action, created_at').order('created_at', { ascending: false }).limit(500);
const lastBy = new Map<string, { action: string; created_at: string }>();
for (const a of lastActs ?? []) if (a.actor_id && !lastBy.has(a.actor_id)) lastBy.set(a.actor_id, a);
const fmt = (d: string) => new Date(d).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });

const q = (new URL(Astro.request.url).searchParams.get('q') || '').trim();
let found: any[] = [];
if (q) {
  const { data } = await supabase.from('profiles')
    .select('id, full_name, email, role')
    .or(`email.ilike.%${q}%,full_name.ilike.%${q}%`).limit(20);
  found = data ?? [];
}
---
<Admin title="الفريق | لوحة الإدارة" path="/admin/staff" active="staff">
<Fragment slot="heading">فريق الإدارة</Fragment>
<div class="admin-body">
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <div class="roles-grid">
      {STAFF_ROLES.map((r) => (
        <div class="role-card"><strong>{ROLE_AR[r]}</strong><span>{ROLE_DESC[r]}</span></div>
      ))}
    </div>

    <h2 style="margin-bottom:14px;">الأعضاء الحاليون</h2>
    <div class="table-scroll" style="margin-bottom:32px;">
      <table class="data-table">
        <thead><tr><th>الاسم</th><th>الإيميل</th><th>الدور</th><th>آخر نشاط</th><th>تغيير</th></tr></thead>
        <tbody>
          {(staff ?? []).map((u: any) => (
            <tr>
              <td>{u.full_name ?? '—'}</td>
              <td dir="ltr" style="text-align:right;">{u.email ?? '—'}</td>
              <td>{ROLE_AR[u.role]}</td>
              <td style="font-size:.88rem;">
                {lastBy.get(u.id)
                  ? <>{lastBy.get(u.id)!.action}<br /><small style="color:var(--muted);">{fmt(lastBy.get(u.id)!.created_at)}</small></>
                  : <span style="color:var(--muted);">—</span>}
                <br /><a href={`/admin/activity?actor=${u.id}`} style="font-size:.85rem;">السجل الكامل ↗</a>
              </td>
              <td>
                <form method="POST" style="display:flex;gap:6px;">
                  <input type="hidden" name="uid" value={u.id} />
                  <select name="role" class="mini-select">
                    {STAFF_ROLES.map((r) => <option value={r} selected={u.role === r}>{ROLE_AR[r]}</option>)}
                    <option value="candidate">إزالة (مرشح)</option>
                  </select>
                  <button class="mini-btn">حفظ</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 style="margin-bottom:14px;">إضافة عضو</h2>
    <p style="color:var(--muted);font-size:0.9rem;">لازم يكون عنده حساب على الموقع الأول. ابحث بالإيميل وعيّن الدور.</p>
    <form method="GET" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;max-width:480px;">
      <input type="search" name="q" value={q} placeholder="إيميل أو اسم" style="flex:1;min-width:200px;" />
      <button class="btn solid" style="border:none;cursor:pointer;">بحث</button>
    </form>
    {q && (
      found.length === 0 ? <p style="color:var(--muted);">مفيش نتائج.</p> : (
        <div class="table-scroll"><table class="data-table">
          <thead><tr><th>الاسم</th><th>الإيميل</th><th>الدور الحالي</th><th>تعيين</th></tr></thead>
          <tbody>
            {found.map((u: any) => (
              <tr>
                <td>{u.full_name ?? '—'}</td>
                <td dir="ltr" style="text-align:right;">{u.email ?? '—'}</td>
                <td>{ROLE_AR[u.role] ?? u.role}</td>
                <td>
                  <form method="POST" style="display:flex;gap:6px;">
                    <input type="hidden" name="uid" value={u.id} />
                    <select name="role" class="mini-select">
                      {STAFF_ROLES.filter((r) => r !== 'admin').map((r) => <option value={r}>{ROLE_AR[r]}</option>)}
                      <option value="admin">مدير</option>
                    </select>
                    <button class="mini-btn">تعيين</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )
    )}
</div>
<style is:global>
  .roles-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:10px; margin-bottom:28px; }
  .role-card{ background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-sm); padding:12px 14px; display:flex; flex-direction:column; gap:4px; }
  .role-card strong{ color:var(--accent); }
  .role-card span{ font-size:.85rem; color:var(--muted); line-height:1.5; }
</style>
</Admin>
