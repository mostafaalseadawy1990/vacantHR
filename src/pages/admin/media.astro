---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import { serverClient } from '../../lib/supabase';
import { mediaUrl } from '../../lib/settings';

const supabase = serverClient(Astro);
const user = Astro.locals.user!;
let flash = '';

const MAX = 4 * 1024 * 1024;
const OK = ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml', 'image/gif'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');

  if (action === 'delete') {
    const id = String(form.get('id') || '');
    const path = String(form.get('path') || '');
    if (id && path) {
      await supabase.storage.from('media').remove([path]);
      await supabase.from('media').delete().eq('id', id);
      return Astro.redirect('/admin/media?ok=1', 303);
    }
  }

  if (action === 'upload') {
    const file = form.get('file');
    const alt = String(form.get('alt') || '').trim();
    if (!(file instanceof File) || file.size === 0) {
      flash = 'اختَر ملف صورة.';
    } else if (file.size > MAX) {
      flash = 'حجم الصورة أكبر من 4 ميجابايت.';
    } else if (!OK.includes(file.type)) {
      flash = 'الصيغة غير مدعومة (PNG / JPG / WEBP / SVG / GIF).';
    } else {
      const clean = file.name.toLowerCase().replace(/[^a-z0-9.]+/g, '-').replace(/-+/g, '-');
      const path = `${Date.now()}-${clean}`;
      const up = await supabase.storage.from('media').upload(path, file, { contentType: file.type });
      if (up.error) {
        flash = `تعذّر الرفع: ${up.error.message}`;
      } else {
        await supabase.from('media').insert({ path, alt, created_by: user.id });
        return Astro.redirect('/admin/media?ok=1', 303);
      }
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: items } = await supabase.from('media').select('*').order('created_at', { ascending: false });
---
<Base title="مكتبة الصور | لوحة الإدارة" path="/admin/media" active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="media">مكتبة الصور</AdminNav>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <form method="POST" enctype="multipart/form-data" class="form-box" style="max-width:560px;margin-bottom:36px;">
      <input type="hidden" name="_action" value="upload" />
      <div class="form-row">
        <label for="file">صورة (PNG / JPG / WEBP / SVG — حتى 4 ميجا)</label>
        <input type="file" id="file" name="file" accept="image/*" required />
      </div>
      <div class="form-row">
        <label for="alt">وصف الصورة (نص بديل)</label>
        <input type="text" id="alt" name="alt" />
      </div>
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;">رفع</button>
    </form>

    {(!items || items.length === 0) ? (
      <p style="color:var(--muted);">مفيش صور مرفوعة لسه.</p>
    ) : (
      <div class="media-grid">
        {items.map((m: any) => (
          <div class="media-cell">
            <img src={mediaUrl(m.path)} alt={m.alt || m.path} loading="lazy" />
            <div class="copy-field" style="padding:8px 8px 0;">
              <input type="text" readonly value={mediaUrl(m.path)} onclick="this.select()" />
            </div>
            <div class="media-info">
              <span>{m.alt || m.path}</span>
              <form method="POST" onsubmit="return confirm('حذف الصورة؟')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={m.id} />
                <input type="hidden" name="path" value={m.path} />
                <button type="submit">حذف</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
</main>
</Base>
