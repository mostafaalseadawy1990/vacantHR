---
import Admin from '../../layouts/Admin.astro';
import { serverClient } from '../../lib/supabase';
import { logAction } from '../../lib/audit';
import { mediaUrl } from '../../lib/settings';

const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');

  if (action === 'delete') {
    const id = String(form.get('id') || '');
    const path = String(form.get('path') || '');
    if (id && path) {
      await supabase.storage.from('media').remove([path]);
      await supabase.from('media').delete().eq('id', id);
      await logAction(Astro, supabase, 'حذف صورة', path);
      return Astro.redirect('/admin/media?ok=1', 303);
    }
  }
  if (action === 'delete_many') {
    const ids = form.getAll('ids').map(String).filter(Boolean);
    if (ids.length) {
      const { data: rows } = await supabase.from('media').select('id, path').in('id', ids);
      const paths = (rows ?? []).map((r: any) => r.path);
      if (paths.length) await supabase.storage.from('media').remove(paths);
      await supabase.from('media').delete().in('id', ids);
      await logAction(Astro, supabase, `حذف ${paths.length} صورة`);
      return Astro.redirect('/admin/media?ok=1', 303);
    }
  }
  if (action === 'alt') {
    const id = String(form.get('id') || '');
    const alt = String(form.get('alt') || '').trim().slice(0, 200);
    if (id) {
      await supabase.from('media').update({ alt }).eq('id', id);
      return Astro.redirect('/admin/media?ok=1', 303);
    }
  }
}
const url = new URL(Astro.request.url);
const ok = url.searchParams.get('ok') === '1';
const q = (url.searchParams.get('q') || '').trim();

let query = supabase.from('media').select('*').order('created_at', { ascending: false }).limit(500);
if (q) query = query.or(`alt.ilike.%${q}%,path.ilike.%${q}%`);
const { data: items } = await query;
const fmt = (s: string) => new Date(s).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', year: 'numeric' });
const niceName = (p: string) => p.replace(/^\d+-/, '');
---
<Admin title="مكتبة الصور | لوحة الإدارة" path="/admin/media" active="media">
<Fragment slot="heading">مكتبة الصور</Fragment>
<div class="admin-body">
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <div class="dropzone" id="dz" tabindex="0" role="button" aria-label="رفع صور">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M6 10l6-6 6 6M4 20h16" /></svg>
      <strong>اسحب الصور هنا أو اضغط للاختيار</strong>
      <span>PNG / JPG / WEBP / SVG / GIF — حتى 4 ميجا للصورة — تقدر ترفع أكتر من صورة مرة واحدة</span>
      <input type="file" id="dzInput" accept="image/*" multiple hidden />
    </div>
    <div class="up-list" id="upList"></div>

    <div class="media-bar">
      <form method="GET" class="media-search">
        <input type="search" name="q" value={q} placeholder="بحث بالاسم أو الوصف…" />
        <button class="btn" style="cursor:pointer;">بحث</button>
        {q && <a href="/admin/media" class="btn">مسح</a>}
      </form>
      <span style="color:var(--muted);font-size:.9rem;">{items?.length ?? 0} صورة</span>
    </div>

    {(!items || items.length === 0) ? (
      <p style="color:var(--muted);">{q ? 'مفيش نتائج.' : 'مفيش صور مرفوعة لسه — ابدأ بالسحب والإفلات فوق.'}</p>
    ) : (
      <form method="POST" id="bulkForm">
        <input type="hidden" name="_action" value="delete_many" />
        <div class="bulk-bar" id="bulkBar" hidden>
          <span id="bulkCount"></span>
          <button type="submit" class="btn" style="color:#9A3B1C;border-color:#F1B4A3;cursor:pointer;" onclick="return confirm('حذف الصور المختارة نهائيًا؟')">حذف المختار</button>
          <button type="button" class="btn" id="bulkClear">إلغاء التحديد</button>
        </div>
        <div class="mlib">
          {items.map((m: any) => (
            <div class="mcell" data-id={m.id} data-url={`https://vacanthr.com${mediaUrl(m.path)}`} data-alt={m.alt || ''} data-name={niceName(m.path)} data-date={fmt(m.created_at)} data-path={m.path}>
              <label class="mcheck"><input type="checkbox" name="ids" value={m.id} /></label>
              <button type="button" class="mthumb" title="فتح التفاصيل"><img src={mediaUrl(m.path)} alt={m.alt || ''} loading="lazy" /></button>
              <div class="mname" title={niceName(m.path)}>{m.alt || niceName(m.path)}</div>
              <div class="macts">
                <button type="button" class="mcopy" title="نسخ الرابط">نسخ الرابط</button>
              </div>
            </div>
          ))}
        </div>
      </form>
    )}
</div>

<!-- Detail drawer -->
<div class="mdrawer" id="mdrawer" hidden>
  <div class="mdrawer-bd" id="mdClose"></div>
  <aside class="mdrawer-panel" role="dialog" aria-modal="true" aria-label="تفاصيل الصورة">
    <button type="button" class="mdrawer-x" id="mdClose2" aria-label="إغلاق">✕</button>
    <img id="mdImg" alt="" />
    <dl class="mdl">
      <dt>الملف</dt><dd id="mdName" dir="ltr"></dd>
      <dt>تاريخ الرفع</dt><dd id="mdDate"></dd>
      <dt>الرابط</dt><dd><div class="copy-row"><input type="text" id="mdUrl" readonly dir="ltr" /><button type="button" class="btn" id="mdCopy">نسخ</button></div></dd>
    </dl>
    <form method="POST" class="mdalt">
      <input type="hidden" name="_action" value="alt" />
      <input type="hidden" name="id" id="mdAltId" />
      <label for="mdAlt">الوصف (نص بديل — مهم لجوجل)</label>
      <div class="copy-row"><input type="text" name="alt" id="mdAlt" maxlength="200" /><button class="btn solid" style="border:none;cursor:pointer;">حفظ</button></div>
    </form>
    <form method="POST" onsubmit="return confirm('حذف الصورة نهائيًا؟')" style="margin-top:14px;">
      <input type="hidden" name="_action" value="delete" />
      <input type="hidden" name="id" id="mdDelId" />
      <input type="hidden" name="path" id="mdDelPath" />
      <button class="btn" style="color:#9A3B1C;border-color:#F1B4A3;cursor:pointer;">حذف الصورة</button>
    </form>
  </aside>
</div>

<script is:inline src="/img-compress.js"></script>
<script is:inline>
  (function () {
    // ---- Upload: drag & drop / click, multiple files, per-file progress, reload when done.
    var dz = document.getElementById('dz'), input = document.getElementById('dzInput'), list = document.getElementById('upList');
    dz.addEventListener('click', function () { input.click(); });
    dz.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
    ['dragenter', 'dragover'].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.add('over'); }); });
    ['dragleave', 'drop'].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.remove('over'); }); });
    dz.addEventListener('drop', function (e) { handle(e.dataTransfer.files); });
    input.addEventListener('change', function () { handle(input.files); input.value = ''; });
    document.addEventListener('paste', function (e) {
      var items = (e.clipboardData || {}).items || [], files = [];
      for (var i = 0; i < items.length; i++) if (items[i].type.indexOf('image/') === 0) files.push(items[i].getAsFile());
      if (files.length) handle(files);
    });
    function handle(files) {
      var arr = Array.prototype.slice.call(files).filter(function (f) { return f.type.indexOf('image/') === 0; });
      if (!arr.length) return;
      var left = arr.length;
      arr.forEach(function (f0) {
        (window.vhCompressImage ? window.vhCompressImage(f0) : Promise.resolve(f0)).then(function (f) {
        var row = document.createElement('div'); row.className = 'up-row';
        row.innerHTML = '<span class="up-name"></span><span class="up-bar"><i></i></span><span class="up-st">جارٍ الرفع…</span>';
        row.querySelector('.up-name').textContent = f.name;
        list.appendChild(row);
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/admin/media/upload');
        xhr.upload.onprogress = function (e) { if (e.lengthComputable) row.querySelector('i').style.width = Math.round(e.loaded / e.total * 100) + '%'; };
        xhr.onload = function () {
          var j = {}; try { j = JSON.parse(xhr.responseText); } catch (e) {}
          row.querySelector('.up-st').textContent = j.url ? 'تم ✓' : ('فشل: ' + (j.error || xhr.status));
          row.classList.add(j.url ? 'ok' : 'err');
          if (--left === 0) setTimeout(function () { location.href = '/admin/media?ok=1'; }, 600);
        };
        xhr.onerror = function () { row.querySelector('.up-st').textContent = 'فشل الاتصال'; row.classList.add('err'); if (--left === 0) setTimeout(function () { location.reload(); }, 1200); };
        var fd = new FormData(); fd.append('file', f); xhr.send(fd);
        });
      });
    }

    // ---- Copy link
    function copy(text, btn) {
      var done = function () { var t = btn.textContent; btn.textContent = 'تم النسخ ✓'; setTimeout(function () { btn.textContent = t; }, 1200); };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done); else { var i = document.createElement('input'); i.value = text; document.body.appendChild(i); i.select(); document.execCommand('copy'); i.remove(); done(); }
    }
    document.querySelectorAll('.mcopy').forEach(function (b) { b.addEventListener('click', function () { copy(b.closest('.mcell').dataset.url, b); }); });

    // ---- Bulk select
    var form = document.getElementById('bulkForm'), bar = document.getElementById('bulkBar'), cnt = document.getElementById('bulkCount');
    if (form) {
      form.addEventListener('change', function () {
        var n = form.querySelectorAll('input[name="ids"]:checked').length;
        bar.hidden = n === 0; cnt.textContent = 'تم اختيار ' + n + ' صورة';
        form.querySelectorAll('.mcell').forEach(function (c) { c.classList.toggle('sel', c.querySelector('input').checked); });
      });
      document.getElementById('bulkClear').addEventListener('click', function () {
        form.querySelectorAll('input[name="ids"]').forEach(function (i) { i.checked = false; });
        form.dispatchEvent(new Event('change'));
      });
    }

    // ---- Detail drawer
    var dr = document.getElementById('mdrawer');
    function open(cell) {
      var d = cell.dataset;
      document.getElementById('mdImg').src = d.url; document.getElementById('mdName').textContent = d.name;
      document.getElementById('mdDate').textContent = d.date; document.getElementById('mdUrl').value = d.url;
      document.getElementById('mdAlt').value = d.alt; document.getElementById('mdAltId').value = d.id;
      document.getElementById('mdDelId').value = d.id; document.getElementById('mdDelPath').value = d.path;
      dr.hidden = false; document.body.style.overflow = 'hidden';
    }
    function close() { dr.hidden = true; document.body.style.overflow = ''; }
    document.querySelectorAll('.mthumb').forEach(function (b) { b.addEventListener('click', function () { open(b.closest('.mcell')); }); });
    document.getElementById('mdClose').addEventListener('click', close);
    document.getElementById('mdClose2').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    document.getElementById('mdCopy').addEventListener('click', function () { copy(document.getElementById('mdUrl').value, this); });
  })();
</script>

<style is:global>
  .dropzone{ display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center; padding:28px 16px; border:2px dashed var(--line); border-radius:var(--radius); background:var(--surface); cursor:pointer; transition:border-color .15s, background .15s; }
  .dropzone:hover, .dropzone.over, .dropzone:focus-visible{ border-color:var(--accent); background:var(--accent-soft); outline:none; }
  .dropzone svg{ width:34px; height:34px; fill:none; stroke:var(--accent); stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .dropzone span{ font-size:.85rem; color:var(--muted); }
  .up-list{ display:flex; flex-direction:column; gap:6px; margin:10px 0; }
  .up-row{ display:grid; grid-template-columns:minmax(0,1fr) 140px auto; gap:10px; align-items:center; font-size:.85rem; background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:8px 12px; }
  .up-name{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; direction:ltr; text-align:right; }
  .up-bar{ height:6px; background:var(--surface-soft); border-radius:999px; overflow:hidden; }
  .up-bar i{ display:block; height:100%; width:0; background:var(--accent); transition:width .2s; }
  .up-row.ok .up-st{ color:#276749; } .up-row.err .up-st{ color:#9A3B1C; }
  .media-bar{ display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin:22px 0 12px; }
  .media-search{ display:flex; gap:8px; align-items:center; flex:1; max-width:460px; }
  .media-search input{ margin:0; flex:1; }
  .bulk-bar{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; background:#FEF3C7; border:1px solid #FCD34D; border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:12px; font-size:.9rem; }
  .mlib{ display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; }
  .mcell{ position:relative; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-sm); overflow:hidden; display:flex; flex-direction:column; transition:border-color .15s, box-shadow .15s; }
  .mcell:hover{ border-color:var(--accent); box-shadow:var(--shadow-sm); }
  .mcell.sel{ border-color:var(--accent); box-shadow:0 0 0 2px var(--accent-soft); }
  .mcheck{ position:absolute; top:8px; right:8px; z-index:2; background:#fff; border-radius:6px; padding:3px 4px; line-height:0; box-shadow:var(--shadow-sm); }
  .mcheck input{ width:16px; height:16px; margin:0; }
  .mthumb{ padding:0; border:0; background:repeating-conic-gradient(#f1f5f9 0 25%, #fff 0 50%) 0 0/16px 16px; cursor:zoom-in; aspect-ratio:1; width:100%; }
  .mthumb img{ width:100%; height:100%; object-fit:contain; display:block; }
  .mname{ font-size:.8rem; padding:8px 10px 4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .macts{ display:flex; gap:6px; padding:0 8px 8px; }
  .macts button{ flex:1; font-size:.75rem; padding:5px 8px; border:1px solid var(--line); background:var(--surface-soft); border-radius:6px; cursor:pointer; font-family:inherit; }
  .macts button:hover{ border-color:var(--accent); color:var(--accent); }
  .mdrawer{ position:fixed; inset:0; z-index:80; }
  .mdrawer-bd{ position:absolute; inset:0; background:rgba(15,23,42,.55); }
  .mdrawer-panel{ position:absolute; top:0; bottom:0; inset-inline-start:0; width:min(440px,100%); background:var(--surface); box-shadow:var(--shadow-lg); padding:20px; overflow:auto; }
  .mdrawer-x{ position:absolute; top:12px; inset-inline-end:12px; border:0; background:var(--surface-soft); width:32px; height:32px; border-radius:50%; cursor:pointer; }
  .mdrawer-panel > img{ width:100%; max-height:300px; object-fit:contain; border-radius:8px; background:repeating-conic-gradient(#f1f5f9 0 25%, #fff 0 50%) 0 0/16px 16px; border:1px solid var(--line); margin:24px 0 14px; }
  .mdl{ display:grid; grid-template-columns:auto 1fr; gap:8px 12px; font-size:.9rem; margin:0 0 14px; }
  .mdl dt{ color:var(--muted); } .mdl dd{ margin:0; overflow-wrap:anywhere; }
  .copy-row{ display:flex; gap:6px; } .copy-row input{ margin:0; flex:1; min-width:0; font-size:.85rem; }
  .copy-row .btn{ padding:6px 12px; font-size:.82rem; white-space:nowrap; }
  .mdalt label{ display:block; font-size:.85rem; margin-bottom:6px; }
  @media (max-width:640px){ .mlib{ grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:8px; } .up-row{ grid-template-columns:minmax(0,1fr) auto; } .up-bar{ grid-column:1/-1; } }
</style>
</Admin>
