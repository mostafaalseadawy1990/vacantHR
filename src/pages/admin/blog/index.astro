---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { serverClient } from '../../../lib/supabase';

const supabase = serverClient(Astro);
const me = Astro.locals.user!;
let flash = '';

function slugify(s: string) {
  const base = s.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
  return base || `post-${Date.now().toString(36)}`;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = String(form.get('title') || '').trim();
  const slug = (String(form.get('slug') || '').trim() || slugify(title)).replace(/[^a-z0-9-]/g, '');
  if (!title) {
    flash = 'اكتب عنوان المقال.';
  } else {
    const { data, error } = await supabase.from('posts')
      .insert({ title, slug, author_id: me.id, status: 'draft', body_md: '', excerpt: '' })
      .select('id').single();
    if (error) flash = error.code === '23505' ? 'الـ slug مستخدم قبل كده.' : `تعذّر الإنشاء: ${error.message}`;
    else return Astro.redirect(`/admin/blog/${data.id}`, 303);
  }
}

const { data: posts } = await supabase
  .from('posts')
  .select('id, slug, title, status, published_at, created_at')
  .order('created_at', { ascending: false });
const fmt = (s: string | null) => s ? new Date(s).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
---
<Base title="المدوّنة | لوحة الإدارة" path="/admin/blog" active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="blog">المدوّنة</AdminNav>
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <form method="POST" class="form-box" style="max-width:560px;margin-bottom:30px;">
      <h3 style="margin-bottom:12px;">مقال جديد</h3>
      <div class="form-row"><label for="title">العنوان</label><input id="title" name="title" required /></div>
      <div class="form-row"><label for="slug">الـ slug (إنجليزي — اختياري)</label><input id="slug" name="slug" pattern="[a-z0-9-]*" /></div>
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إنشاء ومتابعة التحرير</button>
    </form>

    {(!posts || posts.length === 0) ? (
      <p style="color:var(--muted);">مفيش مقالات لسه.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>العنوان</th><th>الحالة</th><th>النشر</th><th></th></tr></thead>
          <tbody>
            {posts.map((p: any) => (
              <tr>
                <td><a href={`/admin/blog/${p.id}`}>{p.title}</a></td>
                <td><span class={`status-pill status-${p.status === 'published' ? 'shortlisted' : 'submitted'}`}>{p.status === 'published' ? 'منشور' : 'مسودة'}</span></td>
                <td>{fmt(p.published_at)}</td>
                <td>{p.status === 'published' && <a href={`/blog/${p.slug}`} target="_blank" rel="noopener">معاينة ↗</a>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</section>
</main>
</Base>
