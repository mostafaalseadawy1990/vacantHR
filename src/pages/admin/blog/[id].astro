---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { serverClient } from '../../../lib/supabase';
import { mediaUrl } from '../../../lib/settings';

const { id } = Astro.params;
const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save');

  if (action === 'delete') {
    await supabase.from('posts').delete().eq('id', id);
    return Astro.redirect('/admin/blog', 303);
  }

  const status = form.get('status') === 'published' ? 'published' : 'draft';
  const patch: Record<string, unknown> = {
    title: String(form.get('title') || '').trim(),
    slug: String(form.get('slug') || '').trim().replace(/[^a-z0-9-]/g, ''),
    excerpt: String(form.get('excerpt') || '').trim(),
    cover_path: String(form.get('cover_path') || '').trim() || null,
    body_md: String(form.get('body_md') || ''),
    tags: String(form.get('tags') || '').split(',').map((s) => s.trim()).filter(Boolean),
    status,
    updated_at: new Date().toISOString(),
  };
  // set published_at the first time it goes live
  const { data: cur } = await supabase.from('posts').select('published_at').eq('id', id).maybeSingle();
  if (status === 'published' && !cur?.published_at) patch.published_at = new Date().toISOString();

  if (!patch.title || !patch.slug) {
    flash = 'العنوان والـ slug مطلوبين.';
  } else {
    const { error } = await supabase.from('posts').update(patch).eq('id', id);
    if (error) flash = error.code === '23505' ? 'الـ slug مستخدم قبل كده.' : `تعذّر الحفظ: ${error.message}`;
    else return Astro.redirect(`/admin/blog/${id}?ok=1`, 303);
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: post } = await supabase.from('posts').select('*').eq('id', id).maybeSingle();
if (!post) return Astro.redirect('/admin/blog', 302);

// media picker options
const { data: media } = await supabase.from('media').select('path, alt').order('created_at', { ascending: false }).limit(100);
---
<Base title={`${post.title} | تحرير مقال`} path={`/admin/blog/${id}`} active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="blog">{post.title}</AdminNav>
    <p style="margin-bottom:16px;">
      <a href="/admin/blog">→ رجوع للمدوّنة</a>
      {post.status === 'published' && <> <span style="color:var(--line);margin:0 8px;">|</span> <a href={`/blog/${post.slug}`} target="_blank" rel="noopener">معاينة ↗</a></>}
    </p>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <form method="POST" class="form-box" style="max-width:820px;">
      <div class="form-grid-2">
        <div class="form-row"><label for="title">العنوان</label><input id="title" name="title" value={post.title} required /></div>
        <div class="form-row"><label for="slug">الـ slug</label><input id="slug" name="slug" value={post.slug} pattern="[a-z0-9-]*" required /></div>
      </div>
      <div class="form-row"><label for="excerpt">المقتطف (يظهر في القائمة وفي جوجل)</label><textarea id="excerpt" name="excerpt" style="min-height:60px;">{post.excerpt}</textarea></div>
      <div class="form-grid-2">
        <div class="form-row"><label for="tags">وسوم (مفصولة بفواصل)</label><input id="tags" name="tags" value={(post.tags ?? []).join(', ')} /></div>
        <div class="form-row">
          <label for="cover_path">صورة الغلاف</label>
          <select id="cover_path" name="cover_path">
            <option value="">— بدون —</option>
            {(media ?? []).map((m: any) => <option value={m.path} selected={post.cover_path === m.path}>{m.alt || m.path}</option>)}
          </select>
          <small style="color:var(--muted);">ارفع الصور من <a href="/admin/media">الوسائط</a></small>
        </div>
      </div>
      {post.cover_path && <img src={mediaUrl(post.cover_path)} alt="" style="max-width:280px;border-radius:8px;border:1px solid var(--line);margin-bottom:14px;" />}
      <div class="form-row">
        <label for="body_md">المحتوى (Markdown: ## عنوان، - نقطة، **غامق**، [نص](رابط)، ![وصف](رابط-صورة))</label>
        <textarea id="body_md" name="body_md" style="min-height:340px;font-family:ui-monospace,monospace;">{post.body_md}</textarea>
      </div>
      <div class="form-row">
        <label for="status">الحالة</label>
        <select id="status" name="status">
          <option value="draft" selected={post.status === 'draft'}>مسودة</option>
          <option value="published" selected={post.status === 'published'}>منشور</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;">
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
        <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;" onclick="return confirm('حذف المقال نهائيًا؟')">حذف</button>
      </div>
    </form>
  </div>
</section>
</main>
</Base>
