---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';
import { sanitizeHtml } from '../../../lib/html';
import RichEditor from '../../../components/RichEditor.astro';

const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');
  const id = String(form.get('id') || '');

  if (action === 'delete' && id) {
    await supabase.from('faqs').delete().eq('id', id);
    return Astro.redirect('/admin/content/faqs?ok=1', 303);
  }
  if (action === 'save') {
    const row = {
      question: String(form.get('question') || '').trim(),
      answer: sanitizeHtml(String(form.get('answer') || '')),
      position: parseInt(String(form.get('position') || '0'), 10) || 0,
      published: form.get('published') === 'on',
    };
    if (!row.question || !row.answer) {
      flash = 'السؤال والإجابة مطلوبين.';
    } else {
      const res = id
        ? await supabase.from('faqs').update(row).eq('id', id)
        : await supabase.from('faqs').insert(row);
      if (!res.error) return Astro.redirect('/admin/content/faqs?ok=1', 303);
      flash = `تعذّر الحفظ: ${res.error.message}`;
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: items } = await supabase.from('faqs').select('*').order('position');
---
<Admin title="الأسئلة الشائعة | لوحة الإدارة" path="/admin/content/faqs" active="content">
<Fragment slot="heading">الأسئلة الشائعة</Fragment>
<div class="admin-body">
    <p style="margin-bottom:20px;"><a href="/admin/content">→ رجوع للمحتوى</a></p>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <div style="display:grid;gap:16px;max-width:720px;">
      {(items ?? []).map((f: any) => (
        <form method="POST" class="form-box" style="max-width:none;">
          <input type="hidden" name="_action" value="save" />
          <input type="hidden" name="id" value={f.id} />
          <div class="form-row"><label>السؤال</label><input name="question" value={f.question} required /></div>
          <div class="form-row"><label>الإجابة</label><RichEditor name="answer" value={f.answer} minHeight={120} /></div>
          <div class="form-grid-2">
            <div class="form-row"><label>الترتيب</label><input type="number" name="position" value={f.position} /></div>
            <div class="form-row" style="display:flex;align-items:end;">
              <label style="display:flex;gap:8px;align-items:center;font-weight:400;"><input type="checkbox" name="published" checked={f.published} /> ظاهر</label>
            </div>
          </div>
          <div style="display:flex;gap:10px;">
            <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
            <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;">حذف</button>
          </div>
        </form>
      ))}

      <form method="POST" class="form-box" style="max-width:none;border-style:dashed;">
        <input type="hidden" name="_action" value="save" />
        <h3 style="margin-bottom:14px;">إضافة سؤال جديد</h3>
        <div class="form-row"><label>السؤال</label><input name="question" required /></div>
        <div class="form-row"><label>الإجابة</label><RichEditor name="answer" minHeight={120} /></div>
        <div class="form-grid-2">
          <div class="form-row"><label>الترتيب</label><input type="number" name="position" value="99" /></div>
          <div class="form-row" style="display:flex;align-items:end;">
            <label style="display:flex;gap:8px;align-items:center;font-weight:400;"><input type="checkbox" name="published" checked /> ظاهر</label>
          </div>
        </div>
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إضافة</button>
      </form>
    </div>
</div>
</Admin>
