---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';

const cards = [
  { href: '/admin/content/settings', title: 'إعدادات الموقع', desc: 'بيانات التواصل، واتساب، لينكدإن، نصوص الرئيسية، أرقام الإحصائيات' },
  { href: '/admin/content/testimonials', title: 'آراء العملاء', desc: 'إضافة وتعديل وترتيب شهادات العملاء على الصفحة الرئيسية' },
  { href: '/admin/content/faqs', title: 'الأسئلة الشائعة', desc: 'إدارة قسم الأسئلة والأجوبة' },
  { href: '/admin/content/pricing', title: 'باقات الأسعار', desc: 'باقات برنامج HRM ومميزات كل باقة' },
  { href: '/admin/content/guide', title: 'دليل استخدام HRM', desc: 'أقسام دليل /hrm-guide: شروحات مكتوبة وفيديوهات YouTube' },
  { href: '/admin/media', title: 'مكتبة الصور', desc: 'رفع الصور والحصول على روابطها لاستخدامها في المحتوى' },
];
---
<Base title="المحتوى | لوحة الإدارة" path="/admin/content" active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="content">إدارة المحتوى</AdminNav>
    <div class="stat-cards" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));">
      {cards.map((c) => (
        <a href={c.href} class="stat-card" style="gap:8px;">
          <span style="font-size:1.05rem;font-weight:700;color:var(--ink);">{c.title}</span>
          <span class="l" style="line-height:1.6;">{c.desc}</span>
        </a>
      ))}
    </div>
  </div>
</section>
</main>
</Base>
