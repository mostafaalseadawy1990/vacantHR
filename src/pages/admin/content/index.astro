---
import Admin from '../../../layouts/Admin.astro';
import ContentNav from '../../../components/ContentNav.astro';
import { serverClient } from '../../../lib/supabase';

const sb = serverClient(Astro);
const cnt = async (t: string, filter?: (q: any) => any) => {
  let q = sb.from(t).select('id', { count: 'exact', head: true });
  if (filter) q = filter(q);
  const { count } = await q; return count ?? 0;
};
const [testimonials, faqs, pricing, guide, jd, posts, pages, media] = await Promise.all([
  cnt('testimonials'), cnt('faqs'), cnt('pricing_plans'), cnt('guide_sections'), cnt('jd_templates'),
  cnt('posts', (q) => q.eq('status', 'published')), cnt('pages', (q) => q.eq('status', 'published')), cnt('media'),
]);

const groups = [
  { label: 'الصفحة الرئيسية والموقع', cards: [
    { href: '/admin/content/settings', title: 'الإعدادات', desc: 'الشعار، الأيقونة، بيانات التواصل، نصوص الرئيسية، SEO والبكسل', count: null },
    { href: '/admin/content/site', title: 'صفحات الموقع', desc: 'التوظيف، برنامج HRM، الاستشارات، من نحن — نصوص وصور كل قسم بالمحرّر', count: null },
    { href: '/admin/content/testimonials', title: 'آراء العملاء', desc: 'الشهادات اللي بتظهر على الرئيسية', count: testimonials },
    { href: '/admin/content/faqs', title: 'الأسئلة الشائعة', desc: 'قسم الأسئلة والأجوبة على الرئيسية', count: faqs },
  ] },
  { label: 'برنامج HRM', cards: [
    { href: '/admin/content/pricing', title: 'باقات الأسعار', desc: 'الباقات والمميزات على صفحة برنامج HRM', count: pricing },
    { href: '/admin/content/guide', title: 'دليل الاستخدام', desc: 'أقسام /hrm-guide بشروحات وفيديوهات', count: guide },
    { href: '/admin/content/jd', title: 'نماذج الوصف الوظيفي', desc: 'النماذج اللي بتتنزّل Word من /jd-templates', count: jd },
  ] },
  { label: 'المدوّنة والصفحات', cards: [
    { href: '/admin/blog', title: 'المقالات', desc: 'كتابة ونشر المقالات', count: posts },
    { href: '/admin/content/blog-layout', title: 'شكل المدوّنة', desc: 'التنظيم، الأعمدة، البطاقات، الشريط الجانبي', count: null },
    { href: '/admin/pages', title: 'الصفحات', desc: 'صفحات حرّة على /<slug>', count: pages },
    { href: '/admin/media', title: 'مكتبة الصور', desc: 'رفع الصور وإدارتها', count: media },
  ] },
];
---
<Admin title="المحتوى | لوحة الإدارة" path="/admin/content" active="content">
<Fragment slot="heading">إدارة المحتوى</Fragment>
<div class="admin-body">
    <ContentNav active="index" preview="/" />
    {groups.map((g) => (
      <section style="margin-bottom:26px;">
        <h2 style="font-size:1rem;color:var(--muted);margin:0 0 10px;">{g.label}</h2>
        <div class="ccards">
          {g.cards.map((c) => (
            <a href={c.href} class="ccard">
              <span class="ccard-head"><strong>{c.title}</strong>{c.count !== null && <b>{c.count}</b>}</span>
              <span class="ccard-desc">{c.desc}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
</div>
<style is:global>
  .ccards{ display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:12px; }
  .ccard{ display:flex; flex-direction:column; gap:6px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; color:inherit; transition:border-color .15s, box-shadow .15s; }
  .ccard:hover{ border-color:var(--accent); box-shadow:var(--shadow-sm); }
  .ccard-head{ display:flex; justify-content:space-between; align-items:center; gap:8px; }
  .ccard-head strong{ font-size:1rem; }
  .ccard-head b{ font-size:.78rem; background:var(--accent-soft); color:var(--accent-strong); padding:2px 9px; border-radius:999px; }
  .ccard-desc{ font-size:.85rem; color:var(--muted); line-height:1.5; }
</style>
</Admin>
