---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';
import { handleListAction } from '../../../lib/content';
import ContentNav from '../../../components/ContentNav.astro';
import CItem from '../../../components/CItem.astro';

const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');
  const id = String(form.get('id') || '');

  if (await handleListAction(supabase, 'testimonials', form)) return Astro.redirect('/admin/content/testimonials?ok=1', 303);
  if (action === 'save') {
    const row = {
      name: String(form.get('name') || '').trim(),
      title: String(form.get('title') || '').trim() || null,
      quote: String(form.get('quote') || '').trim(),
      position: parseInt(String(form.get('position') || '0'), 10) || 0,
      published: form.get('published') === 'on',
    };
    if (!row.name || !row.quote) {
      flash = 'الاسم والاقتباس مطلوبين.';
    } else {
      const res = id
        ? await supabase.from('testimonials').update(row).eq('id', id)
        : await supabase.from('testimonials').insert(row);
      if (!res.error) return Astro.redirect('/admin/content/testimonials?ok=1', 303);
      flash = `تعذّر الحفظ: ${res.error.message}`;
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: items } = await supabase.from('testimonials').select('*').order('position');
---
<Admin title="آراء العملاء | لوحة الإدارة" path="/admin/content/testimonials" active="content">
<Fragment slot="heading">آراء العملاء</Fragment>
<div class="admin-body">
    <ContentNav active="testimonials" preview="/#testimonials" />
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <details class="cadd">
      <summary>+ إضافة رأي جديد</summary>
      <form method="POST" class="citem-body">
        <input type="hidden" name="_action" value="save" />
        <div class="form-grid-2">
          <div class="form-row"><label>الاسم *</label><input name="name" required /></div>
          <div class="form-row"><label>الصفة / الشركة</label><input name="title" placeholder="مدير الموارد البشرية — شركة X" /></div>
        </div>
        <div class="form-row"><label>الاقتباس *</label><textarea name="quote" style="min-height:80px;" required></textarea></div>
        <input type="hidden" name="position" value="999" /><input type="hidden" name="published" value="on" />
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إضافة</button>
      </form>
    </details>

    {(!items || items.length === 0) ? <p class="cempty">مفيش آراء لسه — ضيف أول رأي من الزرار فوق.</p> : (
      <div class="citems">
        {items.map((t: any, i: number) => (
          <CItem id={t.id} title={t.name} subtitle={t.title ?? t.quote} published={t.published} index={i} total={items.length}>
            <form method="POST">
              <input type="hidden" name="_action" value="save" />
              <input type="hidden" name="id" value={t.id} />
              <input type="hidden" name="position" value={t.position} />
              <input type="hidden" name="published" value={t.published ? 'on' : ''} />
              <div class="form-grid-2">
                <div class="form-row"><label>الاسم *</label><input name="name" value={t.name} required /></div>
                <div class="form-row"><label>الصفة / الشركة</label><input name="title" value={t.title ?? ''} /></div>
              </div>
              <div class="form-row"><label>الاقتباس *</label><textarea name="quote" style="min-height:80px;" required>{t.quote}</textarea></div>
              <div class="citem-actions">
                <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
                <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;" onclick="return confirm('حذف الرأي؟')">حذف</button>
              </div>
            </form>
          </CItem>
        ))}
      </div>
    )}
</div>
</Admin>
