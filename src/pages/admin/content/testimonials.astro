---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { serverClient } from '../../../lib/supabase';

const supabase = serverClient(Astro);
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');
  const id = String(form.get('id') || '');

  if (action === 'delete' && id) {
    await supabase.from('testimonials').delete().eq('id', id);
    return Astro.redirect('/admin/content/testimonials?ok=1', 303);
  }
  if (action === 'save') {
    const row = {
      name: String(form.get('name') || '').trim(),
      title: String(form.get('title') || '').trim() || null,
      quote: String(form.get('quote') || '').trim(),
      position: parseInt(String(form.get('position') || '0'), 10) || 0,
      published: form.get('published') === 'on',
    };
    if (!row.name || !row.quote) {
      flash = 'الاسم والاقتباس مطلوبين.';
    } else {
      const res = id
        ? await supabase.from('testimonials').update(row).eq('id', id)
        : await supabase.from('testimonials').insert(row);
      if (!res.error) return Astro.redirect('/admin/content/testimonials?ok=1', 303);
      flash = `تعذّر الحفظ: ${res.error.message}`;
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: items } = await supabase.from('testimonials').select('*').order('position');
---
<Base title="آراء العملاء | لوحة الإدارة" path="/admin/content/testimonials" active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="content">آراء العملاء</AdminNav>
    <p style="margin-bottom:20px;"><a href="/admin/content">→ رجوع للمحتوى</a></p>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <div style="display:grid;gap:16px;max-width:720px;">
      {(items ?? []).map((t: any) => (
        <form method="POST" class="form-box" style="max-width:none;">
          <input type="hidden" name="_action" value="save" />
          <input type="hidden" name="id" value={t.id} />
          <div class="form-grid-2">
            <div class="form-row"><label>الاسم</label><input name="name" value={t.name} required /></div>
            <div class="form-row"><label>الصفة / الشركة</label><input name="title" value={t.title ?? ''} /></div>
          </div>
          <div class="form-row"><label>الاقتباس</label><textarea name="quote" style="min-height:80px;" required>{t.quote}</textarea></div>
          <div class="form-grid-2">
            <div class="form-row"><label>الترتيب</label><input type="number" name="position" value={t.position} /></div>
            <div class="form-row" style="display:flex;align-items:end;">
              <label style="display:flex;gap:8px;align-items:center;font-weight:400;"><input type="checkbox" name="published" checked={t.published} /> ظاهر</label>
            </div>
          </div>
          <div style="display:flex;gap:10px;">
            <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
            <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;">حذف</button>
          </div>
        </form>
      ))}

      <form method="POST" class="form-box" style="max-width:none;border-style:dashed;">
        <input type="hidden" name="_action" value="save" />
        <h3 style="margin-bottom:14px;">إضافة رأي جديد</h3>
        <div class="form-grid-2">
          <div class="form-row"><label>الاسم</label><input name="name" required /></div>
          <div class="form-row"><label>الصفة / الشركة</label><input name="title" /></div>
        </div>
        <div class="form-row"><label>الاقتباس</label><textarea name="quote" style="min-height:80px;" required></textarea></div>
        <div class="form-grid-2">
          <div class="form-row"><label>الترتيب</label><input type="number" name="position" value="99" /></div>
          <div class="form-row" style="display:flex;align-items:end;">
            <label style="display:flex;gap:8px;align-items:center;font-weight:400;"><input type="checkbox" name="published" checked /> ظاهر</label>
          </div>
        </div>
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إضافة</button>
      </form>
    </div>
  </div>
</section>
</main>
</Base>
