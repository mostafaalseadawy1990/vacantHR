---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';
import { handleListAction } from '../../../lib/content';
import ContentNav from '../../../components/ContentNav.astro';
import CItem from '../../../components/CItem.astro';
import { logAction } from '../../../lib/audit';
import { ytEmbed } from '../../../lib/settings';
import { sanitizeHtml } from '../../../lib/html';
import { renderMarkdown } from '../../../lib/jobs';
import RichEditor from '../../../components/RichEditor.astro';

const supabase = serverClient(Astro);
let flash = '';

function slugify(s: string) {
  const base = s.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
  return base || `section-${Date.now().toString(36)}`;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || 'save');
  const id = String(form.get('id') || '');

  if (await handleListAction(supabase, 'guide_sections', form)) return Astro.redirect('/admin/content/guide?ok=1', 303);
  if (action === 'save') {
    const title = String(form.get('title') || '').trim();
    const row = {
      title,
      slug: (String(form.get('slug') || '').trim() || slugify(title)).replace(/[^a-z0-9-]/g, ''),
      body_html: sanitizeHtml(String(form.get('body_html') || '')),
      video_url: String(form.get('video_url') || '').trim() || null,
      position: parseInt(String(form.get('position') || '0'), 10) || 0,
      published: form.get('published') === 'on',
      updated_at: new Date().toISOString(),
    };
    if (!title) {
      flash = 'اكتب عنوان القسم.';
    } else {
      const res = id
        ? await supabase.from('guide_sections').update(row).eq('id', id)
        : await supabase.from('guide_sections').insert(row);
      if (!res.error) { await logAction(Astro, supabase, id ? 'تعديل قسم في دليل HRM' : 'إضافة قسم في دليل HRM', title); return Astro.redirect('/admin/content/guide?ok=1', 303); }
      flash = res.error.code === '23505' ? 'الـ slug مستخدم قبل كده.' : `تعذّر الحفظ: ${res.error.message}`;
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: items } = await supabase.from('guide_sections').select('*').order('position');
---
<Admin title="دليل HRM | لوحة الإدارة" path="/admin/content/guide" active="content">
<Fragment slot="heading">دليل استخدام HRM</Fragment>
<div class="admin-body">
    <ContentNav active="guide" preview="/hrm-guide" />
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <details class="cadd">
      <summary>+ إضافة قسم</summary>
      <form method="POST" class="citem-body">
        <input type="hidden" name="_action" value="save" />
        <div class="form-grid-2">
          <div class="form-row"><label>عنوان القسم *</label><input name="title" required placeholder="إضافة الموظفين" /></div>
          <div class="form-row"><label>رابط فيديو YouTube (اختياري)</label><input name="video_url" placeholder="https://youtu.be/..." dir="ltr" /></div>
        </div>
        <div class="form-row"><label>المحتوى</label><RichEditor name="body_html" minHeight={180} /></div>
        <input type="hidden" name="position" value="999" /><input type="hidden" name="published" value="on" />
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إضافة</button>
      </form>
    </details>

    {(!items || items.length === 0) ? <p class="cempty">مفيش أقسام في الدليل لسه.</p> : (
      <div class="citems">
        {items.map((it: any, i: number) => (
          <CItem id={it.id} title={it.title} subtitle={`/hrm-guide#${it.slug}${it.video_url ? ' · فيه فيديو' : ''}`} published={it.published} index={i} total={items.length}>
            <form method="POST">
              <input type="hidden" name="_action" value="save" />
              <input type="hidden" name="id" value={it.id} />
              <input type="hidden" name="position" value={it.position} />
              <input type="hidden" name="published" value={it.published ? 'on' : ''} />
              <div class="form-grid-2">
                <div class="form-row"><label>عنوان القسم *</label><input name="title" value={it.title} required /></div>
                <div class="form-row"><label>الـ slug (للرابط)</label><input name="slug" value={it.slug} pattern="[a-z0-9-]*" dir="ltr" /></div>
              </div>
              <div class="form-row">
                <label>رابط فيديو YouTube (اختياري)</label>
                <input name="video_url" value={it.video_url ?? ''} placeholder="https://www.youtube.com/watch?v=..." dir="ltr" />
                {it.video_url && !ytEmbed(it.video_url) && <small style="color:#9A3B1C;">الرابط ده مش رابط يوتيوب صحيح.</small>}
              </div>
              <div class="form-row"><label>المحتوى</label><RichEditor name="body_html" value={it.body_html || renderMarkdown(it.body_md || '')} minHeight={220} /></div>
              <div class="citem-actions">
                <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
                <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;" onclick="return confirm('حذف القسم؟')">حذف</button>
              </div>
            </form>
          </CItem>
        ))}
      </div>
    )}
</div>

</Admin>
