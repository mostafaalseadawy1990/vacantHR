---
import Admin from '../../../layouts/Admin.astro';
import ContentNav from '../../../components/ContentNav.astro';
import CItem from '../../../components/CItem.astro';
import RichEditor from '../../../components/RichEditor.astro';
import { serverClient } from '../../../lib/supabase';
import { logAction } from '../../../lib/audit';
import { sanitizeHtml } from '../../../lib/html';
import { handleListAction } from '../../../lib/content';
import { DEFAULT_JD } from '../../../lib/jd';

const supabase = serverClient(Astro);
let flash = '';
const slugify = (s: string) => { const b = s.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-'); return b || `jd-${Date.now().toString(36)}`; };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (await handleListAction(supabase, 'jd_templates', form)) return Astro.redirect('/admin/content/jd?ok=1', 303);
  const action = String(form.get('_action') || '');
  const id = String(form.get('id') || '');
  if (action === 'seed') {
    const rows = DEFAULT_JD.map(({ id: _i, ...t }) => t);
    const { error } = await supabase.from('jd_templates').upsert(rows, { onConflict: 'slug', ignoreDuplicates: true });
    if (error) flash = `تعذّر الاستيراد: ${error.message}`;
    else { await logAction(Astro, supabase, 'استيراد نماذج الوصف الوظيفي الافتراضية'); return Astro.redirect('/admin/content/jd?ok=1', 303); }
  }
  if (action === 'save') {
    const g = (k: string) => String(form.get(k) ?? '').trim();
    const row: Record<string, unknown> = {
      title: g('title'), slug: (g('slug') || slugify(g('title'))).replace(/[^a-z0-9-]/g, ''), sector: g('sector') || null,
      summary: g('summary'), body_html: sanitizeHtml(g('body_html')), updated_at: new Date().toISOString(),
    };
    if (!id) { row.position = 999; row.published = form.get('published') !== ''; }
    if (!row.title) flash = 'اكتب اسم النموذج.';
    else {
      const res = id ? await supabase.from('jd_templates').update(row).eq('id', id) : await supabase.from('jd_templates').insert(row);
      if (res.error) flash = res.error.code === '23505' ? 'الـ slug مستخدم قبل كده.' : `تعذّر الحفظ: ${res.error.message}`;
      else { await logAction(Astro, supabase, id ? 'تعديل نموذج وصف وظيفي' : 'إضافة نموذج وصف وظيفي', String(row.title)); return Astro.redirect('/admin/content/jd?ok=1', 303); }
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';
const { data: items, error } = await supabase.from('jd_templates').select('*').order('position');
const sectors = [...new Set([...(items ?? []).map((t: any) => t.sector), ...DEFAULT_JD.map((t) => t.sector)].filter(Boolean))];
---
<Admin title="نماذج الوصف الوظيفي | لوحة الإدارة" path="/admin/content/jd" active="content">
<Fragment slot="heading">نماذج الوصف الوظيفي</Fragment>
<div class="admin-body">
  <ContentNav active="jd" preview="/jd-templates" />
  {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
  {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}
  {error && <p class="notice notice-error" style="margin-bottom:18px;">تعذّر تحميل النماذج — تأكد من تشغيل migration-18 في Supabase.</p>}

  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px;">
    <details class="cadd" style="margin:0;">
      <summary>+ نموذج جديد</summary>
      <form method="POST" class="citem-body">
        <input type="hidden" name="_action" value="save" />
        <div class="form-grid-2">
          <div class="form-row"><label>اسم النموذج *</label><input name="title" required placeholder="مدير مشروعات" /></div>
          <div class="form-row"><label>القطاع</label><input name="sector" list="sectors-dl" placeholder="تقنية المعلومات" /></div>
          <div class="form-row"><label>الـ slug (إنجليزي — اختياري)</label><input name="slug" pattern="[a-z0-9-]*" dir="ltr" placeholder="jd-project-manager" /></div>
          <div class="form-row"><label>وصف قصير (يظهر في البطاقة)</label><input name="summary" /></div>
        </div>
        <div class="form-row"><label>محتوى النموذج (اللي هيتنزّل في ملف Word)</label><RichEditor name="body_html" minHeight={320} /></div>
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إضافة</button>
      </form>
    </details>
    {(items ?? []).length < DEFAULT_JD.length && (
      <form method="POST"><input type="hidden" name="_action" value="seed" /><button class="btn" style="cursor:pointer;">استيراد النماذج الافتراضية ({DEFAULT_JD.length})</button></form>
    )}
  </div>
  <datalist id="sectors-dl">{sectors.map((s) => <option value={s} />)}</datalist>

  {(!items || items.length === 0) ? <p class="cempty">مفيش نماذج في قاعدة البيانات — الموقع بيعرض النماذج المدمجة. استوردها عشان تقدر تعدّلها.</p> : (
    <div class="citems">
      {items.map((t: any, i: number) => (
        <CItem id={t.id} title={t.title} subtitle={`${t.sector ?? '—'} · /jd-templates/${t.slug} · ${t.downloads} تحميل`} published={t.published} index={i} total={items.length}>
          <form method="POST">
            <input type="hidden" name="_action" value="save" /><input type="hidden" name="id" value={t.id} />
            <div class="form-grid-2">
              <div class="form-row"><label>اسم النموذج *</label><input name="title" value={t.title} required /></div>
              <div class="form-row"><label>القطاع</label><input name="sector" value={t.sector ?? ''} list="sectors-dl" /></div>
              <div class="form-row"><label>الـ slug</label><input name="slug" value={t.slug} pattern="[a-z0-9-]*" dir="ltr" /></div>
              <div class="form-row"><label>وصف قصير</label><input name="summary" value={t.summary ?? ''} /></div>
            </div>
            <div class="form-row"><label>محتوى النموذج</label><RichEditor name="body_html" value={t.body_html} minHeight={320} /></div>
            <div class="citem-actions">
              <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ</button>
              <a href={`/jd-templates/${t.slug}.docx`} class="btn">⬇ تجربة ملف Word</a>
              <button type="submit" name="_action" value="delete" class="btn" style="cursor:pointer;color:#9A3B1C;border-color:#F1B4A3;" onclick="return confirm('حذف النموذج؟')">حذف</button>
            </div>
          </form>
        </CItem>
      ))}
    </div>
  )}
</div>
</Admin>
