---
import Base from '../../../layouts/Base.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { serverClient } from '../../../lib/supabase';
import type { Job } from '../../../lib/jobs';

const { slug } = Astro.params;
const supabase = serverClient(Astro);

let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');

  if (action === 'save_job') {
    const get = (k: string) => String(form.get(k) || '').trim();
    const status = ['draft', 'open', 'closed'].includes(get('status')) ? get('status') : 'draft';
    const patch: Record<string, unknown> = {
      title: get('title'),
      department: get('department') || null,
      location: get('location') || 'القاهرة، مصر',
      employment_type: get('employment_type'),
      workplace: get('workplace'),
      experience_level: get('experience_level') || null,
      salary_min: get('salary_min') ? parseInt(get('salary_min'), 10) : null,
      salary_max: get('salary_max') ? parseInt(get('salary_max'), 10) : null,
      salary_visible: form.get('salary_visible') === 'on',
      description_md: get('description_md'),
      requirements_md: get('requirements_md') || '',
      status,
      updated_at: new Date().toISOString(),
    };
    if (status === 'open') patch.published_at = new Date().toISOString();
    const { error } = await supabase.from('jobs').update(patch).eq('slug', slug);
    if (!error) return Astro.redirect(`/admin/jobs/${slug}?ok=1`, 303);
    flash = `تعذّر الحفظ: ${error.message}`;
  }

  if (action === 'set_app_status') {
    const appId = String(form.get('app_id') || '');
    const st = String(form.get('status') || '');
    if (appId && ['submitted', 'reviewing', 'shortlisted', 'rejected', 'hired'].includes(st)) {
      const { error } = await supabase.from('applications').update({ status: st }).eq('id', appId);
      if (!error) return Astro.redirect(`/admin/jobs/${slug}?ok=1#applicants`, 303);
      flash = 'تعذّر تحديث حالة المتقدم.';
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: job } = await supabase.from('jobs').select('*').eq('slug', slug).maybeSingle<Job>();
if (!job) return Astro.redirect('/admin/jobs', 302);

const { data: apps } = await supabase
  .from('applications')
  .select('id, status, created_at, cover_note, cv_path, profiles(full_name, phone)')
  .eq('job_id', job.id)
  .order('created_at', { ascending: false });

const APP_STATUS: Array<[string, string]> = [
  ['submitted', 'تحت المراجعة'], ['reviewing', 'قيد الفحص'], ['shortlisted', 'قائمة مختصرة'],
  ['rejected', 'مرفوض'], ['hired', 'تم التعيين'],
];
const sel = (cur: string, val: string) => (cur === val ? true : undefined);
const fmt = (s: string) => new Date(s).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${job.title} | إدارة | Vacant HR`} path={`/admin/jobs/${slug}`} active="admin" noindex={true}>
<main id="main">
<section style="padding:40px 0 70px;">
  <div class="wrap">
    <AdminNav active="jobs">{job.title}</AdminNav>

    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}
    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <p style="margin-bottom:24px;">
      <a href={`/careers/${job.slug}`} target="_blank" rel="noopener">معاينة الإعلان ↗</a>
      <span style="color:var(--line);margin:0 10px;">|</span>
      <a href="/admin/jobs">رجوع للقائمة</a>
    </p>

    <form method="POST" class="form-box" style="max-width:720px;margin-bottom:50px;">
      <input type="hidden" name="_action" value="save_job" />
      <div class="form-grid-2">
        <div class="form-row"><label for="title">المسمى الوظيفي *</label><input id="title" name="title" value={job.title} required /></div>
        <div class="form-row"><label>الـ slug</label><input value={job.slug} disabled /></div>
        <div class="form-row"><label for="department">القسم</label><input id="department" name="department" value={job.department ?? ''} /></div>
        <div class="form-row"><label for="location">المكان</label><input id="location" name="location" value={job.location ?? ''} /></div>
        <div class="form-row">
          <label for="employment_type">نوع التعاقد</label>
          <select id="employment_type" name="employment_type">
            <option value="full_time" selected={sel(job.employment_type, 'full_time')}>دوام كامل</option>
            <option value="part_time" selected={sel(job.employment_type, 'part_time')}>دوام جزئي</option>
            <option value="contract" selected={sel(job.employment_type, 'contract')}>عقد مؤقت</option>
            <option value="temporary" selected={sel(job.employment_type, 'temporary')}>مشروعي</option>
          </select>
        </div>
        <div class="form-row">
          <label for="workplace">مكان العمل</label>
          <select id="workplace" name="workplace">
            <option value="onsite" selected={sel(job.workplace, 'onsite')}>من المقر</option>
            <option value="hybrid" selected={sel(job.workplace, 'hybrid')}>هجين</option>
            <option value="remote" selected={sel(job.workplace, 'remote')}>عن بُعد</option>
          </select>
        </div>
        <div class="form-row"><label for="experience_level">مستوى الخبرة</label><input id="experience_level" name="experience_level" value={job.experience_level ?? ''} /></div>
        <div class="form-row">
          <label for="status">الحالة</label>
          <select id="status" name="status">
            <option value="draft" selected={sel(job.status, 'draft')}>مسودة</option>
            <option value="open" selected={sel(job.status, 'open')}>مفتوحة</option>
            <option value="closed" selected={sel(job.status, 'closed')}>مغلقة</option>
          </select>
        </div>
        <div class="form-row"><label for="salary_min">الحد الأدنى للراتب</label><input type="number" id="salary_min" name="salary_min" value={job.salary_min ?? ''} /></div>
        <div class="form-row"><label for="salary_max">الحد الأقصى للراتب</label><input type="number" id="salary_max" name="salary_max" value={job.salary_max ?? ''} /></div>
      </div>
      <div class="form-row" style="margin-top:4px;">
        <label style="display:flex;gap:10px;align-items:center;font-weight:400;">
          <input type="checkbox" name="salary_visible" style="width:auto;" checked={job.salary_visible} /> إظهار الراتب في الإعلان
        </label>
      </div>
      <div class="form-row"><label for="description_md">الوصف (Markdown) *</label><textarea id="description_md" name="description_md" style="min-height:180px;" required>{job.description_md}</textarea></div>
      <div class="form-row"><label for="requirements_md">المتطلبات (Markdown)</label><textarea id="requirements_md" name="requirements_md" style="min-height:140px;">{job.requirements_md}</textarea></div>
      <button type="submit" class="btn solid" style="border:none;cursor:pointer;">حفظ التعديلات</button>
    </form>

    <h2 id="applicants" style="margin-bottom:16px;">المتقدمون ({apps?.length ?? 0})</h2>
    {(!apps || apps.length === 0) ? (
      <p style="color:var(--teal-2);">مفيش متقدمين لسه.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>المرشح</th><th>الهاتف</th><th>نبذة</th><th>CV</th><th>التاريخ</th><th>الحالة</th></tr></thead>
          <tbody>
            {apps.map((a: any) => (
              <tr>
                <td>{a.profiles?.full_name ?? '—'}</td>
                <td dir="ltr" style="text-align:right;">{a.profiles?.phone ?? '—'}</td>
                <td style="max-width:280px;">{a.cover_note ? <span title={a.cover_note}>{a.cover_note.slice(0, 90)}{a.cover_note.length > 90 ? '…' : ''}</span> : '—'}</td>
                <td>{a.cv_path ? <a href={`/admin/cv/${a.id}`} target="_blank" rel="noopener">فتح ↗</a> : '—'}</td>
                <td>{fmt(a.created_at)}</td>
                <td>
                  <form method="POST" style="display:flex;gap:6px;">
                    <input type="hidden" name="_action" value="set_app_status" />
                    <input type="hidden" name="app_id" value={a.id} />
                    <select name="status" class="mini-select">
                      {APP_STATUS.map(([val, label]) => (
                        <option value={val} selected={sel(a.status, val)}>{label}</option>
                      ))}
                    </select>
                    <button type="submit" class="mini-btn">حفظ</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</section>
</main>
</Base>

<style is:global>
  .form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;}
  @media(max-width:620px){.form-grid-2{grid-template-columns:1fr;}}
  .mini-select,.mini-btn{font-family:'Cairo',sans-serif;font-size:0.82rem;padding:6px 10px;border:1px solid var(--line);border-radius:2px;background:#fff;}
  .mini-btn{background:var(--teal);color:var(--paper);cursor:pointer;border-color:var(--teal);}
</style>
