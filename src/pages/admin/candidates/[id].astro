---
import Admin from '../../../layouts/Admin.astro';
import { serverClient } from '../../../lib/supabase';
import { sendEmail, emailLayout } from '../../../lib/email';
import { logAction } from '../../../lib/audit';
import { readCandidateFields, completeness, AVAILABILITY_AR, SOURCE_AR, waLink } from '../../../lib/candidates';
import CandidateFields from '../../../components/CandidateFields.astro';

const STATUS_MSG: Record<string, string> = {
  shortlisted: 'وصل طلبك للقائمة المختصرة — خطوة كويسة! هنتواصل معاك للخطوة الجاية.',
  rejected: 'بعد المراجعة، اخترنا نكمّل مع مرشحين تانيين للدور ده. نتمنالك التوفيق، وطلبك هيفضل عندنا لفرص مناسبة.',
  hired: 'مبروك! تم اختيارك للوظيفة. فريقنا هيتواصل معاك بتفاصيل العرض.',
};

const { id } = Astro.params;
const supabase = serverClient(Astro);
const me = Astro.locals.user!;
let flash = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') || '');
  const appId = String(form.get('app_id') || '');

  if (action === 'set_status') {
    const st = String(form.get('status') || '');
    if (appId && ['submitted', 'reviewing', 'shortlisted', 'rejected', 'hired'].includes(st)) {
      await supabase.from('applications').update({ status: st }).eq('id', appId);
      await logAction(Astro, supabase, `تغيير حالة متقدم إلى ${st}`, appId);
      if (STATUS_MSG[st]) {
        const { data: a } = await supabase
          .from('applications')
          .select('profiles(full_name, email), jobs(title, slug)')
          .eq('id', appId).maybeSingle();
        const email = (a as any)?.profiles?.email;
        if (email) {
          await sendEmail(Astro, {
            to: email,
            subject: `تحديث على طلبك: ${(a as any)?.jobs?.title ?? 'وظيفة'}`,
            html: emailLayout('تحديث على طلبك',
              `<p>مرحبًا ${(a as any)?.profiles?.full_name ?? ''}،</p><p>${STATUS_MSG[st]}</p>`,
              { text: 'متابعة طلباتي', url: 'https://vacanthr.com/dashboard' }),
          });
        }
      }
      return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303);
    }
  }
  if (action === 'set_rating') {
    const r = parseInt(String(form.get('rating') || ''), 10);
    if (appId && r >= 1 && r <= 5) {
      await supabase.from('applications').update({ rating: r }).eq('id', appId);
      return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303);
    }
    if (appId && String(form.get('rating')) === '0') {
      await supabase.from('applications').update({ rating: null }).eq('id', appId);
      return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303);
    }
  }
  if (action === 'add_note') {
    const body = String(form.get('body') || '').trim();
    if (appId && body) {
      await supabase.from('application_notes').insert({ application_id: appId, author_id: me.id, body });
      return Astro.redirect(`/admin/candidates/${id}?ok=1#app-${appId}`, 303);
    }
  }
  if (action === 'del_note') {
    const noteId = String(form.get('note_id') || '');
    if (noteId) {
      await supabase.from('application_notes').delete().eq('id', noteId);
      return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303);
    }
  }
  if (action === 'schedule_interview') {
    const when = String(form.get('scheduled_at') || '');
    const mode = String(form.get('mode') || 'online');
    const location = String(form.get('location') || '').trim();
    if (appId && when) {
      const { data: iv } = await supabase.from('interviews').insert({
        application_id: appId, scheduled_at: new Date(when).toISOString(),
        mode: ['online', 'onsite', 'phone'].includes(mode) ? mode : 'online',
        location: location || null, status: 'confirmed', created_by: me.id,
      }).select('id').single();
      const { data: a } = await supabase.from('applications')
        .select('profiles(full_name, email), jobs(title)').eq('id', appId).maybeSingle();
      const email = (a as any)?.profiles?.email;
      if (email) {
        const MODE_AR: Record<string, string> = { online: 'أونلاين', onsite: 'في المقر', phone: 'هاتفيًا' };
        const dt = new Date(when).toLocaleString('ar-EG', { dateStyle: 'full', timeStyle: 'short' });
        await sendEmail(Astro, {
          to: email,
          subject: `موعد مقابلة: ${(a as any)?.jobs?.title ?? 'وظيفة'}`,
          html: emailLayout('اتحدد موعد مقابلتك',
            `<p>مرحبًا ${(a as any)?.profiles?.full_name ?? ''}،</p><p>موعد المقابلة: <strong>${dt}</strong> — ${MODE_AR[mode] ?? mode}${location ? `<br>${location}` : ''}</p>`,
            { text: 'تفاصيل من لوحتي', url: 'https://vacanthr.com/dashboard' }),
        });
      }
      if (iv) {
        await logAction(Astro, supabase, 'جدولة مقابلة', (a as any)?.jobs?.title ?? (a as any)?.profiles?.full_name ?? '');
        return Astro.redirect(`/admin/candidates/${id}?ok=1#app-${appId}`, 303);
      }
    }
  }
  if (action === 'edit_profile') {
    const patch = {
      full_name: String(form.get('full_name') || '').trim() || null,
      phone: String(form.get('phone') || '').trim() || null,
      ...readCandidateFields(form),
      source: SOURCE_AR[String(form.get('source') || '')] ? String(form.get('source')) : null,
      updated_at: new Date().toISOString(),
    };
    const { error } = await supabase.from('profiles').update(patch).eq('id', id);
    if (error) flash = `تعذّر الحفظ: ${error.message}`;
    else { await logAction(Astro, supabase, 'تعديل بيانات مرشح', patch.full_name ?? id); return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303); }
  }
  if (action === 'set_tags') {
    const tags = String(form.get('tags') || '').split(/[,،]/).map((t) => t.trim()).filter(Boolean);
    const admin_notes = String(form.get('admin_notes') || '').trim().slice(0, 4000) || null;
    const { error } = await supabase.from('profiles').update({ tags, admin_notes, updated_at: new Date().toISOString() }).eq('id', id);
    if (error) flash = `تعذّر الحفظ: ${error.message}`;
    else { await logAction(Astro, supabase, 'تحديث وسوم/ملاحظات مرشح', id); return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303); }
  }
  if (action === 'cancel_interview') {
    const ivId = String(form.get('interview_id') || '');
    if (ivId) {
      await supabase.from('interviews').update({ status: 'cancelled' }).eq('id', ivId);
      await logAction(Astro, supabase, 'إلغاء مقابلة', ivId);
      return Astro.redirect(`/admin/candidates/${id}?ok=1`, 303);
    }
  }
}
const ok = new URL(Astro.request.url).searchParams.get('ok') === '1';

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', id)
  .maybeSingle();
if (!profile) return Astro.redirect('/admin/candidates', 302);
const comp = completeness(profile);
const wa = waLink(profile.phone);
const editing = new URL(Astro.request.url).searchParams.get('edit') === '1';
const age = profile.birth_year ? new Date().getFullYear() - profile.birth_year : null;

const { data: apps } = await supabase
  .from('applications')
  .select('id, status, rating, created_at, cover_note, cv_path, jobs(title, slug), application_notes(id, body, created_at), interviews(id, scheduled_at, mode, location, status)')
  .eq('candidate_id', id)
  .order('created_at', { ascending: false });

const STATUS: Array<[string, string]> = [
  ['submitted', 'تحت المراجعة'], ['reviewing', 'قيد الفحص'], ['shortlisted', 'قائمة مختصرة'],
  ['rejected', 'مرفوض'], ['hired', 'تم التعيين'],
];
const MODE_AR: Record<string, string> = { online: 'أونلاين', onsite: 'في المقر', phone: 'هاتفيًا' };
const sel = (a: string, b: string) => (a === b ? true : undefined);
const fmt = (s: string) => new Date(s).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
const fmtDT = (s: string) => new Date(s).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
---
<Admin title={`${profile.full_name || 'مرشح'} | لوحة الإدارة`} path={`/admin/candidates/${id}`} active="candidates">
<Fragment slot="heading">{profile.full_name || 'مرشح'}</Fragment>
<div class="admin-body">
    <p style="margin-bottom:18px;"><a href="/admin/candidates">→ رجوع للقائمة</a></p>
    {ok && <p class="notice notice-ok" style="margin-bottom:18px;">تم الحفظ.</p>}

    {flash && <p class="notice notice-error" style="margin-bottom:18px;">{flash}</p>}

    <div class="cprof">
      <div class="cprof-head">
        <span class="cprof-avatar">{(profile.full_name || '?').trim().slice(0, 1)}</span>
        <div style="flex:1;min-width:0;">
          <h2 style="margin:0;">{profile.full_name || '—'}</h2>
          <p style="margin:2px 0 0;color:var(--body);">{profile.headline || <em style="color:var(--muted);">بدون مسمى مهني</em>}{profile.current_company && <> · {profile.current_company}</>}</p>
          <p class="cprof-meta">
            {profile.city && <span>📍 {profile.city}</span>}
            {profile.years_experience != null && <span>{profile.years_experience} سنة خبرة</span>}
            {age && <span>{age} سنة</span>}
            {profile.availability && <span class="status-pill status-shortlisted">{AVAILABILITY_AR[profile.availability]}</span>}
            {profile.expected_salary && <span>يتوقع {profile.expected_salary.toLocaleString('ar-EG')} ج/شهر</span>}
          </p>
        </div>
        <div class="cprof-actions">
          {profile.phone && <a href={`tel:${profile.phone}`} class="btn" dir="ltr">📞 {profile.phone}</a>}
          {wa && <a href={wa} target="_blank" rel="noopener" class="btn">واتساب</a>}
          {profile.email && <a href={`mailto:${profile.email}`} class="btn">✉ إيميل</a>}
          <a href={`/admin/inbox/new?candidate=${id}`} class="btn">رسالة داخلية</a>
          {profile.cv_path && <a href={`/admin/candidates/${id}/cv`} target="_blank" rel="noopener" class="btn solid">فتح الـCV ↗</a>}
          <a href={editing ? `/admin/candidates/${id}` : `/admin/candidates/${id}?edit=1`} class="btn">{editing ? 'إلغاء التعديل' : '✎ تعديل البيانات'}</a>
        </div>
      </div>

      <div class="cprof-grid">
        <div class="cprof-box">
          <h4>البيانات</h4>
          <dl>
            <dt>الإيميل</dt><dd dir="ltr">{profile.email || '—'}</dd>
            <dt>المؤهل</dt><dd>{profile.education || '—'}</dd>
            <dt>LinkedIn</dt><dd dir="ltr">{profile.linkedin_url ? <a href={profile.linkedin_url} target="_blank" rel="noopener">{profile.linkedin_url.replace(/^https?:\/\/(www\.)?/, '')}</a> : '—'}</dd>
            <dt>Portfolio</dt><dd dir="ltr">{profile.portfolio_url ? <a href={profile.portfolio_url} target="_blank" rel="noopener">{profile.portfolio_url.replace(/^https?:\/\/(www\.)?/, '')}</a> : '—'}</dd>
            <dt>المصدر</dt><dd>{SOURCE_AR[profile.source] ?? profile.source ?? '—'}</dd>
            <dt>مسجّل من</dt><dd>{fmt(profile.created_at)}</dd>
          </dl>
          <div style="margin-top:10px;">
            <small style="color:var(--muted);">اكتمال الملف {comp.pct}%{comp.missing.length ? ` — ناقص: ${comp.missing.join('، ')}` : ''}</small>
            <div class="meter"><span style={`width:${comp.pct}%`}></span></div>
          </div>
        </div>
        <div class="cprof-box">
          <h4>المهارات</h4>
          {(profile.skills?.length) ? <div class="cand-chips">{profile.skills.map((x: string) => <b class="chip">{x}</b>)}</div> : <p style="color:var(--muted);margin:0;">—</p>}
          {profile.bio && <><h4 style="margin-top:14px;">نبذة</h4><p style="margin:0;white-space:pre-wrap;font-size:.92rem;">{profile.bio}</p></>}
        </div>
        <form method="POST" class="cprof-box">
          <input type="hidden" name="_action" value="set_tags" />
          <h4>وسوم وملاحظات الفريق <small style="color:var(--muted);font-weight:400;">(داخلية)</small></h4>
          <div class="form-row"><label>وسوم (مفصولة بفواصل — مثال: مميز, للاستشارات, ينفع Senior)</label><input name="tags" value={(profile.tags ?? []).join(', ')} /></div>
          <div class="form-row"><label>ملاحظات عامة عن المرشح</label><textarea name="admin_notes" style="min-height:80px;">{profile.admin_notes ?? ''}</textarea></div>
          <button class="btn solid" style="border:none;cursor:pointer;padding:8px 18px;font-size:.88rem;">حفظ</button>
        </form>
      </div>

      {editing && (
        <form method="POST" class="form-box" style="max-width:none;margin-top:18px;">
          <input type="hidden" name="_action" value="edit_profile" />
          <h3 style="margin-bottom:12px;">تعديل بيانات المرشح</h3>
          <div class="form-grid-2">
            <div class="form-row"><label for="full_name">الاسم</label><input id="full_name" name="full_name" value={profile.full_name ?? ''} required /></div>
            <div class="form-row"><label for="phone">الهاتف</label><input id="phone" name="phone" value={profile.phone ?? ''} dir="ltr" /></div>
          </div>
          <CandidateFields v={profile} />
          <div class="form-row" style="max-width:320px;">
            <label for="source">المصدر</label>
            <select id="source" name="source">
              <option value="">— غير محدد —</option>
              {Object.entries(SOURCE_AR).map(([k, l]) => <option value={k} selected={profile.source === k ? true : undefined}>{l}</option>)}
            </select>
          </div>
          <button class="btn solid" style="border:none;cursor:pointer;">حفظ التعديلات</button>
        </form>
      )}
    </div>

    <h2 style="margin-bottom:16px;">الطلبات ({apps?.length ?? 0})</h2>
    {(!apps || apps.length === 0) ? (
      <p style="color:var(--muted);">مفيش طلبات لهذا المرشح.</p>
    ) : (
      <div style="display:grid;gap:18px;">
        {apps.map((a: any) => (
          <div class="form-box" id={`app-${a.id}`} style="max-width:none;">
            <div style="display:flex;flex-wrap:wrap;gap:10px 16px;justify-content:space-between;align-items:baseline;">
              <h3 style="margin:0;">
                {a.jobs?.slug ? <a href={`/admin/jobs/${a.jobs.slug}`}>{a.jobs?.title}</a> : (a.jobs?.title ?? 'وظيفة محذوفة')}
              </h3>
              <span style="font-size:0.85rem;color:var(--muted);">قدّم في {fmt(a.created_at)}</span>
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:10px;margin:14px 0;">
              <form method="POST" style="display:flex;gap:6px;">
                <input type="hidden" name="_action" value="set_status" />
                <input type="hidden" name="app_id" value={a.id} />
                <select name="status" class="mini-select">
                  {STATUS.map(([v, l]) => <option value={v} selected={sel(a.status, v)}>{l}</option>)}
                </select>
                <button class="mini-btn">حفظ الحالة</button>
              </form>

              <form method="POST" style="display:flex;gap:6px;">
                <input type="hidden" name="_action" value="set_rating" />
                <input type="hidden" name="app_id" value={a.id} />
                <select name="rating" class="mini-select">
                  <option value="0" selected={!a.rating}>بدون تقييم</option>
                  {[1, 2, 3, 4, 5].map((n) => <option value={n} selected={a.rating === n}>{'★'.repeat(n)}</option>)}
                </select>
                <button class="mini-btn">حفظ التقييم</button>
              </form>

              {a.cv_path && <a href={`/admin/cv/${a.id}`} target="_blank" rel="noopener" class="btn" style="padding:6px 14px;font-size:0.82rem;">فتح الـCV ↗</a>}
            </div>

            {a.cover_note && <p style="background:var(--surface-soft);padding:12px 14px;border-radius:8px;font-size:0.92rem;white-space:pre-wrap;">{a.cover_note}</p>}

            <h4 style="margin:16px 0 8px;">ملاحظات داخلية</h4>
            {(a.application_notes ?? []).sort((x: any, y: any) => (x.created_at < y.created_at ? 1 : -1)).map((n: any) => (
              <div style="display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line-soft);padding:10px 0;font-size:0.92rem;">
                <span style="white-space:pre-wrap;">{n.body}<br /><span style="color:var(--muted);font-size:0.8rem;">{fmt(n.created_at)}</span></span>
                <form method="POST" onsubmit="return confirm('حذف الملاحظة؟')">
                  <input type="hidden" name="_action" value="del_note" />
                  <input type="hidden" name="note_id" value={n.id} />
                  <button style="background:none;border:0;color:#9A3B1C;cursor:pointer;font-size:0.8rem;">حذف</button>
                </form>
              </div>
            ))}
            <form method="POST" style="margin-top:10px;">
              <input type="hidden" name="_action" value="add_note" />
              <input type="hidden" name="app_id" value={a.id} />
              <textarea name="body" placeholder="أضف ملاحظة…" style="min-height:60px;" required></textarea>
              <button type="submit" class="btn" style="margin-top:8px;padding:8px 18px;font-size:0.85rem;">إضافة ملاحظة</button>
            </form>

            <h4 style="margin:18px 0 8px;">المقابلات</h4>
            {(a.interviews ?? []).filter((v: any) => v.status !== 'cancelled').sort((x: any, y: any) => (x.scheduled_at > y.scheduled_at ? 1 : -1)).map((v: any) => (
              <div style="display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line-soft);padding:10px 0;font-size:0.9rem;">
                <span><strong>{fmtDT(v.scheduled_at)}</strong> — {MODE_AR[v.mode] ?? v.mode}{v.location ? ` · ${v.location}` : ''}</span>
                <form method="POST" onsubmit="return confirm('إلغاء المقابلة؟')">
                  <input type="hidden" name="_action" value="cancel_interview" />
                  <input type="hidden" name="interview_id" value={v.id} />
                  <button style="background:none;border:0;color:#9A3B1C;cursor:pointer;font-size:0.8rem;">إلغاء</button>
                </form>
              </div>
            ))}
            <form method="POST" style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
              <input type="hidden" name="_action" value="schedule_interview" />
              <input type="hidden" name="app_id" value={a.id} />
              <input type="datetime-local" name="scheduled_at" required style="width:auto;flex:1;min-width:190px;" />
              <select name="mode" class="mini-select"><option value="online">أونلاين</option><option value="onsite">في المقر</option><option value="phone">هاتفيًا</option></select>
              <input type="text" name="location" placeholder="رابط الاجتماع / العنوان" style="width:auto;flex:1;min-width:180px;" />
              <button type="submit" class="btn" style="padding:8px 16px;font-size:0.85rem;">جدولة مقابلة</button>
            </form>

            <p style="margin-top:14px;">
              <a href={`/admin/inbox/new?candidate=${id}&app=${a.id}`} class="btn" style="padding:6px 14px;font-size:0.82rem;">مراسلة المرشح ✉</a>
            </p>
          </div>
        ))}
      </div>
    )}
</div>
<style is:global>
  .cprof{ margin-bottom:32px; }
  .cprof-head{ display:flex; gap:16px; align-items:flex-start; flex-wrap:wrap; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; }
  .cprof-avatar{ width:56px; height:56px; border-radius:50%; background:var(--accent); color:#fff; font-weight:700; font-size:1.4rem; display:inline-flex; align-items:center; justify-content:center; flex:none; }
  .cprof-meta{ display:flex; flex-wrap:wrap; gap:6px 14px; margin:8px 0 0; font-size:.86rem; color:var(--muted); align-items:center; }
  .cprof-actions{ display:flex; flex-wrap:wrap; gap:8px; width:100%; }
  .cprof-actions .btn{ padding:7px 14px; font-size:.85rem; }
  .cprof-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:12px; margin-top:12px; }
  .cprof-box{ background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; }
  .cprof-box h4{ margin:0 0 10px; font-size:.95rem; }
  .cprof-box dl{ display:grid; grid-template-columns:auto 1fr; gap:6px 14px; margin:0; font-size:.9rem; }
  .cprof-box dt{ color:var(--muted); }
  .cprof-box dd{ margin:0; overflow-wrap:anywhere; }
  .cand-chips{ display:flex; flex-wrap:wrap; gap:4px; }
  .chip{ font-weight:500; font-size:.75rem; padding:2px 9px; border-radius:999px; background:var(--surface-soft); border:1px solid var(--line); color:var(--body); }
  .meter{ height:6px; background:var(--surface-soft); border-radius:999px; overflow:hidden; margin-top:6px; }
  .meter span{ display:block; height:100%; background:var(--accent); border-radius:999px; }
</style>
</Admin>
