---
import Base from '../layouts/Base.astro';
import { getSettings, getTestimonials, getFaqs, mediaUrl, getPosts } from '../lib/settings';
import { anonClient } from '../lib/supabase';
import { EMPLOYMENT_TYPE_AR, WORKPLACE_AR, timeAgo } from '../lib/jobs';
import SiteSections from '../components/SiteSections.astro';
import { getSections } from '../lib/sections';

const [s, testimonials, faqs, posts, { data: latestJobs }] = await Promise.all([
  getSettings(), getTestimonials(), getFaqs(), getPosts(),
  anonClient().from('jobs').select('slug, title, department, location, employment_type, workplace, published_at, created_at').eq('status', 'open').order('published_at', { ascending: false, nullsFirst: false }).limit(3),
]);
const jobs = latestJobs ?? [];
const sections = await getSections('home');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Vacant HR',
    url: 'https://vacanthr.com/',
    logo: s.logo_path ? mediaUrl(s.logo_path) : 'https://vacanthr.com/og-image.png',
    email: s.contact_email,
    description: s.company_blurb,
    address: { '@type': 'PostalAddress', addressLocality: 'القاهرة', addressCountry: 'EG' },
    sameAs: [s.linkedin_url],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Vacant HR', url: 'https://vacanthr.com/', inLanguage: 'ar' },
  ...(faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/<[^>]+>/g, '') },
        })),
      }]
    : []),
];

function statAttrs(value: string) {
  const num = parseInt(value.replace(/[^\d]/g, ''), 10);
  const prefix = value.trim().startsWith('+') ? '+' : '';
  const suffix = value.includes('%') ? '%' : '';
  return Number.isFinite(num) ? { 'data-count': String(num), 'data-prefix': prefix, 'data-suffix': suffix } : {};
}
---
<Base
  preloadImage={s.home_hero_image ? mediaUrl(s.home_hero_image, 1200) : undefined}
  title="Vacant HR | حلول التوظيف وإدارة الموارد البشرية للشركات"
  description="Vacant HR تقدم خدمات التوظيف، نظام إدارة موارد بشرية سحابي (HRM SaaS)، استشارات الهيكلة والسياسات، ومكتبة نماذج وصف وظيفي جاهزة — للشركات الناشئة والمتوسطة في مصر."
  active="home"
  path="/"
  jsonld={jsonld}
>
<main id="main">
{sections.length > 0 ? <SiteSections sections={sections} big={true} /> : (
<>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow-line">{s.home_hero_eyebrow}</div>
      <h1>{s.home_hero_title}</h1>
      <p class="lead">{s.home_hero_lead}</p>
      <div class="btn-row">
        <a href="/contact" class="btn solid">احجز استشارة مجانية</a>
        <a href="/hrm-saas" class="btn">شاهد برنامج HRM</a>
      </div>
    </div>
    <div class="hero-figure" aria-hidden="true">
      {s.home_hero_image ? (
        <img src={mediaUrl(s.home_hero_image, 1200)} alt="" width="1200" height="900" fetchpriority="high" decoding="async" style="width:100%;height:100%;object-fit:cover;" />
      ) : (
        <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="">
          <rect width="400" height="500" fill="#E8E0CB"/>
          <rect x="40" y="40" width="320" height="420" fill="none" stroke="#B07A2E" stroke-width="1.5"/>
          <circle cx="200" cy="170" r="60" fill="#1F3B36"/>
          <path d="M110 380 q90 -120 180 0" fill="none" stroke="#1F3B36" stroke-width="10" stroke-linecap="round"/>
          <circle cx="120" cy="110" r="10" fill="#B07A2E"/>
          <circle cx="290" cy="120" r="6" fill="#2C5049"/>
          <line x1="70" y1="300" x2="330" y2="300" stroke="#B07A2E" stroke-width="1.5"/>
          <rect x="70" y="320" width="120" height="8" fill="#2C5049"/>
          <rect x="70" y="338" width="80" height="8" fill="#B07A2E"/>
        </svg>
      )}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line">خدماتنا</div>
      <h2>أربعة أعمدة لبناء منظومة موارد بشرية متكاملة</h2>
    </div>
    <div class="services-list">
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M3.5 20c0-3.6 2.5-6 5.5-6s5.5 2.4 5.5 6"/><path d="M16 9l2.2 2.2L22 7"/></svg></div>
        <div>
          <h3>التوظيف</h3>
          <p>نبحث عن الكفاءات المناسبة لشركتك عبر شبكة مرشحين مدروسة، من الفرز الأولي وحتى التعيين النهائي.</p>
          <a href="/recruitment" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="1.5"/><path d="M3 9h18M8 21h8M12 18v3"/></svg></div>
        <div>
          <h3>برنامج HRM SaaS</h3>
          <p>نظام سحابي لإدارة الحضور والرواتب والإجازات وتقييم الأداء، بواجهة عربية بسيطة لفريقك.</p>
          <a href="/hrm-saas" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 4v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V7z"/><path d="M9 12l2 2 4-4"/></svg></div>
        <div>
          <h3>الاستشارات</h3>
          <p>نساعدك في هيكلة الأقسام، بناء السياسات الداخلية، وتصميم مسارات النمو الوظيفي.</p>
          <a href="/consulting" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5"/></svg></div>
        <div>
          <h3>نماذج الوصف الوظيفي</h3>
          <p>مكتبة جاهزة من نماذج الوصف الوظيفي القابلة للتحميل والتعديل، مصنّفة حسب القطاع والمسمى.</p>
          <a href="/jd-templates" class="more">تصفح المكتبة ←</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line">كيف نشتغل</div>
      <h2>ثلاث خطوات من أول مكالمة لحد التعيين</h2>
    </div>
    <div class="how">
      <div class="how-step"><span class="how-n">01</span><h3>نفهم احتياجك</h3><p>مكالمة قصيرة نحدد فيها الدور، المهارات، الميزانية، وثقافة الفريق.</p></div>
      <div class="how-step"><span class="how-n">02</span><h3>نفرز ونرشّح</h3><p>نبحث في قاعدة مرشحينا وشبكتنا، نعمل مقابلات أولية، ونبعتلك قائمة مختصرة خلال أيام.</p></div>
      <div class="how-step"><span class="how-n">03</span><h3>نكمّل معاك للتعيين</h3><p>ننسّق المقابلات، نساعدك في العرض والتفاوض، ونتابع معاك بعد الانضمام.</p></div>
    </div>
  </div>
</section>

{jobs.length > 0 && (
  <section>
    <div class="wrap">
      <div class="section-head" style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;max-width:none;flex-wrap:wrap;">
        <div><div class="eyebrow-line">أحدث الوظائف</div><h2 style="margin:0;">فرص مفتوحة دلوقتي</h2></div>
        <a href="/careers" class="btn">كل الوظائف ←</a>
      </div>
      <div class="home-jobs">
        {jobs.map((j: any) => (
          <a href={`/careers/${j.slug}`} class="home-job">
            <span class="home-job-dept">{j.department ?? 'وظيفة'}</span>
            <strong>{j.title}</strong>
            <span class="job-meta">{j.location && <span>{j.location}</span>}<span>{EMPLOYMENT_TYPE_AR[j.employment_type as keyof typeof EMPLOYMENT_TYPE_AR]}</span><span>{WORKPLACE_AR[j.workplace as keyof typeof WORKPLACE_AR]}</span></span>
            <small>{timeAgo(j.published_at ?? j.created_at)}</small>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="alt">
  <div class="wrap">
    <div class="stats">
      {s.home_stats.map((st) => (
        <div class="stat"><div class="num" {...statAttrs(st.value)}>{st.value}</div><div class="lbl">{st.label}</div></div>
      ))}
    </div>
  </div>
</section>

{testimonials.length > 0 && (
  <section>
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow-line">آراء عملائنا</div>
        <h2>شركات وصلت لفريقها الصح معانا</h2>
      </div>
      <div class="quotes">
        {testimonials.map((t) => (
          <div class="quote">
            <p>«{t.quote}»</p>
            <div class="who">{t.name}{t.title && <span>{t.title}</span>}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{faqs.length > 0 && (
  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow-line">أسئلة شائعة</div>
        <h2>الأسئلة اللي بتوصلنا كتير</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="rich" set:html={f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
)}

{posts.length > 0 && (
  <section>
    <div class="wrap">
      <div class="section-head" style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;max-width:none;flex-wrap:wrap;">
        <div><div class="eyebrow-line">من المدوّنة</div><h2 style="margin:0;">أفكار عملية في التوظيف والموارد البشرية</h2></div>
        <a href="/blog" class="btn">كل المقالات ←</a>
      </div>
      <div class="post-grid card-shadow" style="--cols:3;--ratio:16/9;">
        {posts.slice(0, 3).map((p) => (
          <a href={`/blog/${p.slug}`} class="post-card">
            {p.cover_path ? <img src={mediaUrl(p.cover_path, 600)} alt={p.title} loading="lazy" decoding="async" /> : <span class="post-noimg" aria-hidden="true">{p.title.slice(0, 1)}</span>}
            <div class="post-card-body">
              {p.category && <span class="post-meta"><b class="post-cat">{p.category}</b></span>}
              <h2>{p.title}</h2>
              {p.excerpt && <p>{p.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="cta-banner">
  <div class="wrap">
    <h2>محتاج تبدأ من فين؟</h2>
    <p>خليك تحكي لنا عن تحدي التوظيف أو إدارة الموارد البشرية عندك، وهنرشحلك الحل المناسب خلال يوم عمل.</p>
    <a href="/contact" class="btn solid">تواصل معانا الآن</a>
  </div>
</section>

</>
)}
</main>
</Base>
