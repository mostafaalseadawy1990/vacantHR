---
import Base from '../layouts/Base.astro';
export const prerender = true;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Vacant HR',
    url: 'https://vacanthr.com/',
    logo: 'https://vacanthr.com/favicon.svg',
    email: 'info@vacanthr.com',
    description: 'حلول متكاملة للتوظيف وإدارة الموارد البشرية للشركات الناشئة والمتوسطة.',
    address: { '@type': 'PostalAddress', addressLocality: 'القاهرة', addressCountry: 'EG' },
    sameAs: ['https://www.linkedin.com/company/vacanthr'],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Vacant HR', url: 'https://vacanthr.com/', inLanguage: 'ar' },
];
---
<Base
  title="Vacant HR | حلول التوظيف وإدارة الموارد البشرية للشركات"
  description="Vacant HR تقدم خدمات التوظيف، نظام إدارة موارد بشرية سحابي (HRM SaaS)، استشارات الهيكلة والسياسات، ومكتبة نماذج وصف وظيفي جاهزة — للشركات الناشئة والمتوسطة في مصر."
  active="home"
  path="/"
  jsonld={jsonld}
>
<main id="main">

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow-line">شريكك في إدارة رأس المال البشري</div>
      <h1>نبني أنظمة التوظيف والموارد البشرية التي تكبر مع شركتك</h1>
      <p class="lead">من إيجاد الكفاءة المناسبة، إلى إدارة بيانات موظفيك يوميًا، وصولًا لهيكلة سياسات عملك — Vacant HR تجمع الخدمة البشرية والتقنية في مكان واحد.</p>
      <div class="btn-row">
        <a href="/contact" class="btn solid">احجز استشارة مجانية</a>
        <a href="/hrm-saas" class="btn">شاهد برنامج HRM</a>
      </div>
    </div>
    <div class="hero-figure" aria-hidden="true">
      <svg viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="">
        <rect width="400" height="500" fill="#E8E0CB"/>
        <rect x="40" y="40" width="320" height="420" fill="none" stroke="#B07A2E" stroke-width="1.5"/>
        <circle cx="200" cy="170" r="60" fill="#1F3B36"/>
        <path d="M110 380 q90 -120 180 0" fill="none" stroke="#1F3B36" stroke-width="10" stroke-linecap="round"/>
        <circle cx="120" cy="110" r="10" fill="#B07A2E"/>
        <circle cx="290" cy="120" r="6" fill="#2C5049"/>
        <line x1="70" y1="300" x2="330" y2="300" stroke="#B07A2E" stroke-width="1.5"/>
        <rect x="70" y="320" width="120" height="8" fill="#2C5049"/>
        <rect x="70" y="338" width="80" height="8" fill="#B07A2E"/>
      </svg>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line">خدماتنا</div>
      <h2>أربعة أعمدة لبناء منظومة موارد بشرية متكاملة</h2>
    </div>
    <div class="services-list">
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M3.5 20c0-3.6 2.5-6 5.5-6s5.5 2.4 5.5 6"/><path d="M16 9l2.2 2.2L22 7"/></svg></div>
        <div>
          <h3>التوظيف</h3>
          <p>نبحث عن الكفاءات المناسبة لشركتك عبر شبكة مرشحين مدروسة، من الفرز الأولي وحتى التعيين النهائي.</p>
          <a href="/recruitment" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="1.5"/><path d="M3 9h18M8 21h8M12 18v3"/></svg></div>
        <div>
          <h3>برنامج HRM SaaS</h3>
          <p>نظام سحابي لإدارة الحضور والرواتب والإجازات وتقييم الأداء، بواجهة عربية بسيطة لفريقك.</p>
          <a href="/hrm-saas" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 4v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V7z"/><path d="M9 12l2 2 4-4"/></svg></div>
        <div>
          <h3>الاستشارات</h3>
          <p>نساعدك في هيكلة الأقسام، بناء السياسات الداخلية، وتصميم مسارات النمو الوظيفي.</p>
          <a href="/consulting" class="more">اعرف أكتر ←</a>
        </div>
      </div>
      <div class="service-item">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5"/></svg></div>
        <div>
          <h3>نماذج الوصف الوظيفي</h3>
          <p>مكتبة جاهزة من نماذج الوصف الوظيفي القابلة للتحميل والتعديل، مصنّفة حسب القطاع والمسمى.</p>
          <a href="/jd-templates" class="more">تصفح المكتبة ←</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="num" data-count="120" data-prefix="+">+120</div><div class="lbl">شركة تثق بينا</div></div>
      <div class="stat"><div class="num" data-count="3400" data-prefix="+">+3,400</div><div class="lbl">توظيف ناجح</div></div>
      <div class="stat"><div class="num" data-count="18">18</div><div class="lbl">قطاع مختلف</div></div>
      <div class="stat"><div class="num" data-count="92" data-suffix="%">92%</div><div class="lbl">نسبة رضا العملاء</div></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line">آراء عملائنا</div>
      <h2>شركات وصلت لفريقها الصح معانا</h2>
    </div>
    <div class="quotes">
      <div class="quote">
        <p>«فريق Vacant HR فهم طبيعة شركتنا بسرعة، ورشحلنا 3 مرشحين كلهم كانوا مناسبين فعلًا. عيّنّا واحد خلال أسبوعين.»</p>
        <div class="who">منال إبراهيم<span>مديرة الموارد البشرية — شركة تقنية</span></div>
      </div>
      <div class="quote">
        <p>«نقلنا إدارة الحضور والرواتب من شيتات إكسل لبرنامج HRM بتاعهم. وفّرنا يومين شغل كل شهر على الأقل.»</p>
        <div class="who">أحمد فؤاد<span>مدير عمليات — سلسلة مطاعم</span></div>
      </div>
      <div class="quote">
        <p>«الاستشارة كانت عملية جدًا. طلعنا بدليل سياسات واضح وهيكل تنظيمي مفيش فيه تضارب صلاحيات.»</p>
        <div class="who">سارة عبد الله<span>مؤسِّسة — شركة خدمات لوجستية</span></div>
      </div>
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow-line">أسئلة شائعة</div>
      <h2>الأسئلة اللي بتوصلنا كتير</h2>
    </div>
    <div class="faq">
      <details>
        <summary>خدمة التوظيف بتاخد وقت قد إيه؟</summary>
        <p>في المتوسط بنقدّم قائمة مختصرة من 3–5 مرشحين خلال 7–10 أيام عمل من تأكيد تفاصيل الدور، والتعيين النهائي بيتم عادةً خلال 3–4 أسابيع.</p>
      </details>
      <details>
        <summary>برنامج HRM بيشتغل على الموبايل؟</summary>
        <p>أيوه، النظام سحابي بالكامل ويشتغل من المتصفح على الكمبيوتر والموبايل، وفيه تسجيل حضور عن طريق الموبايل أو البصمة.</p>
      </details>
      <details>
        <summary>هل في حد أدنى لعدد الموظفين للاشتراك في البرنامج؟</summary>
        <p>لا يوجد حد أدنى إلزامي. الباقة الأساسية مصممة للفرق تحت 20 موظف، وفيه باقات أكبر للشركات المتوسطة والمؤسسات.</p>
      </details>
      <details>
        <summary>نماذج الوصف الوظيفي مجانية فعلًا؟</summary>
        <p>أيوه، مكتبة النماذج القياسية متاحة للتحميل مجانًا. لو محتاج نموذج مخصص لمسمى غير موجود، بنجهّزه لك خلال يوم عمل.</p>
      </details>
    </div>
  </div>
</section>

<section class="cta-banner">
  <div class="wrap">
    <h2>محتاج تبدأ من فين؟</h2>
    <p>خليك تحكي لنا عن تحدي التوظيف أو إدارة الموارد البشرية عندك، وهنرشحلك الحل المناسب خلال يوم عمل.</p>
    <a href="/contact" class="btn solid">تواصل معانا الآن</a>
  </div>
</section>

</main>
</Base>
