---
import Base from '../layouts/Base.astro';
import SiteSections from '../components/SiteSections.astro';
import { getSettings } from '../lib/settings';
import { getSections } from '../lib/sections';
import { anonClient } from '../lib/supabase';
import { notifyAdmins } from '../lib/notify';

const [s, sections] = await Promise.all([getSettings(), getSections('contact')]);
const hero = sections.find((x) => x.kind === 'hero');
const rest = sections.filter((x) => x.kind !== 'hero');

const SERVICES = ['التوظيف', 'برنامج HRM SaaS', 'الاستشارات', 'نماذج الوصف الوظيفي', 'أخرى'];
let errorMsg = '';
let v = { name: '', company: '', email: '', phone: '', service: SERVICES[0], message: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const g = (k: string) => String(form.get(k) ?? '').trim();
  v = { name: g('name'), company: g('company'), email: g('email'), phone: g('phone'), service: SERVICES.includes(g('service')) ? g('service') : 'أخرى', message: g('message') };
  if (g('website')) return Astro.redirect('/thanks', 303); // honeypot: bots fill it, humans don't see it
  if (!v.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.email) || v.message.length < 10) {
    errorMsg = 'اكتب اسمك وبريد إلكتروني صحيح وتفاصيل الطلب (10 حروف على الأقل).';
  } else {
    const { error } = await anonClient().rpc('submit_contact', {
      p_name: v.name, p_email: v.email, p_message: v.message, p_company: v.company || null, p_phone: v.phone || null, p_service: v.service, p_source: '/contact',
    });
    if (error) {
      errorMsg = 'تعذّر الإرسال حاليًا. راسلنا مباشرة على واتساب أو البريد الإلكتروني.';
    } else {
      await notifyAdmins(Astro, {
        title: `رسالة جديدة من الموقع: ${v.service} — ${v.name}`,
        lines: [`${v.name}${v.company ? ` — ${v.company}` : ''}`, `${v.email}${v.phone ? ` · ${v.phone}` : ''}`, `الخدمة: ${v.service}`, v.message],
        url: 'https://vacanthr.com/admin/contact', replyTo: v.email,
      });
      return Astro.redirect('/thanks', 303);
    }
  }
}

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'ContactPage', url: 'https://vacanthr.com/contact',
  mainEntity: { '@type': 'Organization', name: 'Vacant HR', email: s.contact_email, telephone: s.contact_phone, address: { '@type': 'PostalAddress', addressLocality: 'القاهرة', addressCountry: 'EG' } },
}];
---
<Base
  title="تواصل معنا | Vacant HR"
  description="تواصل مع فريق Vacant HR — استفسارات التوظيف، برنامج HRM، الاستشارات، ونماذج الوصف الوظيفي. نرد خلال يوم عمل واحد."
  active="contact" path="/contact" waText="مرحبًا، عندي استفسار" jsonld={jsonld}
>
<main id="main">

{hero ? <SiteSections sections={[hero]} crumb="تواصل معنا" /> : (
  <>
    <div class="wrap"><nav class="breadcrumb" aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>/</span>تواصل معنا</nav></div>
    <section class="hero" style="padding:40px 0 40px;">
      <div class="wrap"><div class="eyebrow-line">تواصل معنا</div><h1 style="max-width:16ch;">خليك تحكي لنا، هنرد خلال يوم عمل</h1></div>
    </section>
  </>
)}

<section style="padding-top:0;" id="form">
  <div class="wrap contact-layout">
    <div>
      {errorMsg && <p class="notice notice-error" style="margin-bottom:16px;">{errorMsg}</p>}
      <form class="form-box" method="POST" action="/contact#form" style="max-width:none;">
        <p hidden aria-hidden="true"><label>الموقع الإلكتروني <input name="website" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form-grid-2">
          <div class="form-row"><label for="name">الاسم *</label><input type="text" id="name" name="name" value={v.name} autocomplete="name" required /></div>
          <div class="form-row"><label for="company">اسم الشركة</label><input type="text" id="company" name="company" value={v.company} autocomplete="organization" /></div>
          <div class="form-row"><label for="email">البريد الإلكتروني *</label><input type="email" id="email" name="email" value={v.email} autocomplete="email" required dir="ltr" /></div>
          <div class="form-row"><label for="phone">رقم الهاتف</label><input type="tel" id="phone" name="phone" value={v.phone} autocomplete="tel" inputmode="tel" dir="ltr" /></div>
        </div>
        <div class="form-row">
          <label for="service">الخدمة المطلوبة</label>
          <select id="service" name="service">{SERVICES.map((x) => <option value={x} selected={v.service === x ? true : undefined}>{x}</option>)}</select>
        </div>
        <div class="form-row"><label for="message">تفاصيل الطلب *</label><textarea id="message" name="message" required minlength="10" style="min-height:140px;">{v.message}</textarea></div>
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إرسال الطلب</button>
        <p class="form-note">بنرد خلال يوم عمل واحد. بياناتك بتتستخدم للرد عليك فقط — <a href="/privacy">سياسة الخصوصية</a>.</p>
      </form>
    </div>
    <aside class="contact-side">
      <div class="contact-wa">
        <div><strong>أسرع طريقة: واتساب</strong><span>رد مباشر في ساعات العمل</span></div>
        <a href={`https://wa.me/${s.whatsapp_number}?text=${encodeURIComponent('مرحبًا، عندي استفسار')}`} rel="noopener" target="_blank" class="btn solid">ابدأ محادثة</a>
      </div>
      <div class="contact-card">
        <h3>بيانات التواصل</h3>
        <ul class="contact-methods">
          <li><span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 6l8 6 8-6"/></svg></span><span><strong>البريد الإلكتروني</strong><br><a href={`mailto:${s.contact_email}`} dir="ltr">{s.contact_email}</a></span></li>
          <li><span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span><span><strong>الهاتف</strong><br><a href={`tel:${s.contact_phone}`} dir="ltr">{s.contact_phone}</a></span></li>
          <li><span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><strong>العنوان</strong><br>{s.address}</span></li>
          <li><span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><strong>ساعات العمل</strong><br>{s.working_hours}</span></li>
        </ul>
      </div>
      {s.linkedin_url && <a href={s.linkedin_url} target="_blank" rel="noopener" class="btn" style="align-self:flex-start;">تابعنا على LinkedIn ↗</a>}
    </aside>
  </div>
</section>

{rest.length > 0 && <SiteSections sections={rest} />}

</main>
</Base>
