---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';

const s = await getSettings();
const WEB3FORMS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY';

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: 'https://vacanthr.com/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Vacant HR',
    email: 'info@vacanthr.com',
    telephone: '+201000000000',
    address: { '@type': 'PostalAddress', addressLocality: 'القاهرة', addressCountry: 'EG' },
  },
}];
---
<Base
  title="تواصل معنا | Vacant HR"
  description="تواصل مع فريق Vacant HR — استفسارات التوظيف، برنامج HRM، الاستشارات، ونماذج الوصف الوظيفي. نرد خلال يوم عمل واحد."
  active="contact"
  path="/contact"
  waText="مرحبًا، عندي استفسار"
  jsonld={jsonld}
>
<main id="main">

<div class="wrap">
  <nav class="breadcrumb" aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>/</span>تواصل معنا</nav>
</div>

<section class="hero" style="padding:40px 0 40px;">
  <div class="wrap">
    <div class="eyebrow-line">تواصل معنا</div>
    <h1 style="max-width:16ch;">خليك تحكي لنا، هنرد خلال يوم عمل</h1>
  </div>
</section>

<section style="padding-top:0;">
  <div class="wrap split-2">
    <div>
      <form class="form-box" name="contact" method="POST" action="https://api.web3forms.com/submit">
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="طلب جديد من موقع Vacant HR" />
        <input type="hidden" name="from_name" value="موقع Vacant HR" />
        <input type="hidden" name="redirect" value="https://vacanthr.com/thanks" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p hidden><label>لا تملأ هذا الحقل إن كنت إنسانًا: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form-row">
          <label for="name">الاسم*</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="form-row">
          <label for="company">اسم الشركة</label>
          <input type="text" id="company" name="company" autocomplete="organization" />
        </div>
        <div class="form-row">
          <label for="email">البريد الإلكتروني*</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="form-row">
          <label for="phone">رقم الهاتف</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="form-row">
          <label for="service">الخدمة المطلوبة</label>
          <select id="service" name="service">
            <option>التوظيف</option>
            <option>برنامج HRM SaaS</option>
            <option>الاستشارات</option>
            <option>نماذج الوصف الوظيفي</option>
            <option>أخرى</option>
          </select>
        </div>
        <div class="form-row">
          <label for="message">تفاصيل الطلب*</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button type="submit" class="btn solid" style="border:none;cursor:pointer;">إرسال الطلب</button>
        <p class="form-status" role="status" aria-live="polite" style="margin-top:16px;font-weight:600;"></p>
      </form>
    </div>
    <div>
      <h3 style="margin-bottom:20px;">بيانات التواصل</h3>
      <ul class="contact-methods">
        <li>
          <span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 6l8 6 8-6"/></svg></span>
          <span><strong>البريد الإلكتروني</strong><br><a href={`mailto:${s.contact_email}`}>{s.contact_email}</a></span>
        </li>
        <li>
          <span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
          <span><strong>الهاتف</strong><br><a href={`tel:${s.contact_phone}`}>{s.contact_phone}</a></span>
        </li>
        <li>
          <span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20l1.5-4A8 8 0 1 1 9 19.5z"/><path d="M9 10c0 3 2 5 5 5"/></svg></span>
          <span><strong>واتساب</strong><br><a href={`https://wa.me/${s.whatsapp_number}`} rel="noopener" target="_blank">ابدأ محادثة</a></span>
        </li>
        <li>
          <span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <span><strong>العنوان</strong><br>{s.address}</span>
        </li>
        <li>
          <span class="mi" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <span><strong>ساعات العمل</strong><br>{s.working_hours}</span>
        </li>
      </ul>
      <div class="hero-figure" aria-hidden="true" style="margin-top:30px;aspect-ratio:4/3;">
        <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="300" fill="#E8E0CB"/><path d="M200 70a45 45 0 0 1 45 45c0 30-45 90-45 90s-45-60-45-90a45 45 0 0 1 45-45z" fill="#1F3B36"/><circle cx="200" cy="115" r="16" fill="#B07A2E"/><line x1="60" y1="250" x2="340" y2="250" stroke="#B07A2E" stroke-width="2"/></svg>
      </div>
    </div>
  </div>
</section>

</main>

<script is:inline>
(function () {
  var form = document.querySelector('form[name="contact"]');
  if (!form) return;
  var status = form.querySelector('.form-status');
  form.addEventListener('submit', function (e) {
    if (location.protocol === 'file:') return;
    e.preventDefault();
    var btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.style.color = 'var(--teal-2)';
    status.textContent = 'جارٍ الإرسال…';
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form)
    })
      .then(function (r) { return r.json(); })
      .then(function (json) {
        if (!json.success) throw new Error(json.message || 'failed');
        form.reset();
        status.style.color = 'var(--brass)';
        status.textContent = 'تم استلام رسالتك، هنتواصل معاك خلال يوم عمل.';
      })
      .catch(function () {
        status.style.color = 'var(--brass)';
        status.textContent = 'تعذّر الإرسال الآن. راسلنا على info@vacanthr.com أو عبر واتساب.';
        btn.disabled = false;
      });
  });
})();
</script>
</Base>
