---
import Base from '../layouts/Base.astro';
import { getJdTemplates } from '../lib/jd';

const { items } = await getJdTemplates();
const url = new URL(Astro.request.url);
const sector = (url.searchParams.get('sector') || '').trim();
const sectors = [...new Set(items.map((t) => t.sector).filter(Boolean))] as string[];
const shown = sector ? items.filter((t) => t.sector === sector) : items;

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'نماذج الوصف الوظيفي المجانية', url: 'https://vacanthr.com/jd-templates',
  isPartOf: { '@type': 'WebSite', name: 'Vacant HR', url: 'https://vacanthr.com/' }, inLanguage: 'ar',
}];
---
<Base
  title="نماذج الوصف الوظيفي المجانية | Vacant HR"
  description="مكتبة مجانية من نماذج الوصف الوظيفي الجاهزة بصيغة Word من Vacant HR — مصنّفة حسب القطاع: تقنية، مبيعات، تسويق، مالية، موارد بشرية، وخدمة عملاء."
  active="jd" path="/jd-templates" waText="مرحبًا، محتاج نموذج وصف وظيفي مخصص" jsonld={jsonld}
>
<main id="main">
<div class="wrap">
  <nav class="breadcrumb" aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>/</span>نماذج الوصف الوظيفي</nav>
</div>
<section class="hero" style="padding:40px 0 40px;">
  <div class="wrap">
    <div class="eyebrow-line">مكتبة مجانية</div>
    <h1 style="max-width:18ch;">نماذج وصف وظيفي جاهزة بصيغة Word</h1>
    <p class="lead" style="max-width:60ch;">اختصر وقت كتابة الوصف الوظيفي من الصفر. حمّل النموذج كملف Word، عدّله بما يناسب شركتك، وابدأ الإعلان عن الوظيفة فورًا.</p>
  </div>
</section>
<section style="padding-top:0;">
  <div class="wrap">
    {sectors.length > 1 && (
      <nav class="blog-cats" aria-label="القطاعات" style="margin-bottom:24px;">
        <a href="/jd-templates" class:list={{ active: !sector }}>الكل</a>
        {sectors.map((s) => <a href={`/jd-templates?sector=${encodeURIComponent(s)}`} class:list={{ active: sector === s }}>{s}</a>)}
      </nav>
    )}
    <div class="doc-grid">
      {shown.map((t) => (
        <div class="doc-card">
          <span class="cat">{t.sector}</span>
          <h3><a href={`/jd-templates/${t.slug}`}>{t.title}</a></h3>
          <p>{t.summary}</p>
          <div class="doc-acts">
            <a href={`/jd-templates/${t.slug}.docx`} class="btn solid">⬇ تحميل Word</a>
            <a href={`/jd-templates/${t.slug}`} class="btn">معاينة</a>
          </div>
        </div>
      ))}
    </div>
    {shown.length === 0 && <p style="color:var(--muted);">مفيش نماذج في القطاع ده لسه.</p>}
  </div>
</section>
<section class="alt">
  <div class="wrap" style="text-align:center;">
    <h2 style="margin-bottom:16px;">مش لاقي المسمى الوظيفي اللي محتاجه؟</h2>
    <p style="margin:0 auto;">ابعتلنا تفاصيل الدور، وفريقنا هيجهزلك نموذج مخصص خلال يوم عمل واحد.</p>
    <a href="/contact" class="btn solid" style="margin-top:24px;">اطلب نموذج مخصص</a>
  </div>
</section>
</main>
</Base>
