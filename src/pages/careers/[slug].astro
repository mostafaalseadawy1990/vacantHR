---
import Base from '../../layouts/Base.astro';
import { anonClient } from '../../lib/supabase';
import { EMPLOYMENT_TYPE_AR, WORKPLACE_AR, salaryLabel, renderMarkdown, timeAgo, type Job } from '../../lib/jobs';

const { slug } = Astro.params;

const supabase = anonClient();
const { data: job } = await supabase
  .from('jobs')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'open')
  .maybeSingle<Job>();

// Closed/removed job: a real 404 (not a redirect) so Google drops the URL cleanly.
if (!job) return Astro.rewrite('/404');

// Is the visitor a signed-in candidate who already applied? saved?
// Middleware already resolved the session (and swallows auth errors) — reuse it
// instead of a second, unguarded auth round-trip that could 500 the page.
const { user, profile } = Astro.locals;
let alreadyApplied = false;
let isSaved = false;
if (user) {
  const [{ data: existing }, { data: sv }] = await Promise.all([
    supabase.from('applications').select('id').eq('job_id', job.id).eq('candidate_id', user.id).maybeSingle(),
    supabase.from('saved_jobs').select('job_id').eq('job_id', job.id).eq('candidate_id', user.id).maybeSingle(),
  ]);
  alreadyApplied = !!existing;
  isSaved = !!sv;
}

const empMap: Record<string, string> = {
  full_time: 'FULL_TIME', part_time: 'PART_TIME', contract: 'CONTRACTOR', temporary: 'TEMPORARY',
};
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: renderMarkdown(`${job.description_md}\n\n## المتطلبات\n\n${job.requirements_md}`),
  datePosted: (job.published_at ?? job.created_at)?.slice(0, 10),
  employmentType: empMap[job.employment_type],
  hiringOrganization: { '@type': 'Organization', name: 'Vacant HR', sameAs: 'https://vacanthr.com' },
  jobLocationType: job.workplace === 'remote' ? 'TELECOMMUTE' : undefined,
  applicantLocationRequirements: { '@type': 'Country', name: 'Egypt' },
  jobLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: job.location ?? 'القاهرة', addressCountry: 'EG' },
  },
  ...(job.salary_visible && (job.salary_min || job.salary_max)
    ? {
        baseSalary: {
          '@type': 'MonetaryAmount',
          currency: job.salary_currency,
          value: {
            '@type': 'QuantitativeValue',
            minValue: job.salary_min ?? undefined,
            maxValue: job.salary_max ?? undefined,
            unitText: 'MONTH',
          },
        },
      }
    : {}),
}];

// External apply link (e.g. a Google Form) replaces the on-site application flow.
const external = !!job.apply_url;
const applyHref = external
  ? job.apply_url!
  : user
    ? `/careers/${job.slug}/apply`
    : `/login?next=${encodeURIComponent(`/careers/${job.slug}/apply`)}`;
const applyAttrs = external ? { target: '_blank', rel: 'noopener' } : {};

const jobSkills = ((job.skills ?? []) as string[]).map((s) => s.toLowerCase().trim()).filter(Boolean);
const mySkills = new Set(((profile?.skills ?? []) as string[]).map((s) => s.toLowerCase().trim()));
const matched = jobSkills.filter((s) => mySkills.has(s));
const showMatch = user && profile?.role !== 'client' && jobSkills.length > 0 && mySkills.size > 0;
// Similar open jobs: same department first, then latest.
const { data: simRows } = await supabase.from('jobs').select('slug, title, department, location, employment_type, workplace, published_at, created_at')
  .eq('status', 'open').neq('id', job.id).order('published_at', { ascending: false, nullsFirst: false }).limit(12);
const similar = [...(simRows ?? [])].sort((a: any, b: any) => (b.department === job.department ? 1 : 0) - (a.department === job.department ? 1 : 0)).slice(0, 3);
---
<Base
  title={`${job.title} | وظائف Vacant HR`}
  description={job.description_md.slice(0, 155).replace(/\s+/g, ' ')}
  active="careers"
  path={`/careers/${job.slug}`}
  waText={`مرحبًا، مهتم بوظيفة: ${job.title}`}
  jsonld={jsonld}
>
<main id="main">

<div class="wrap">
  <nav class="breadcrumb" aria-label="مسار التنقل">
    <a href="/">الرئيسية</a><span>/</span><a href="/careers">الوظائف</a><span>/</span>{job.title}
  </nav>
</div>

<section class="hero" style="padding:40px 0 30px;">
  <div class="wrap">
    <div class="eyebrow-line">وظيفة شاغرة</div>
    <h1 style="max-width:22ch;">{job.title}</h1>
    <div class="job-meta job-meta-lg">
      {job.department && <span>{job.department}</span>}
      {job.location && <span>{job.location}</span>}
      <span>{EMPLOYMENT_TYPE_AR[job.employment_type]}</span>
      <span>{WORKPLACE_AR[job.workplace]}</span>
      {job.experience_level && <span>{job.experience_level}</span>}
      {salaryLabel(job) && <span class="job-salary">{salaryLabel(job)}</span>}
    </div>
    <p style="margin:12px 0 0;color:var(--muted);font-size:.9rem;">نُشرت {timeAgo(job.published_at ?? job.created_at)}</p>
  </div>
</section>

<section style="padding-top:10px;">
  <div class="wrap job-layout">
  <div class="prose job-body">
    <h2>الوصف الوظيفي</h2>
    <Fragment set:html={renderMarkdown(job.description_md)} />
    <h2>المتطلبات</h2>
    <Fragment set:html={renderMarkdown(job.requirements_md)} />

    <div class="job-apply-cta">
      {external
        ? (
          <>
            <p>جاهز تقدّم؟ التقديم على الوظيفة دي بيتم من خلال رابط خارجي.</p>
            <a href={applyHref} class="btn solid" target="_blank" rel="noopener">قدّم على الوظيفة ↗</a>
          </>
        )
        : alreadyApplied
        ? <p>قدّمت على الوظيفة دي بالفعل. تقدر تتابع حالة طلبك من <a href="/dashboard">لوحتك</a>.</p>
        : (
          <>
            <p>جاهز تقدّم؟ {user ? 'اضغط الزر وارفع سيرتك الذاتية.' : 'محتاج تعمل حساب مرشح الأول (دقيقة واحدة).'}</p>
            <a href={applyHref} class="btn solid">قدّم على الوظيفة</a>
          </>
        )}
    </div>
  </div>

  <aside class="job-aside">
    <div class="job-apply-card">
      {alreadyApplied && !external
        ? <span class="btn" aria-disabled="true" style="opacity:.7;width:100%;text-align:center;">تم التقديم ✓</span>
        : <a href={applyHref} class="btn solid" style="width:100%;text-align:center;" {...applyAttrs}>قدّم على الوظيفة{external && ' ↗'}</a>}
      <div class="job-aside-acts">
        {user && <button type="button" class="save-btn" id="saveBtn" data-slug={job.slug} data-saved={isSaved ? '1' : '0'} title="حفظ الوظيفة">{isSaved ? '★ محفوظة' : '☆ حفظ'}</button>}
        <button type="button" class="share-btn" id="shareBtn">مشاركة</button>
      </div>
      {!user && !external && <p class="job-aside-note">محتاج حساب مرشح للتقديم — بياخد دقيقة واحدة.</p>}
      {showMatch && <p class="job-aside-note">مهاراتك المطابقة: <strong style="color:var(--accent);">{matched.length} من {jobSkills.length}</strong></p>}
      <dl class="job-facts">
        {job.department && <><dt>القسم</dt><dd>{job.department}</dd></>}
        {job.location && <><dt>المكان</dt><dd>{job.location}</dd></>}
        <dt>نوع التعاقد</dt><dd>{EMPLOYMENT_TYPE_AR[job.employment_type]}</dd>
        <dt>مكان العمل</dt><dd>{WORKPLACE_AR[job.workplace]}</dd>
        {job.experience_level && <><dt>الخبرة</dt><dd>{job.experience_level}</dd></>}
        {salaryLabel(job) && <><dt>الراتب</dt><dd>{salaryLabel(job)}</dd></>}
      </dl>
      {jobSkills.length > 0 && <div class="job-skills">{(job.skills ?? []).map((k: string) => <span class:list={{ hit: mySkills.has(k.toLowerCase().trim()) }}>{k}</span>)}</div>}
    </div>
    {similar.length > 0 && (
      <div class="job-similar">
        <h3>وظائف مشابهة</h3>
        {similar.map((j: any) => (
          <a href={`/careers/${j.slug}`} class="job-sim">
            <strong>{j.title}</strong>
            <small>{[j.department, j.location, WORKPLACE_AR[j.workplace as keyof typeof WORKPLACE_AR]].filter(Boolean).join(' · ')} · {timeAgo(j.published_at ?? j.created_at)}</small>
          </a>
        ))}
        <a href="/careers" class="job-sim-all">كل الوظائف ←</a>
      </div>
    )}
  </aside>
  </div>
</section>

</main>

<script is:inline define:vars={{ slug: job.slug, jobTitle: job.title }}>
  try { fetch('/careers/' + slug + '/view', { method: 'POST', keepalive: true }); } catch (e) {}

  var share = document.getElementById('shareBtn');
  if (share) share.addEventListener('click', function () {
    var url = location.href;
    if (navigator.share) { navigator.share({ title: jobTitle, url: url }).catch(function () {}); }
    else if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(function () {
        share.textContent = 'تم نسخ الرابط ✓';
        setTimeout(function () { share.textContent = 'مشاركة'; }, 2000);
      });
    }
  });

  var save = document.getElementById('saveBtn');
  if (save) save.addEventListener('click', function () {
    var saved = save.getAttribute('data-saved') === '1';
    var next = saved ? '0' : '1';
    save.setAttribute('data-saved', next);
    save.textContent = next === '1' ? '★ محفوظة' : '☆ حفظ';
    fetch('/careers/' + save.getAttribute('data-slug') + '/save', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: next === '1' ? 'save' : 'unsave' }),
    }).catch(function () {
      save.setAttribute('data-saved', saved ? '1' : '0');
      save.textContent = saved ? '★ محفوظة' : '☆ حفظ';
    });
  });
</script>
</Base>
