---
// Admin panel shell: builds the role-aware sidebar and hands it to Shell.
import Shell, { type ShellGroup } from './Shell.astro';
import { serverClient } from '../lib/supabase';
import { ICONS as I } from '../lib/icons';
import { can, ROLE_AR } from '../lib/roles';

interface Props { title: string; path: string; active?: string }
const { title, path, active = '' } = Astro.props;

const profile = Astro.locals?.profile;
const role = profile?.role ?? '';

// Live counters for the sidebar badges (cheap HEAD queries; failures just hide the badge).
let newApps = 0, newReqs = 0;
try {
  const sb = serverClient(Astro);
  const [a, r] = await Promise.all([
    sb.from('applications').select('id', { count: 'exact', head: true }).eq('status', 'submitted'),
    sb.from('client_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  ]);
  newApps = a.count ?? 0;
  newReqs = r.count ?? 0;
} catch { /* badges are optional */ }

const all: ShellGroup[] = [
  { label: '', items: [{ href: '/admin', label: 'نظرة عامة', key: 'home', icon: I.home }] },
  { label: 'التوظيف', items: [
    { href: '/admin/jobs', label: 'الوظائف', key: 'jobs', icon: I.jobs },
    { href: '/admin/candidates', label: 'المرشحون', key: 'candidates', icon: I.people, badge: newApps },
    { href: '/admin/interviews', label: 'المقابلات', key: 'interviews', icon: I.calendar },
  ] },
  { label: 'العملاء', items: [
    { href: '/admin/requests', label: 'طلبات الشركات', key: 'requests', icon: I.building, badge: newReqs },
    { href: '/admin/inbox', label: 'الرسائل', key: 'inbox', icon: I.mail },
  ] },
  { label: 'الموقع', items: [
    { href: '/admin/blog', label: 'المدوّنة', key: 'blog', icon: I.pen },
    { href: '/admin/pages', label: 'الصفحات', key: 'pages', icon: I.file },
    { href: '/admin/content', label: 'المحتوى', key: 'content', icon: I.layers },
    { href: '/admin/media', label: 'الوسائط', key: 'media', icon: I.image },
    { href: '/admin/analytics', label: 'التحليلات', key: 'analytics', icon: I.chart },
  ] },
  { label: 'النظام', items: [
    { href: '/admin/staff', label: 'الفريق', key: 'staff', icon: I.team },
    { href: '/admin/activity', label: 'سجل النشاط', key: 'activity', icon: I.log },
    { href: '/admin/content/settings', label: 'الإعدادات', key: 'settings', icon: I.settings },
  ] },
];
// "settings" lives under the content section for permissions.
const groups = all
  .map((g) => ({ ...g, items: g.items.filter((i) => can(role, i.key === 'settings' ? 'content' : i.key)) }))
  .filter((g) => g.items.length > 0);

const foot = [
  { href: '/dashboard', label: 'لوحتي الشخصية', key: 'me', icon: I.user },
  { href: '/', label: 'عرض الموقع', key: 'site', icon: I.external, external: true },
  { href: '/logout', label: 'تسجيل الخروج', key: 'logout', icon: I.logout },
];
const denied = new URL(Astro.request.url).searchParams.get('denied') === '1';
---
<Shell title={title} path={path} active={active} groups={groups} foot={foot} brandHref="/admin"
       userName={profile?.full_name ?? 'مستخدم'} userRole={ROLE_AR[role] ?? role} kicker="لوحة الإدارة">
  <Fragment slot="heading"><slot name="heading">لوحة الإدارة</slot></Fragment>
  {denied && <p class="notice-denied">صلاحياتك الحالية ما تسمحش بالإجراء ده. لو محتاجه، اطلب من المدير يغيّر دورك.</p>}
  <slot />
</Shell>
