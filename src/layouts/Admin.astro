---
// Admin shell: fixed sidebar (Shopify/WordPress style) + top bar + content area.
// Pages pass the <title>, canonical path, the active sidebar key and a heading slot.
import Base from './Base.astro';
import { serverClient } from '../lib/supabase';
import { getSettings, mediaUrl } from '../lib/settings';

interface Props {
  title: string;
  path: string;
  active?: string;
}
const { title, path, active = '' } = Astro.props;

const profile = Astro.locals?.profile;
const isAdmin = profile?.role === 'admin';
const settings = await getSettings();

// Live counters for the sidebar badges (cheap HEAD queries; failures just hide the badge).
let newApps = 0, newReqs = 0;
try {
  const sb = serverClient(Astro);
  const [a, r] = await Promise.all([
    sb.from('applications').select('id', { count: 'exact', head: true }).eq('status', 'submitted'),
    sb.from('client_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  ]);
  newApps = a.count ?? 0;
  newReqs = r.count ?? 0;
} catch { /* badges are optional */ }

type Item = { href: string; label: string; key: string; icon: string; badge?: number; adminOnly?: boolean };
type Group = { label: string; items: Item[] };

const I = {
  home: 'M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  jobs: 'M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M4 12h16',
  people: 'M16 19v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7M21 19v-2a4 4 0 0 0-3-3.87M15 3.13a3.5 3.5 0 0 1 0 6.74',
  calendar: 'M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM4 10h16M8 3v4M16 3v4',
  building: 'M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M8 8h3M8 12h3M8 16h3M4 21h17',
  mail: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zM3 7l9 6 9-6',
  chart: 'M4 20h16M7 16V10M12 16V5M17 16v-3',
  pen: 'M4 20h4l10.5-10.5a2 2 0 0 0 0-2.83l-1.17-1.17a2 2 0 0 0-2.83 0L4 16zM13 7l4 4',
  layers: 'M12 3 3 8l9 5 9-5zM3 13l9 5 9-5M3 18l9 5 9-5',
  image: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM4 16l5-5 4 4 3-3 4 4M15 9h.01',
  team: 'M17 20h5v-2a3 3 0 0 0-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.28-.36-1.86M7 20H2v-2a3 3 0 0 1 5.36-1.86M7 20v-2c0-.66.13-1.28.36-1.86m0 0a5 5 0 0 1 9.28 0M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM7 10a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
  log: 'M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z',
  external: 'M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5',
  logout: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9',
  menu: 'M4 6h16M4 12h16M4 18h16',
  file: 'M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h6',
};

const groups: Group[] = [
  { label: '', items: [{ href: '/admin', label: 'نظرة عامة', key: 'home', icon: I.home }] },
  { label: 'التوظيف', items: [
    { href: '/admin/jobs', label: 'الوظائف', key: 'jobs', icon: I.jobs },
    { href: '/admin/candidates', label: 'المرشحون', key: 'candidates', icon: I.people, badge: newApps },
    { href: '/admin/interviews', label: 'المقابلات', key: 'interviews', icon: I.calendar },
  ] },
  { label: 'العملاء', items: [
    { href: '/admin/requests', label: 'طلبات الشركات', key: 'requests', icon: I.building, badge: newReqs },
    { href: '/admin/inbox', label: 'الرسائل', key: 'inbox', icon: I.mail },
  ] },
  { label: 'الموقع', items: [
    { href: '/admin/blog', label: 'المدوّنة', key: 'blog', icon: I.pen, adminOnly: true },
    { href: '/admin/pages', label: 'الصفحات', key: 'pages', icon: I.file, adminOnly: true },
    { href: '/admin/content', label: 'المحتوى', key: 'content', icon: I.layers, adminOnly: true },
    { href: '/admin/media', label: 'الوسائط', key: 'media', icon: I.image, adminOnly: true },
    { href: '/admin/analytics', label: 'التحليلات', key: 'analytics', icon: I.chart, adminOnly: true },
  ] },
  { label: 'النظام', items: [
    { href: '/admin/staff', label: 'الفريق', key: 'staff', icon: I.team, adminOnly: true },
    { href: '/admin/activity', label: 'سجل النشاط', key: 'activity', icon: I.log, adminOnly: true },
    { href: '/admin/content/settings', label: 'الإعدادات', key: 'settings', icon: I.settings, adminOnly: true },
  ] },
]
  .map((g) => ({ ...g, items: g.items.filter((i) => isAdmin || !i.adminOnly) }))
  .filter((g) => g.items.length > 0);

const initials = (profile?.full_name || 'V').trim().slice(0, 1);
---
<Base title={title} path={path} active="admin" noindex={true} showChrome={false}>
<div class="adm" id="adm">
  <aside class="adm-side" id="admSide" aria-label="قائمة الإدارة">
    <a href="/admin" class="adm-brand">
      {settings.logo_path
        ? <img src={mediaUrl(settings.logo_path)} alt="Vacant HR" />
        : <span>Vacant HR</span>}
    </a>
    <nav class="adm-nav">
      {groups.map((g) => (
        <div class="adm-group">
          {g.label && <div class="adm-group-label">{g.label}</div>}
          {g.items.map((i) => (
            <a href={i.href} class:list={['adm-link', { active: active === i.key }]} aria-current={active === i.key ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={i.icon} /></svg>
              <span>{i.label}</span>
              {i.badge ? <b class="adm-badge">{i.badge}</b> : null}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <div class="adm-side-foot">
      <a href="/" class="adm-link" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={I.external} /></svg><span>عرض الموقع</span></a>
      <a href="/logout" class="adm-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={I.logout} /></svg><span>تسجيل الخروج</span></a>
    </div>
  </aside>
  <div class="adm-backdrop" id="admBackdrop" hidden></div>

  <div class="adm-main">
    <header class="adm-top">
      <button type="button" class="adm-burger" id="admBurger" aria-label="القائمة" aria-controls="admSide" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={I.menu} /></svg>
      </button>
      <h1 class="adm-title"><slot name="heading">لوحة الإدارة</slot></h1>
      <div class="adm-user" title={profile?.full_name ?? ''}>
        <span class="adm-avatar">{initials}</span>
        <span class="adm-user-meta">
          <strong>{profile?.full_name ?? 'مستخدم'}</strong>
          <small>{isAdmin ? 'مدير' : 'مسؤول توظيف'}</small>
        </span>
      </div>
    </header>
    <main id="main" class="adm-content">
      <slot />
    </main>
  </div>
</div>

<script is:inline>
  (function () {
    var side = document.getElementById('admSide'), bd = document.getElementById('admBackdrop'), btn = document.getElementById('admBurger');
    function set(open) {
      side.classList.toggle('open', open); bd.hidden = !open; btn.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('adm-locked', open);
    }
    btn.addEventListener('click', function () { set(!side.classList.contains('open')); });
    bd.addEventListener('click', function () { set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>

<style is:global>
  :root{ --adm-side-w:248px; --adm-side-bg:#0F172A; --adm-side-ink:#CBD5E1; --adm-side-muted:#64748B; --adm-side-hover:rgba(255,255,255,.06); }
  body:has(.adm){ background:var(--surface-soft); }
  .adm{ display:grid; grid-template-columns:var(--adm-side-w) minmax(0,1fr); min-height:100vh; }

  /* ── Sidebar ── */
  .adm-side{
    position:sticky; top:0; height:100vh; overflow-y:auto; display:flex; flex-direction:column;
    background:var(--adm-side-bg); color:var(--adm-side-ink); padding:14px 12px; gap:8px;
  }
  .adm-brand{ display:flex; align-items:center; min-height:44px; padding:6px 10px 14px; color:#fff; font-weight:800; font-size:1.15rem; letter-spacing:-.02em; border-bottom:1px solid rgba(255,255,255,.08); margin-bottom:6px; }
  .adm-brand img{ height:30px; width:auto; filter:brightness(0) invert(1); }
  .adm-nav{ flex:1; display:flex; flex-direction:column; gap:14px; }
  .adm-group{ display:flex; flex-direction:column; gap:2px; }
  .adm-group-label{ font-size:.7rem; font-weight:700; letter-spacing:.08em; color:var(--adm-side-muted); padding:4px 12px 6px; text-transform:uppercase; }
  .adm-link{
    display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:10px;
    color:var(--adm-side-ink); font-size:.93rem; font-weight:500; text-decoration:none; transition:background .15s,color .15s;
  }
  .adm-link svg{ width:19px; height:19px; flex:none; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; opacity:.85; }
  .adm-link span{ flex:1; }
  .adm-link:hover{ background:var(--adm-side-hover); color:#fff; }
  .adm-link.active{ background:var(--accent); color:#fff; }
  .adm-link.active svg{ opacity:1; }
  .adm-badge{ min-width:20px; height:20px; padding:0 6px; border-radius:999px; background:#F59E0B; color:#111; font-size:.72rem; font-weight:700; display:inline-flex; align-items:center; justify-content:center; }
  .adm-link.active .adm-badge{ background:#fff; color:var(--accent); }
  .adm-side-foot{ border-top:1px solid rgba(255,255,255,.08); padding-top:8px; display:flex; flex-direction:column; gap:2px; }

  /* ── Top bar + content ── */
  .adm-main{ display:flex; flex-direction:column; min-width:0; }
  .adm-top{
    position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:14px;
    background:var(--surface); border-bottom:1px solid var(--line); padding:12px 28px; min-height:64px;
  }
  .adm-burger{ display:none; background:none; border:0; padding:6px; cursor:pointer; color:var(--ink); border-radius:8px; }
  .adm-burger svg{ width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; }
  .adm-title{ flex:1; margin:0; font-size:1.3rem; font-weight:700; letter-spacing:-.01em; line-height:1.3; }
  .adm-user{ display:flex; align-items:center; gap:10px; }
  .adm-avatar{ width:36px; height:36px; border-radius:50%; background:var(--accent); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-weight:700; }
  .adm-user-meta{ display:flex; flex-direction:column; line-height:1.2; }
  .adm-user-meta strong{ font-size:.9rem; }
  .adm-user-meta small{ font-size:.75rem; color:var(--muted); }
  .adm-content{ padding:28px; flex:1; }
  .adm-content > .admin-body{ max-width:1200px; }
  /* Legacy inline header/nav from the old layout, in case anything still renders it. */
  .adm .dash-head, .adm .dash-nav{ display:none; }
  /* Cards & tables sit on the soft grey canvas */
  .adm-content .form-box, .adm-content .table-wrap, .adm-content .card{ background:var(--surface); }

  @media (max-width: 960px){
    .adm{ grid-template-columns:1fr; }
    .adm-side{ position:fixed; inset-inline-start:0; top:0; z-index:60; width:min(var(--adm-side-w), 84vw); transform:translateX(100%); transition:transform .2s ease; box-shadow:var(--shadow-lg); }
    [dir="ltr"] .adm-side{ transform:translateX(-100%); }
    .adm-side.open{ transform:none; }
    .adm-backdrop{ position:fixed; inset:0; background:rgba(15,23,42,.5); z-index:50; }
    .adm-burger{ display:inline-flex; }
    .adm-top{ padding:10px 16px; }
    .adm-title{ font-size:1.1rem; }
    .adm-user-meta{ display:none; }
    .adm-content{ padding:18px 16px 40px; }
    body.adm-locked{ overflow:hidden; }
  }
</style>
</Base>
