---
// Candidate / client portal shell (/dashboard): same look as the admin panel, simpler menu.
import Shell, { type ShellGroup } from './Shell.astro';
import { ICONS as I } from '../lib/icons';
import { isStaff, ROLE_AR } from '../lib/roles';

interface Props { title: string; path: string; active?: string }
const { title, path, active = '' } = Astro.props;

const user = Astro.locals?.user;
const profile = Astro.locals?.profile;
const role = profile?.role ?? 'candidate';
const isClient = role === 'client';

const groups: ShellGroup[] = isClient
  ? [
    { label: '', items: [
      { href: '/dashboard', label: 'نظرة عامة', key: 'home', icon: I.home },
      { href: '/dashboard/requests', label: 'طلبات التوظيف', key: 'requests', icon: I.building },
      { href: '/dashboard/messages', label: 'الرسائل', key: 'messages', icon: I.mail },
      { href: '/dashboard/profile', label: 'بيانات الشركة', key: 'profile', icon: I.user },
    ] },
  ]
  : [
    { label: '', items: [
      { href: '/dashboard', label: 'نظرة عامة', key: 'home', icon: I.home },
      { href: '/dashboard/applications', label: 'طلباتي', key: 'applications', icon: I.file },
      { href: '/dashboard/interviews', label: 'المقابلات', key: 'interviews', icon: I.calendar },
      { href: '/dashboard/saved', label: 'الوظائف المحفوظة', key: 'saved', icon: I.layers },
      { href: '/dashboard/messages', label: 'الرسائل', key: 'messages', icon: I.mail },
      { href: '/dashboard/profile', label: 'بياناتي', key: 'profile', icon: I.user },
    ] },
    { label: 'الوظائف', items: [
      { href: '/careers', label: 'تصفّح الوظائف', key: 'careers', icon: I.jobs },
    ] },
  ];
if (isStaff(role)) groups.push({ label: 'الإدارة', items: [{ href: '/admin', label: 'لوحة الإدارة', key: 'admin', icon: I.settings }] });
const foot = [
  { href: '/', label: 'الموقع الرئيسي', key: 'site', icon: I.external, external: true },
  { href: '/logout', label: 'تسجيل الخروج', key: 'logout', icon: I.logout },
];
---
<Shell title={title} path={path} active={active} groups={groups} foot={foot} brandHref="/dashboard"
       userName={profile?.full_name ?? user?.email ?? 'مستخدم'} userRole={ROLE_AR[role] ?? role} kicker={isClient ? 'بوابة الشركات' : 'بوابة المرشحين'}>
  <Fragment slot="heading"><slot name="heading">لوحتي</slot></Fragment>
  <slot />
</Shell>
<style is:global>
  /* Portal widgets */
  .ptiles{ display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-bottom:22px; }
  .ptile{ background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; display:flex; flex-direction:column; gap:4px; color:inherit; }
  .ptile:hover{ border-color:var(--accent); }
  .ptile b{ font-size:1.6rem; font-weight:800; color:var(--accent-strong); line-height:1.1; }
  .ptile span{ font-size:.85rem; color:var(--muted); }
  .psec{ background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; margin-bottom:16px; }
  .psec-head{ display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:12px; }
  .psec-head h2{ margin:0; font-size:1.05rem; }
  .psec-head a{ font-size:.85rem; color:var(--accent); font-weight:600; }
  .prow{ display:flex; justify-content:space-between; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line-soft); }
  .prow:first-of-type{ border-top:0; padding-top:0; }
  .prow-main{ display:flex; flex-direction:column; gap:2px; min-width:0; }
  .prow-main strong{ font-size:.95rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .prow-main small{ color:var(--muted); font-size:.8rem; }
  .pempty{ color:var(--muted); font-size:.9rem; margin:0; }
  .pnudge{ background:var(--accent-soft); border:1px solid #BFE3D8; border-radius:var(--radius); padding:14px 18px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; }
  .pnudge p{ margin:0; font-size:.92rem; }
  .pgrid2{ display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:16px; }
  /* application status steps */
  .steps{ display:flex; gap:4px; margin-top:6px; }
  .steps i{ flex:1; height:4px; border-radius:2px; background:var(--line); }
  .steps i.on{ background:var(--accent); }
  .steps.rejected i.on{ background:#C05621; }
</style>
