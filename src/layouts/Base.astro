---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getSettings, mediaUrl } from '../lib/settings';

interface Props {
  title: string;
  description?: string;
  active?: string;
  path?: string;            // canonical path, e.g. "/about"
  ogImage?: string;
  noindex?: boolean;
  waText?: string;
  jsonld?: unknown[];
  showChrome?: boolean;     // header/footer/whatsapp (default true)
}

const {
  title,
  description = 'Vacant HR تقدم خدمات التوظيف، نظام إدارة موارد بشرية سحابي (HRM SaaS)، الاستشارات، ونماذج الوصف الوظيفي.',
  active = '',
  path = Astro.url.pathname,
  ogImage = '/og-image.png',
  noindex = false,
  waText,
  jsonld = [],
  showChrome = true,
} = Astro.props;

const site = 'https://vacanthr.com';
const canonical = new URL(path, site).href;
const ogImageAbs = new URL(ogImage, site).href;

// Bump when style.css / script.js change — busts any stale CDN/browser cache.
const ASSET_VER = '20260911a';

const settings = await getSettings();

// Edge-cache anonymous HTML so CMS edits appear within ~a minute without a redeploy.
try {
  if (!Astro.locals?.user) {
    Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
  }
} catch { /* prerendered: no response object */ }
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content={settings.theme_color || '#0E7C66'} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Vacant HR" />
<meta property="og:locale" content="ar_AR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href={settings.favicon_path ? mediaUrl(settings.favicon_path) : '/favicon.svg'} />
<link rel="apple-touch-icon" href={settings.favicon_path ? mediaUrl(settings.favicon_path) : '/favicon.svg'} />
<link rel="alternate" type="application/rss+xml" title="مدوّنة Vacant HR" href="/rss.xml" />
{settings.google_site_verification && <meta name="google-site-verification" content={settings.google_site_verification} />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" />
<link rel="stylesheet" href={`/style.css?v=${ASSET_VER}`} />
{jsonld.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>
<a href="#main" class="skip-link">تخطَّ إلى المحتوى</a>
{showChrome && <Header active={active} settings={settings} />}
<slot />
{showChrome && <Footer settings={settings} />}
{showChrome && <WhatsApp text={waText} number={settings.whatsapp_number} />}
{showChrome && <CookieConsent analytics={settings.analytics_snippet} />}
<script src={`/script.js?v=${ASSET_VER}`} defer is:inline></script>
{!noindex && (
  <script is:inline>
    try {
      if (!location.pathname.startsWith('/admin')) {
        fetch('/e', { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind: 'pageview', path: location.pathname, ref: document.referrer || '' }) });
      }
    } catch (e) {}
  </script>
)}
</body>
</html>
