---
import { DEFAULT_SETTINGS, type Settings } from '../lib/settings';
interface Props { settings?: Settings }
const s = Astro.props.settings ?? DEFAULT_SETTINGS;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="brand" style="margin-bottom:14px;">Vacant HR</div>
        <p>{s.company_blurb}</p>
        <div class="footer-social">
          <a href={s.linkedin_url} aria-label="لينكدإن" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 17v-7"/></svg></a>
          <a href={`https://wa.me/${s.whatsapp_number}`} aria-label="واتساب" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M4 20l1.5-4A8 8 0 1 1 9 19.5z"/><path d="M9 10c0 3 2 5 5 5"/></svg></a>
        </div>
      </div>
      <div>
        <h4>الخدمات</h4>
        <ul>
          <li><a href="/recruitment">التوظيف</a></li>
          <li><a href="/hrm-saas">برنامج HRM</a></li>
          <li><a href="/consulting">الاستشارات</a></li>
          <li><a href="/jd-templates">نماذج الوصف الوظيفي</a></li>
          <li><a href="/careers">الوظائف المتاحة</a></li>
        </ul>
      </div>
      <div>
        <h4>الشركة</h4>
        <ul>
          <li><a href="/about">من نحن</a></li>
          <li><a href="/blog">المدوّنة</a></li>
          <li><a href="/contact">تواصل معنا</a></li>
          <li><a href="/privacy">سياسة الخصوصية</a></li>
        </ul>
      </div>
      <div>
        <h4>تواصل</h4>
        <ul>
          <li><a href={`mailto:${s.contact_email}`}>{s.contact_email}</a></li>
          <li><a href={`tel:${s.contact_phone}`}>{s.contact_phone}</a></li>
          <li>{s.address}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Vacant HR. جميع الحقوق محفوظة.</span>
      <span>vacanthr.com</span>
    </div>
  </div>
</footer>
