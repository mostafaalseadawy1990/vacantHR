---
// Tab bar shared by every "المحتوى" page, plus the shared styles for the accordion item lists.
interface Props { active: string; preview?: string }
const { active, preview } = Astro.props;
const tabs = [
  { key: 'index', href: '/admin/content', label: 'نظرة عامة' },
  { key: 'settings', href: '/admin/content/settings', label: 'الإعدادات' },
  { key: 'testimonials', href: '/admin/content/testimonials', label: 'آراء العملاء' },
  { key: 'faqs', href: '/admin/content/faqs', label: 'الأسئلة الشائعة' },
  { key: 'pricing', href: '/admin/content/pricing', label: 'الباقات' },
  { key: 'guide', href: '/admin/content/guide', label: 'دليل HRM' },
  { key: 'blog-layout', href: '/admin/content/blog-layout', label: 'شكل المدوّنة' },
];
---
<div class="cnav-wrap">
  <nav class="cnav" aria-label="أقسام المحتوى">
    {tabs.map((t) => <a href={t.href} class:list={{ active: active === t.key }} aria-current={active === t.key ? 'page' : undefined}>{t.label}</a>)}
  </nav>
  {preview && <a href={preview} target="_blank" rel="noopener" class="btn cnav-preview">معاينة على الموقع ↗</a>}
</div>

<style is:global>
  .cnav-wrap{ display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:20px; }
  .cnav{ display:flex; gap:4px; flex-wrap:wrap; background:var(--surface); border:1px solid var(--line); border-radius:999px; padding:4px; }
  .cnav a{ padding:7px 14px; border-radius:999px; font-size:.88rem; font-weight:500; color:var(--body); white-space:nowrap; }
  .cnav a:hover{ background:var(--surface-soft); }
  .cnav a.active{ background:var(--accent); color:#fff; }
  .cnav-preview{ padding:7px 14px; font-size:.85rem; }
  @media (max-width:640px){ .cnav{ border-radius:12px; } }

  /* settings tabs */
  .stabs{ display:flex; gap:4px; border-bottom:1px solid var(--line); margin-bottom:20px; overflow-x:auto; }
  .stabs button{ background:none; border:0; border-bottom:2px solid transparent; padding:10px 14px; font-family:inherit; font-size:.92rem; font-weight:600; color:var(--muted); cursor:pointer; white-space:nowrap; margin-bottom:-1px; }
  .stabs button.active{ color:var(--accent); border-bottom-color:var(--accent); }
  .spanel[hidden]{ display:none; }
  .shelp{ font-size:.82rem; color:var(--muted); margin:-10px 0 14px; }
  .ssticky{ position:sticky; bottom:0; background:var(--surface); border-top:1px solid var(--line); padding:12px 0 0; margin-top:10px; display:flex; gap:10px; align-items:center; }
</style>
