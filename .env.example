# Supabase (public — safe to expose in the browser)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt

# Email (optional — transactional email via Resend). Leave unset to disable email.
# On Cloudflare Pages add these as ENCRYPTED environment variables, not plain.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Vacant HR <noreply@vacanthr.com>

# Telegram notifications (optional) — instant push for new contact messages / applications / requests.
# 1) Talk to @BotFather → /newbot → copy the token. 2) Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":…}. Add both on Cloudflare Pages as encrypted vars.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=123456789
